index 0000000000..0a49f93f37
--- /dev/null
+++ b/experiments/exec-reliability/download_k7.py
@@ -0,0 +1,594 @@ def sha256(data: bytes) -> str:
+"""Download consistency cases for leaf download-consistency-k7.
+
+Usage: download_k7.py OUT AGENT [AGENT ...]
+
+Each AGENT is LABEL=PATH. The cases run against each agent binary on the host. A fresh
+agent process serves each case on a loopback port. download_k7_shim.c is loaded with
+DYLD_INSERT_LIBRARIES. It traces stat, lstat, open, pread and close below the case
+directory, pauses one armed call, and binds the agent to loopback.
+
+A calibration download finds the path lookup that supplies the size. It is the last stat
+or lstat before the open. The forced cases pause after that lookup or before a pread.
+Then they change the file and resume. The raw client records the advertised framing and
+the received bytes. The Host CLI records its exit, receipt, destination and temporary
+files. The stress cases use natural timing and no pause.
+
+The controller judges nothing. download_k7_check.py classifies the retained evidence.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import queue
+import shutil
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+HERE = Path(__file__).resolve().parent
+SHIM_SOURCE = HERE / "download_k7_shim.c"
+CLI = Path(shutil.which("testanyware") or "/opt/homebrew/bin/testanyware").resolve()
+HISTORICAL = Path(
+    "/Users/antony/Development/AgenticOrchestration/Ravel-Strategies.gh-issue-1/"
+    "experiments/tutorial-vm-reliability/evidence/macos-candidate-02"
+)
+HISTORICAL_SHA256 = {
+    "after-abrupt-03-initial.json": (
+        "b95c9261fb8ff0ca68a9d8b06ebdcb4102a72f60b670c2d748cdf4eca454e7a4"
+    ),
+    "after-abrupt-03-state-002.json": (
+        "ca41852314b967a327b0a4faf0240cac2f2e304387439e5518cf380da4b9a56e"
+    ),
+    "after-abrupt-03-collect-002.json": (
+        "6645b2e4b55f2b89a7e635bfa6bd17074f538c2978606e01852ce049cc3740a3"
+    ),
+    "after-abrupt-03-launch.json": (
+        "eb9c539fccdae4d746627b159d754845a725782efe37d548b61f57de555338b7"
+    ),
+}
+ORACLE = bytes.fromhex("00ff80410a")
+CHUNK = 128 * 1024
+BIG = 3 * CHUNK + 1000
+RAW_TIMEOUT = 20.0
+CLI_TIMEOUT = 150.0
+PAUSE_TIMEOUT = 20.0
+STRESS_SECONDS = 10.0
+
+Json = dict[str, Any]
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def pattern(seed: int, size: int) -> bytes:
+    """Distinct non-repeating bytes, so a torn body names the offsets of each version."""
+    out = bytearray()
+    counter = 0
+    while len(out) < size:
+        out += hashlib.sha256(f"{seed}:{counter}".encode()).digest()
+        counter += 1
+    return bytes(out[:size])
+
+
+def terminal_record() -> bytes:
+    """A terminal record in the shape of fixture/r2/operation.py (json.dumps + newline)."""
+    record = {
+        "state": "terminal",
+        "reason": "exit",
+        "exit_code": 0,
+        "process_returncode": 0,
+        "stdout_hex": "6f6b0a",
+        "stderr_hex": "",
+    }
+    return (json.dumps(record) + "\n").encode()
+
+
+def replace(path: Path, data: bytes) -> None:
+    """Write a sibling temporary file and rename it over path, as the guest writer does."""
+    tmp = path.with_suffix(".tmp")
+    tmp.write_bytes(data)
+    tmp.replace(path)
+
+
+def overwrite_in_place(path: Path, data: bytes) -> None:
+    fd = os.open(path, os.O_WRONLY)
+    try:
+        os.pwrite(fd, data, 0)
+    finally:
+        os.close(fd)
+
+
+def append_in_place(path: Path, data: bytes) -> None:
+    with path.open("ab") as handle:
+        handle.write(data)
+
+
+def free_port() -> int:
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        return int(probe.getsockname()[1])
+
+
+@dataclass
+class Agent:
+    label: str
+    binary: Path
+    shim: Path
+    root: Path
+    trace: bool = True
+    port: int = 0
+    process: subprocess.Popen[bytes] | None = None
+    record: Json = field(default_factory=lambda: {})
+
+    @property
+    def target(self) -> Path:
+        return self.root / "t"
+
+    @property
+    def gate(self) -> Path:
+        return self.root / "g"
+
+    def start(self) -> None:
+        self.target.mkdir(parents=True, exist_ok=True)
+        self.gate.mkdir(parents=True, exist_ok=True)
+        self.port = free_port()
+        env = {k: v for k, v in os.environ.items() if not k.startswith(("DYLD_", "K7_"))}
+        env |= {
+            "DYLD_INSERT_LIBRARIES": str(self.shim),
+            "K7_TARGET_DIR": str(self.target),
+            "K7_GATE": str(self.gate),
+            "K7_LOOPBACK": "1",
+        }
+        if self.trace:
+            env["K7_TRACE"] = str(self.root / "trace.jsonl")
+        log = (self.root / "agent.log").open("wb")
+        self.process = subprocess.Popen(
+            [str(self.binary), str(self.port)],
+            stdin=subprocess.DEVNULL,
+            stdout=log,
+            stderr=subprocess.STDOUT,
+            env=env,
+            start_new_session=True,
+        )
+        log.close()
+        deadline = time.monotonic() + 15
+        while time.monotonic() < deadline:
+            if self.process.poll() is not None:
+                break
+            try:
+                with socket.create_connection(("127.0.0.1", self.port), timeout=0.5):
+                    break
+            except OSError:
+                time.sleep(0.05)
+        listen = subprocess.run(
+            ["lsof", "-nP", "-a", "-p", str(self.process.pid), "-iTCP", "-sTCP:LISTEN"],
+            capture_output=True,
+            text=True,
+        ).stdout
+        self.record = {
+            "label": self.label,
+            "pid": self.process.pid,
+            "port": self.port,
+            "listen": listen,
+            "loopback_only": f"127.0.0.1:{self.port}" in listen
+            and "*:" not in listen
+            and "0.0.0.0" not in listen,
+        }
+        if not self.record["loopback_only"]:
+            self.stop()
+            raise RuntimeError(f"agent did not listen on loopback only: {listen!r}")
+
+    def stop(self, sig: int = signal.SIGTERM) -> None:
+        if self.process is None:
+            return
+        if self.process.poll() is None:
+            self.process.send_signal(sig)
+            try:
+                self.process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait(timeout=10)
+        self.record["returncode"] = self.process.returncode
+        self.record["stopped_by"] = signal.Signals(sig).name
+        alive = subprocess.run(["ps", "-p", str(self.process.pid)], capture_output=True)
+        self.record["alive_after_stop"] = alive.returncode == 0
+
+    def arm(self, event: str, nth: int, generation: str) -> None:
+        (self.gate / "arm").write_text(f"{event} {nth} {generation}\n")
+
+    def wait_paused(self) -> str:
+        deadline = time.monotonic() + PAUSE_TIMEOUT
+        paused = self.gate / "paused"
+        while time.monotonic() < deadline:
+            if paused.exists():
+                return paused.read_text()
+            time.sleep(0.01)
+        raise TimeoutError("the armed call did not pause")
+
+    def resume(self) -> None:
+        (self.gate / "resume").write_text("go\n")
+
+
+def raw_download(port: int, path: Path, timeout: float = RAW_TIMEOUT) -> tuple[Json, bytes]:
+    """POST /download with one connection. Read the body to Content-Length, then wait
+    briefly for extra bytes or the close. Nothing is retried."""
+    query = "path=" + "".join(
+        ch if ch.isalnum() or ch in "/-_." else f"%{ord(ch):02X}" for ch in str(path)
+    )
+    request = (
+        f"POST /download?{query} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\n"
+        "Content-Length: 0\r\nConnection: close\r\n\r\n"
+    ).encode()
+    started = time.monotonic()
+    data = b""
+    end = "complete"
+    with socket.create_connection(("127.0.0.1", port), timeout=timeout) as conn:
+        conn.sendall(request)
+        conn.settimeout(timeout)
+        while b"\r\n\r\n" not in data:
+            piece = conn.recv(65536)
+            if not piece:
+                break
+            data += piece
+        head, _, body = data.partition(b"\r\n\r\n")
+        lines = head.decode("latin-1").split("\r\n")
+        status = int(lines[0].split()[1]) if lines and len(lines[0].split()) > 1 else 0
+        headers = {
+            k.strip().lower(): v.strip() for k, _, v in (x.partition(":") for x in lines[1:])
+        }
+        length = int(headers["content-length"]) if "content-length" in headers else None
+        try:
+            while length is None or len(body) < length:
+                piece = conn.recv(65536)
+                if not piece:
+                    end = "eof-before-length" if length is not None else "eof"
+                    break
+                body += piece
+        except TimeoutError:
+            end = "timeout-before-length"
+        if end == "complete":
+            conn.settimeout(0.5)
+            try:
+                extra = conn.recv(65536)
+                end = "complete-extra-bytes" if extra else "complete"
+                body += extra
+            except TimeoutError:
+                end = "complete-open"
+        # Bytes past Content-Length can arrive in the same segment as the headers.
+        if length is not None and len(body) > length:
+            end = "complete-extra-bytes"
+    result: Json = {
+        "status": status,
+        "headers": headers,
+        "content_length": length,
+        "received": len(body),
+        "sha256": sha256(body),
+        "end": end,
+        "seconds": round(time.monotonic() - started, 4),
+    }
+    return result, body
+
+
+def leftover_temporaries(directory: Path) -> list[str]:
+    return sorted(p.name for p in directory.iterdir() if ".testanyware-" in p.name)
+
+
+def cli_download(port: int, remote: Path, local: Path) -> Json:
+    env = {k: v for k, v in os.environ.items() if k != "TESTANYWARE_APP_SOCKET"}
+    argv = [str(CLI), "file", "download", "--agent", f"127.0.0.1:{port}"]
+    argv += [str(remote), str(local), "--json"]
+    started = time.monotonic()
+    try:
+        done = subprocess.run(argv, capture_output=True, timeout=CLI_TIMEOUT, env=env)
+        code: int | None = done.returncode
+        out, err, killed = done.stdout, done.stderr, False
+    except subprocess.TimeoutExpired as expired:
+        code, killed = None, True
+        out = expired.stdout or b""
+        err = expired.stderr or b""
+    result: Json = {
+        "argv": argv,
+        "exit": code,
+        "killed_at_bound": killed,
+        "seconds": round(time.monotonic() - started, 4),
+        "stdout": out.decode(errors="replace"),
+        "stderr": err.decode(errors="replace"),
+        "destination_exists": local.exists(),
+        "temporaries": leftover_temporaries(local.parent),
+    }
+    if local.exists():
+        body = local.read_bytes()
+        result |= {"destination_bytes": len(body), "destination_sha256": sha256(body)}
+    return result
+
+
+@dataclass
+class Case:
+    name: str
+    initial: bytes
+    allowed: list[bytes]
+    pause: str  # "size", "pread:N" or "none"
+    change: Callable[[Path], None] | None
+    kill_agent: bool = False
+    kill_cli: bool = False
+
+
+def cases() -> list[Case]:
+    pending = (HISTORICAL / "after-abrupt-03-initial.json").read_bytes()
+    terminal = terminal_record()
+    big_a, big_b = pattern(1, BIG), pattern(2, BIG)
+    return [
+        Case(
+            "replace-longer", pending, [pending, terminal], "size", lambda p: replace(p, terminal)
+        ),
+        Case(
+            "replace-shorter", terminal, [terminal, pending], "size", lambda p: replace(p, pending)
+        ),
+        Case(
+            "truncate-during-read",
+            big_a,
+            [big_a, big_a[: CHUNK // 2]],
+            "pread:2",
+            lambda p: os.truncate(p, CHUNK // 2),
+        ),
+        Case(
+            "overwrite-during-read",
+            big_a,
+            [big_a, big_b],
+            "pread:2",
+            lambda p: overwrite_in_place(p, big_b),
+        ),
+        Case(
+            "append-during-read",
+            big_a,
+            [big_a, big_a + big_b[:CHUNK]],
+            "pread:2",
+            lambda p: append_in_place(p, big_b[:CHUNK]),
+        ),
+        Case("immutable-binary", ORACLE, [ORACLE], "none", None),
+        Case("agent-killed-mid-body", big_a, [big_a], "pread:2", None, kill_agent=True),
+        Case("cli-killed-mid-body", big_a, [big_a], "pread:2", None, kill_cli=True),
+    ]
+
+
+def calibrate(agent: Agent) -> Json:
+    """Find the path lookup that supplies Content-Length: the last stat or lstat before
+    the open, with its ordinal among calls of the same kind."""
+    path = agent.target / "calibrate.bin"
+    path.write_bytes(b"calibrate")
+    result, _ = raw_download(agent.port, path)
+    events = [json.loads(x) for x in (agent.root / "trace.jsonl").read_text().splitlines()]
+    events = [e for e in events if e.get("path") == str(path)]
+    names = [str(e["event"]) for e in events]
+    opened = names.index("open")
+    size_event = next(n for n in reversed(names[:opened]) if n in ("stat", "lstat"))
+    ordinal = names[:opened].count(size_event)
+    return {"events": names, "size_event": size_event, "ordinal": ordinal, "raw": result}
+
+
+def run_case(agent: Agent, case: Case, client: str, calibration: Json) -> Json:
+    path = agent.target / f"{case.name}.bin"
+    path.write_bytes(case.initial)
+    (agent.root / "initial.bin").write_bytes(case.initial)
+    for index, version in enumerate(case.allowed):
+        (agent.root / f"allowed-{index}.bin").write_bytes(version)
+    record: Json = {"case": case.name, "client": client, "pause": case.pause}
+    if case.pause == "size":
+        agent.arm(str(calibration["size_event"]), int(calibration["ordinal"]), case.name)
+    elif case.pause.startswith("pread:"):
+        agent.arm("pread", int(case.pause.split(":")[1]), case.name)
+    results: queue.Queue[Json] = queue.Queue()
+    local = agent.root / "local" / f"{case.name}.bin"
+    local.parent.mkdir(exist_ok=True)
+
+    def raw_client() -> None:
+        try:
+            result, body = raw_download(agent.port, path)
+            (agent.root / "received.bin").write_bytes(body)
+            results.put(result)
+        except OSError as error:
+            results.put({"error": repr(error)})
+
+    cli_process: subprocess.Popen[bytes] | None = None
+    if client == "raw":
+        worker = threading.Thread(target=raw_client)
+        worker.start()
+    else:
+        worker = threading.Thread(target=lambda: results.put(cli_download(agent.port, path, local)))
+        if case.kill_cli:
+            env = {k: v for k, v in os.environ.items() if k != "TESTANYWARE_APP_SOCKET"}
+            argv = [str(CLI), "file", "download", "--agent", f"127.0.0.1:{agent.port}"]
+            cli_process = subprocess.Popen(
+                [*argv, str(path), str(local), "--json"],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                env=env,
+            )
+        else:
+            worker.start()
+    if case.pause != "none":
+        record["paused"] = agent.wait_paused()
+        if case.change is not None:
+            case.change(path)
+            record["changed_sha256"] = sha256(path.read_bytes())
+        if case.kill_agent:
+            agent.stop(signal.SIGKILL)
+        if cli_process is not None:
+            temporaries = leftover_temporaries(local.parent)
+            cli_process.send_signal(signal.SIGTERM)
+            out, err = cli_process.communicate(timeout=30)
+            record["cli_killed"] = {
+                "signal": "SIGTERM",
+                "temporaries_while_paused": temporaries,
+                "exit": cli_process.returncode,
+                "stdout": out.decode(errors="replace"),
+                "stderr": err.decode(errors="replace"),
+                "destination_exists": local.exists(),
+                "temporaries_after": leftover_temporaries(local.parent),
+            }
+        if not case.kill_agent:
+            agent.resume()
+    if cli_process is None:
+        worker.join(timeout=CLI_TIMEOUT + 30)
+        record["result"] = results.get(timeout=1)
+    record["file_after_sha256"] = sha256(path.read_bytes()) if path.exists() else None
+    return record
+
+
+def stress_mutable(agent: Agent, seconds: float) -> Json:
+    """Natural timing: a writer swaps the pending and terminal records by rename while the
+    raw client reads the path again and again. Every response is retained by digest."""
+    pending = (HISTORICAL / "after-abrupt-03-initial.json").read_bytes()
+    terminal = terminal_record()
+    path = agent.target / "stress.json"
+    path.write_bytes(pending)
+    stop = threading.Event()
+    swaps = 0
+
+    def writer() -> None:
+        nonlocal swaps
+        while not stop.is_set():
+            replace(path, terminal if swaps % 2 == 0 else pending)
+            swaps += 1
+
+    thread = threading.Thread(target=writer)
+    thread.start()
+    outcomes: dict[str, Json] = {}
+    deadline = time.monotonic() + seconds
+    reads = 0
+    while time.monotonic() < deadline:
+        result, body = raw_download(agent.port, path)
+        reads += 1
+        key = f"{result['status']}:{result['content_length']}:{result['end']}:{sha256(body)}"
+        entry = outcomes.setdefault(key, {"count": 0, "body_hex": body.hex()[:400]} | result)
+        entry["count"] += 1
+    stop.set()
+    thread.join()
+    return {
+        "reads": reads,
+        "swaps": swaps,
+        "versions": {sha256(pending): "pending", sha256(terminal): "terminal"},
+        "outcomes": outcomes,
+    }
+
+
+def stress_immutable(agent: Agent, publications: int) -> Json:
+    """Natural timing for a publication that never rebinds a name: each record is written
+    to a temporary file and renamed to a fresh name once. The raw client polls the next
+    name until it answers 200. A 404 before publication is expected."""
+    names = agent.target / "published"
+    names.mkdir()
+    outcomes: dict[str, int] = {}
+    mismatches: list[Json] = []
+    for index in range(publications):
+        data = terminal_record() + f"{index}\n".encode()
+        final = names / f"record-{index:04}.json"
+        timer = threading.Timer(0.002 * (index % 5), replace, args=(final, data))
+        timer.start()
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline:
+            result, body = raw_download(agent.port, final)
+            if result["status"] == 200:
+                kind = "complete" if body == data and result["end"] == "complete" else "mismatch"
+                outcomes[kind] = outcomes.get(kind, 0) + 1
+                if kind == "mismatch":
+                    mismatches.append(result | {"body_hex": body.hex()[:400]})
+                break
+            outcomes[str(result["status"])] = outcomes.get(str(result["status"]), 0) + 1
+        timer.join()
+    return {"publications": publications, "outcomes": outcomes, "mismatches": mismatches}
+
+
+def historical_digests() -> dict[str, str | None]:
+    return {
+        name: sha256((HISTORICAL / name).read_bytes()) if (HISTORICAL / name).exists() else None
+        for name in HISTORICAL_SHA256
+    }
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 3:
+        print(__doc__, file=sys.stderr)
+        return 64
+    out = Path(argv[1])
+    out.mkdir(parents=True)
+    agents = {label: Path(path) for label, _, path in (a.partition("=") for a in argv[2:])}
+    shim = out / "shim.dylib"
+    subprocess.run(
+        ["clang", "-Wall", "-Wextra", "-O1", "-dynamiclib", "-o", str(shim), str(SHIM_SOURCE)],
+        check=True,
+    )
+    meta: Json = {
+        "started_unix": time.time(),
+        "cli": {"path": str(CLI), "sha256": sha256(CLI.read_bytes())},
+        "shim": {
+            "source_sha256": sha256(SHIM_SOURCE.read_bytes()),
+            "sha256": sha256(shim.read_bytes()),
+        },
+        "agents": {
+            k: {"path": str(v), "sha256": sha256(v.read_bytes())} for k, v in agents.items()
+        },
+        "historical_before": historical_digests(),
+        "bounds": {"raw_s": RAW_TIMEOUT, "cli_s": CLI_TIMEOUT, "pause_s": PAUSE_TIMEOUT},
+    }
+    (out / "meta.json").write_text(json.dumps(meta, indent=2))
+    records: list[Json] = []
+    for label, binary in agents.items():
+        root = out / label
+        probe = Agent(label, binary, shim, root / "calibration")
+        probe.start()
+        try:
+            calibration = calibrate(probe)
+        finally:
+            probe.stop()
+        calibration["agent"] = probe.record
+        (root / "calibration" / "calibration.json").write_text(json.dumps(calibration, indent=2))
+        for case in cases():
+            for client in ("raw", "cli"):
+                if case.kill_cli and client == "raw":
+                    continue
+                agent = Agent(label, binary, shim, root / f"{case.name}-{client}")
+                agent.start()
+                record: Json
+                try:
+                    record = run_case(agent, case, client, calibration)
+                except Exception as error:  # retained as evidence, never retried
+                    record = {"case": case.name, "client": client, "error": repr(error)}
+                finally:
+                    agent.stop()
+                record["agent"] = agent.record
+                (agent.root / "record.json").write_text(json.dumps(record, indent=2))
+                records.append(record)
+                print(label, case.name, client, json.dumps(record.get("result", record))[:300])
+        stress: list[tuple[str, Callable[[Agent], Json]]] = [
+            ("stress-mutable", lambda a: stress_mutable(a, STRESS_SECONDS)),
+            ("stress-immutable", lambda a: stress_immutable(a, 200)),
+        ]
+        for name, run in stress:
+            agent = Agent(label, binary, shim, root / name, trace=False)
+            agent.start()
+            try:
+                record = {"case": name} | run(agent)
+            finally:
+                agent.stop()
+            record["agent"] = agent.record
+            (agent.root / "record.json").write_text(json.dumps(record, indent=2))
+            print(label, name, json.dumps(record)[:300])
+    meta["historical_after"] = historical_digests()
+    meta["finished_unix"] = time.time()
+    (out / "meta.json").write_text(json.dumps(meta, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/experiments/exec-reliability/download_k7_check.py b/experiments/exec-reliability/download_k7_check.py
new file mode 100644
index 0000000000..c15eef70bb
--- /dev/null
+++ b/experiments/exec-reliability/download_k7_check.py
@@ -0,0 +1,299 @@ def sha256(data: bytes) -> str:
+"""Judge one retained download_k7 OUT directory.
+
+Usage: download_k7_check.py OUT [RESULT]
+
+Each raw and Host CLI download gets one class:
+
+- allowed-complete: the transfer reports success and the bytes equal a version that the
+  file held during the case.
+- detected-failure: the transfer reports failure and leaves no destination and no
+  temporary file.
+- detected-failure-leak: the transfer reports failure but leaves a temporary file.
+- undetected-wrong: the transfer reports success but the bytes equal no allowed version.
+- framing-violation: the raw client received bytes after Content-Length.
+- unclassified: the evidence is missing or does not fit one of the classes above.
+
+An interrupted Host CLI is clean-interrupt or interrupt-leak. An undetected-wrong result
+is a finding, not a check failure. The checker exits 0 only when the evidence is complete:
+every planned record exists and is classified, the oracle controls behave, every agent
+listened on loopback only and stopped, and the historical failure D files keep their
+digests. The checker never repairs, retries or normalises bytes.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+Json = dict[str, Any]
+
+# Independent copies of the constants in download_k7.py. They are not imported, so that an
+# error in the controller cannot also change the oracle.
+ORACLE_HEX = "00ff80410a"
+HISTORICAL = Path(
+    "/Users/antony/Development/AgenticOrchestration/Ravel-Strategies.gh-issue-1/"
+    "experiments/tutorial-vm-reliability/evidence/macos-candidate-02"
+)
+HISTORICAL_SHA256 = {
+    "after-abrupt-03-initial.json": (
+        "b95c9261fb8ff0ca68a9d8b06ebdcb4102a72f60b670c2d748cdf4eca454e7a4"
+    ),
+    "after-abrupt-03-state-002.json": (
+        "ca41852314b967a327b0a4faf0240cac2f2e304387439e5518cf380da4b9a56e"
+    ),
+    "after-abrupt-03-collect-002.json": (
+        "6645b2e4b55f2b89a7e635bfa6bd17074f538c2978606e01852ce049cc3740a3"
+    ),
+    "after-abrupt-03-launch.json": (
+        "eb9c539fccdae4d746627b159d754845a725782efe37d548b61f57de555338b7"
+    ),
+}
+FAILURE_D_SHA256 = HISTORICAL_SHA256["after-abrupt-03-state-002.json"]
+CASES = [
+    "replace-longer",
+    "replace-shorter",
+    "truncate-during-read",
+    "overwrite-during-read",
+    "append-during-read",
+    "immutable-binary",
+    "agent-killed-mid-body",
+]
+CLI_ONLY = ["cli-killed-mid-body"]
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def matches(body: bytes, allowed: list[bytes]) -> bool:
+    """Exact equality with one allowed version. No prefix, suffix or trim is accepted."""
+    return any(body == version for version in allowed)
+
+
+def oracle_controls(out: Path) -> Json:
+    """Write the oracle and two corrupted copies, then read each back from disk. The
+    comparator must accept the exact copy and reject the flipped and truncated copies."""
+    oracle = bytes.fromhex(ORACLE_HEX)
+    flipped = bytearray(oracle)
+    flipped[2] ^= 0x01
+    copies = {"exact": oracle, "flipped": bytes(flipped), "truncated": oracle[:4]}
+    folder = out / "oracle-controls"
+    folder.mkdir(exist_ok=True)
+    result: Json = {}
+    for name, data in copies.items():
+        path = folder / f"{name}.bin"
+        path.write_bytes(data)
+        read = path.read_bytes()
+        result[name] = {"sha256": sha256(read), "accepted": matches(read, [oracle])}
+    result["behaves"] = (
+        result["exact"]["accepted"]
+        and not result["flipped"]["accepted"]
+        and not result["truncated"]["accepted"]
+    )
+    return result
+
+
+def allowed_versions(case_dir: Path) -> list[bytes]:
+    return [p.read_bytes() for p in sorted(case_dir.glob("allowed-*.bin"))]
+
+
+def classify_raw(case_dir: Path, record: Json, allowed: list[bytes]) -> Json:
+    result: Json = record.get("result") or {}
+    received = case_dir / "received.bin"
+    if "error" in record or "end" not in result or not received.exists():
+        return {"class": "unclassified", "reason": record.get("error") or "no raw result"}
+    body = received.read_bytes()
+    if sha256(body) != result.get("sha256"):
+        return {"class": "unclassified", "reason": "received.bin differs from the record"}
+    out: Json = {
+        "status": result.get("status"),
+        "content_length": result.get("content_length"),
+        "received": len(body),
+        "end": result["end"],
+        "sha256": sha256(body),
+        "failure_d_bytes": sha256(body) == FAILURE_D_SHA256,
+    }
+    end = result["end"]
+    if end == "complete-extra-bytes":
+        return out | {"class": "framing-violation"}
+    if end in ("complete", "complete-open") and result.get("status") == 200:
+        allowed_match = matches(body, allowed)
+        return out | {"class": "allowed-complete" if allowed_match else "undetected-wrong"}
+    if end in ("eof-before-length", "timeout-before-length"):
+        return out | {"class": "detected-failure"}
+    return out | {"class": "unclassified", "reason": f"end {end}"}
+
+
+def classify_cli(case_dir: Path, record: Json, allowed: list[bytes]) -> Json:
+    if "cli_killed" in record:
+        killed: Json = record["cli_killed"]
+        clean = not killed.get("destination_exists") and not killed.get("temporaries_after")
+        return {
+            "class": "clean-interrupt" if clean else "interrupt-leak",
+            "exit": killed.get("exit"),
+            "temporaries_while_paused": killed.get("temporaries_while_paused"),
+            "temporaries_after": killed.get("temporaries_after"),
+        }
+    result: Json = record.get("result") or {}
+    if "error" in record or "exit" not in result:
+        return {"class": "unclassified", "reason": record.get("error") or "no CLI result"}
+    out: Json = {
+        "exit": result["exit"],
+        "killed_at_bound": result.get("killed_at_bound"),
+        "temporaries": result.get("temporaries"),
+        "stderr": str(result.get("stderr", ""))[:300],
+    }
+    local = case_dir / "local" / f"{record['case']}.bin"
+    if result["exit"] == 0:
+        if not local.exists():
+            return out | {"class": "unclassified", "reason": "exit 0 without a destination"}
+        body = local.read_bytes()
+        try:
+            receipt: Json = json.loads(str(result.get("stdout", "")))
+        except json.JSONDecodeError:
+            receipt = {}
+        out |= {
+            "destination_bytes": len(body),
+            "sha256": sha256(body),
+            "receipt_bytes": receipt.get("bytes"),
+            "failure_d_bytes": sha256(body) == FAILURE_D_SHA256,
+        }
+        return out | {"class": "allowed-complete" if matches(body, allowed) else "undetected-wrong"}
+    if result.get("killed_at_bound"):
+        return out | {"class": "unclassified", "reason": "killed at the CLI bound"}
+    if local.exists():
+        return out | {"class": "unclassified", "reason": "failure left a destination"}
+    if result.get("temporaries"):
+        return out | {"class": "detected-failure-leak"}
+    return out | {"class": "detected-failure"}
+
+
+def agent_ok(record: Json) -> bool:
+    agent: Json = record.get("agent") or {}
+    return bool(agent.get("loopback_only")) and agent.get("alive_after_stop") is False
+
+
+def stress_summary(record: Json) -> Json:
+    if "outcomes" not in record:
+        return {"complete": False}
+    if "publications" in record:
+        outcomes: Json = record["outcomes"]
+        return {
+            "complete": True,
+            "publications": record["publications"],
+            "complete_reads": outcomes.get("complete", 0),
+            "mismatches": len(record.get("mismatches", [])),
+        }
+    if "versions" not in record:
+        return {"complete": False}
+    versions: Json = record["versions"]
+    classes: dict[str, int] = {}
+    wrong: dict[str, int] = {}
+    for entry in record["outcomes"].values():
+        end = entry["end"]
+        if end in ("complete", "complete-open") and entry["status"] == 200:
+            if entry["sha256"] in versions:
+                key = "allowed-complete"
+            else:
+                key = "undetected-wrong"
+                wrong[entry["sha256"]] = wrong.get(entry["sha256"], 0) + entry["count"]
+        elif end in ("eof-before-length", "timeout-before-length"):
+            key = "detected-failure"
+        else:
+            key = "unclassified"
+        classes[key] = classes.get(key, 0) + entry["count"]
+    return {
+        "complete": True,
+        "reads": record["reads"],
+        "swaps": record["swaps"],
+        "classes": classes,
+        "undetected_wrong_sha256": wrong,
+        "failure_d_bytes": wrong.get(FAILURE_D_SHA256, 0),
+    }
+
+
+def check(out: Path) -> Json:
+    meta: Json = json.loads((out / "meta.json").read_text())
+    historical_now = {
+        name: sha256((HISTORICAL / name).read_bytes()) if (HISTORICAL / name).exists() else None
+        for name in HISTORICAL_SHA256
+    }
+    historical_ok = (
+        historical_now == HISTORICAL_SHA256
+        and meta.get("historical_before") == HISTORICAL_SHA256
+        and meta.get("historical_after") == HISTORICAL_SHA256
+    )
+    oracle = oracle_controls(out)
+    problems: list[str] = []
+    if not historical_ok:
+        problems.append("historical failure D digests changed or are missing")
+    if not oracle["behaves"]:
+        problems.append("oracle controls did not behave")
+    agents: Json = {}
+    for label in meta["agents"]:
+        root = out / label
+        rows: Json = {}
+        calibration = root / "calibration" / "calibration.json"
+        if not calibration.exists():
+            problems.append(f"{label}: no calibration")
+        for case in CASES + CLI_ONLY:
+            clients = ["cli"] if case in CLI_ONLY else ["raw", "cli"]
+            for client in clients:
+                case_dir = root / f"{case}-{client}"
+                path = case_dir / "record.json"
+                if not path.exists():
+                    rows[f"{case}/{client}"] = {"class": "unclassified", "reason": "missing"}
+                    problems.append(f"{label}: {case}/{client} missing")
+                    continue
+                record: Json = json.loads(path.read_text())
+                allowed = allowed_versions(case_dir)
+                if client == "raw":
+                    row = classify_raw(case_dir, record, allowed)
+                else:
+                    row = classify_cli(case_dir, record, allowed)
+                row["agent_ok"] = agent_ok(record)
+                if row["class"] == "unclassified":
+                    problems.append(f"{label}: {case}/{client} unclassified")
+                if not row["agent_ok"]:
+                    problems.append(f"{label}: {case}/{client} agent not loopback or not stopped")
+                rows[f"{case}/{client}"] = row
+        for name in ("stress-mutable", "stress-immutable"):
+            path = root / name / "record.json"
+            if not path.exists():
+                problems.append(f"{label}: {name} missing")
+                continue
+            record = json.loads(path.read_text())
+            summary = stress_summary(record) | {"agent_ok": agent_ok(record)}
+            if not summary["complete"] or not summary["agent_ok"]:
+                problems.append(f"{label}: {name} incomplete")
+            rows[name] = summary
+        agents[label] = rows
+    return {
+        "complete": not problems,
+        "problems": problems,
+        "historical": {"now": historical_now, "unchanged": historical_ok},
+        "oracle_controls": oracle,
+        "agents": agents,
+    }
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) not in (2, 3):
+        print(__doc__, file=sys.stderr)
+        return 64
+    out = Path(argv[1])
+    result = check(out)
+    target = out / (argv[2] if len(argv) == 3 else "check.json")
+    if target.exists():
+        print(f"refusing to overwrite {target}", file=sys.stderr)
+        return 2
+    target.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({"complete": result["complete"], "problems": result["problems"]}))
+    return 0 if result["complete"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/experiments/exec-reliability/download_k7_run.sh b/experiments/exec-reliability/download_k7_run.sh
new file mode 100755
index 0000000000..fc464f4215
--- /dev/null
+++ b/experiments/exec-reliability/download_k7_run.sh
@@ -0,0 +1,70 @@
+#!/bin/sh
+# One macOS download consistency run on the host (leaf download-consistency-k7).
+# Usage: download_k7_run.sh OUT
+# The probe runs the shipped macOS agent and an agent built from this checkout, each on
+# loopback, with the k7 shim. No VM, container or guest is used.
+# The outer records read only: source identity, host identity, tool versions, the
+# agent processes and the loopback listeners before and after.
+# tooling-before.sha256 and tooling-after.sha256 hold the digests of the tools that decide
+# the outcome. The first is taken before the probe, the second after the check.
+# An undetected-wrong class is a finding. The check can pass with a reproduced failure.
+# The script exits 0 only when the build, the probe and the check exit 0, the two tool
+# digest lists are equal and no agent process from the probe survives. Else it exits 1.
+set -u
+OUT=$1
+test ! -e "$OUT" && test ! -e "$OUT-outer" || { echo "refusing an existing OUT: $OUT" >&2; exit 2; }
+HERE=experiments/exec-reliability
+SHIPPED=/opt/homebrew/opt/testanyware/share/testanyware/agents/macos/testanyware-agent
+TOOLS="$HERE/download_k7_run.sh $HERE/download_k7.py $HERE/download_k7_shim.c
+$HERE/download_k7_check.py $HERE/pyproject.toml $HERE/uv.lock Taskfile.yml"
+mkdir -p "$OUT-outer"
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-before.sha256"
+jj log -r @- --no-graph -T 'commit_id ++ "\n"' > "$OUT-outer/source-commit"
+jj diff --git > "$OUT-outer/source-dirty.diff"
+sysctl hw.ncpu hw.activecpu hw.memsize kern.osproductversion > "$OUT-outer/host-sysctl"
+testanyware --version > "$OUT-outer/cli-version"
+swift --version > "$OUT-outer/swift-version" 2>&1
+clang --version > "$OUT-outer/clang-version" 2>&1
+cp agents/macos/Package.resolved "$OUT-outer/Package.resolved"
+codesign -dv --verbose=4 "$SHIPPED" > "$OUT-outer/shipped-codesign" 2>&1
+pgrep -lf testanyware-agent > "$OUT-outer/agents-before.txt"
+lsof -nP -iTCP -sTCP:LISTEN > "$OUT-outer/listen-before.txt"
+# The build tree is large, so it lives outside the repository. Only its log, its exit
+# and the digest of the agent binary are kept. The script removes the tree at the end.
+BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/download-k7-build.XXXXXX")
+echo "$BUILD_DIR" > "$OUT-outer/build-dir"
+swift build -c release --package-path agents/macos --scratch-path "$BUILD_DIR" \
+  > "$OUT-outer/build.log" 2>&1
+BUILD=$?
+echo "$BUILD" > "$OUT-outer/build.exit"
+CHECKOUT="$BUILD_DIR/release/testanyware-agent"
+PROBE=1
+if test "$BUILD" -eq 0; then
+  uv run --project "$HERE" --locked python "$HERE/download_k7.py" "$OUT" \
+    "shipped=$SHIPPED" "checkout=$CHECKOUT" > "$OUT-outer/probe.stdout" 2> "$OUT-outer/probe.stderr"
+  PROBE=$?
+fi
+echo "$PROBE" > "$OUT-outer/probe.exit"
+pgrep -lf testanyware-agent > "$OUT-outer/agents-after.txt"
+lsof -nP -iTCP -sTCP:LISTEN > "$OUT-outer/listen-after.txt"
+CHECK=1
+if test "$PROBE" -eq 0; then
+  uv run --project "$HERE" --locked python "$HERE/download_k7_check.py" "$OUT" \
+    > "$OUT-outer/check.stdout" 2> "$OUT-outer/check.stderr"
+  CHECK=$?
+fi
+echo "$CHECK" > "$OUT-outer/check.exit"
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-after.sha256"
+rm -rf "$BUILD_DIR"
+test -e "$BUILD_DIR" && echo present > "$OUT-outer/build-dir-after" || echo removed > "$OUT-outer/build-dir-after"
+SURVIVORS=0
+# A survivor is an agent process listed after the probe and not before it.
+if grep -vxF -f "$OUT-outer/agents-before.txt" "$OUT-outer/agents-after.txt" \
+  > "$OUT-outer/survivors.txt"; then SURVIVORS=1; fi
+if test "$BUILD" -eq 0 && test "$PROBE" -eq 0 && test "$CHECK" -eq 0 && test "$SURVIVORS" -eq 0 &&
+  cmp -s "$OUT-outer/tooling-before.sha256" "$OUT-outer/tooling-after.sha256"; then
+  exit 0
+fi
+exit 1
diff --git a/experiments/exec-reliability/download_k7_shim.c b/experiments/exec-reliability/download_k7_shim.c
new file mode 100644
index 0000000000..a76cfe1a04
--- /dev/null
+++ b/experiments/exec-reliability/download_k7_shim.c
@@ -0,0 +1,318 @@ static const char *env(const char *name) {
+/*
+ * Download seam for leaf download-consistency-k7.
+ *
+ * This library is loaded into the unchanged macOS agent with DYLD_INSERT_LIBRARIES
+ * (man 1 dyld). It replaces stat, lstat, fstatat, open, openat, pread, close and bind
+ * through the dyld __interpose section. Calls made by this library itself reach the
+ * real functions, because dyld does not interpose the interposing image.
+ *
+ * Environment:
+ *   K7_TARGET_DIR  absolute directory. Only paths below it are traced or paused.
+ *   K7_TRACE       JSON Lines trace file, opened with O_APPEND.
+ *   K7_GATE        gate directory. The controller writes <gate>/arm as
+ *                  "EVENT N GENERATION", where EVENT is stat, lstat, open or pread.
+ *                  Each new GENERATION restarts the per-event counts. The Nth
+ *                  matching call consumes the arm, writes <gate>/paused and waits
+ *                  for <gate>/resume, for 60 s at most. stat, lstat and open pause
+ *                  after the call returns. pread pauses before the call.
+ *   K7_LOOPBACK    when "1", a bind to the IPv4 or IPv6 wildcard address binds to
+ *                  the loopback address instead.
+ */
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/param.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+#define INTERPOSE(replacement, original)                                                   \
+    __attribute__((used)) static const struct {                                            \
+        const void *replacement_function;                                                  \
+        const void *original_function;                                                     \
+    } interpose_##original __attribute__((section("__DATA,__interpose"))) = {              \
+        (const void *)(unsigned long)&replacement, (const void *)(unsigned long)&original}
+
+#define MAX_FD 4096
+#define PAUSE_LIMIT_MS 60000
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned char traced_fd[MAX_FD];
+
+static const char *env(const char *name) {
+    const char *value = getenv(name);
+    return value && value[0] ? value : NULL;
+}
+
+static int below_target(const char *path) {
+    const char *dir = env("K7_TARGET_DIR");
+    if (!dir || !path) return 0;
+    size_t n = strlen(dir);
+    return strncmp(path, dir, n) == 0 && (path[n] == '/' || path[n] == '\0');
+}
+
+static void trace(const char *format, ...) {
+    const char *file = env("K7_TRACE");
+    if (!file) return;
+    char body[1536];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(body, sizeof body, format, args);
+    va_end(args);
+    struct timespec now;
+    clock_gettime(CLOCK_REALTIME, &now);
+    uint64_t thread = 0;
+    pthread_threadid_np(NULL, &thread);
+    char line[2048];
+    int length = snprintf(line, sizeof line, "{\"ns\":%lld,\"tid\":%llu,%s}\n",
+                          (long long)now.tv_sec * 1000000000LL + now.tv_nsec,
+                          (unsigned long long)thread, body);
+    int fd = open(file, O_WRONLY | O_APPEND | O_CREAT, 0644);
+    if (fd < 0) return;
+    if (length > 0) write(fd, line, (size_t)length < sizeof line ? (size_t)length : sizeof line - 1);
+    close(fd);
+}
+
+/* Paths in the trace are below K7_TARGET_DIR and hold only safe characters. */
+static void gate_path(char *out, size_t size, const char *leaf) {
+    snprintf(out, size, "%s/%s", env("K7_GATE"), leaf);
+}
+
+/* Count this call and consume the arm when it matches. Returns the count of this
+ * event type in the current generation, negated when this call must pause. */
+static const char *EVENTS[] = {"stat", "lstat", "open", "pread"};
+static long counts[4];
+static char generation[64];
+
+static long count_and_arm(const char *event) {
+    if (!env("K7_GATE")) return 0;
+    char arm[MAXPATHLEN], consumed[MAXPATHLEN], spec[128] = {0};
+    gate_path(arm, sizeof arm, "arm");
+    gate_path(consumed, sizeof consumed, "arm.consumed");
+    int index = -1;
+    for (int i = 0; i < 4; i++)
+        if (strcmp(event, EVENTS[i]) == 0) index = i;
+    if (index < 0) return 0;
+    pthread_mutex_lock(&lock);
+    long nth = ++counts[index];
+    int pause = 0;
+    int fd = open(arm, O_RDONLY);
+    if (fd >= 0) {
+        ssize_t n = read(fd, spec, sizeof spec - 1);
+        close(fd);
+        char want[16] = {0}, gen[64] = {0};
+        long target = 0;
+        if (n > 0 && sscanf(spec, "%15s %ld %63s", want, &target, gen) == 3) {
+            if (strcmp(gen, generation) != 0) {
+                strcpy(generation, gen);
+                memset(counts, 0, sizeof counts);
+                nth = counts[index] = 1;
+            }
+            if (strcmp(want, event) == 0 && target == nth) {
+                pause = 1;
+                rename(arm, consumed);
+            }
+        }
+    }
+    pthread_mutex_unlock(&lock);
+    return pause ? -nth : nth;
+}
+
+static void pause_here(const char *event, const char *path, long nth) {
+    char paused[MAXPATHLEN], resume[MAXPATHLEN];
+    gate_path(paused, sizeof paused, "paused");
+    gate_path(resume, sizeof resume, "resume");
+    int fd = open(paused, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd >= 0) {
+        dprintf(fd, "%s %ld %s\n", event, nth, path);
+        close(fd);
+    }
+    trace("\"event\":\"pause\",\"at\":\"%s\",\"nth\":%ld,\"path\":\"%s\"", event, nth, path);
+    long waited = 0;
+    struct stat ignored;
+    while (stat(resume, &ignored) != 0 && waited < PAUSE_LIMIT_MS) {
+        usleep(5000);
+        waited += 5;
+    }
+    int timed_out = waited >= PAUSE_LIMIT_MS;
+    unlink(resume);
+    unlink(paused);
+    trace("\"event\":\"resume\",\"at\":\"%s\",\"waited_ms\":%ld,\"timed_out\":%s", event, waited,
+          timed_out ? "true" : "false");
+}
+
+static void trace_stat(const char *call, const char *path, int rc, int error,
+                       const struct stat *info) {
+    if (rc == 0)
+        trace("\"event\":\"%s\",\"path\":\"%s\",\"rc\":0,\"ino\":%llu,\"size\":%lld", call, path,
+              (unsigned long long)info->st_ino, (long long)info->st_size);
+    else
+        trace("\"event\":\"%s\",\"path\":\"%s\",\"rc\":%d,\"errno\":%d", call, path, rc, error);
+}
+
+static int k7_stat(const char *path, struct stat *info) {
+    int rc = stat(path, info);
+    int error = errno;
+    if (below_target(path)) {
+        long nth = count_and_arm("stat");
+        trace_stat("stat", path, rc, error, info);
+        if (nth < 0) pause_here("stat", path, -nth);
+    }
+    errno = error;
+    return rc;
+}
+
+static int k7_lstat(const char *path, struct stat *info) {
+    int rc = lstat(path, info);
+    int error = errno;
+    if (below_target(path)) {
+        long nth = count_and_arm("lstat");
+        trace_stat("lstat", path, rc, error, info);
+        if (nth < 0) pause_here("lstat", path, -nth);
+    }
+    errno = error;
+    return rc;
+}
+
+static int k7_fstatat(int dirfd, const char *path, struct stat *info, int flags) {
+    int rc = fstatat(dirfd, path, info, flags);
+    int error = errno;
+    if (dirfd == AT_FDCWD && below_target(path)) trace_stat("fstatat", path, rc, error, info);
+    errno = error;
+    return rc;
+}
+
+static void opened(const char *call, const char *path, int fd, int flags, int error) {
+    if (fd < 0) {
+        trace("\"event\":\"%s\",\"path\":\"%s\",\"fd\":%d,\"errno\":%d", call, path, fd, error);
+        return;
+    }
+    struct stat info;
+    fstat(fd, &info);
+    pthread_mutex_lock(&lock);
+    if (fd < MAX_FD) traced_fd[fd] = 1;
+    pthread_mutex_unlock(&lock);
+    long nth = count_and_arm("open");
+    trace("\"event\":\"%s\",\"path\":\"%s\",\"fd\":%d,\"flags\":%d,\"ino\":%llu,\"size\":%lld",
+          call, path, fd, flags, (unsigned long long)info.st_ino, (long long)info.st_size);
+    if (nth < 0) pause_here("open", path, -nth);
+}
+
+static int k7_open(const char *path, int flags, ...) {
+    mode_t mode = 0;
+    if (flags & O_CREAT) {
+        va_list args;
+        va_start(args, flags);
+        mode = (mode_t)va_arg(args, int);
+        va_end(args);
+    }
+    int fd = open(path, flags, mode);
+    int error = errno;
+    if (below_target(path)) opened("open", path, fd, flags, error);
+    errno = error;
+    return fd;
+}
+
+static int k7_openat(int dirfd, const char *path, int flags, ...) {
+    mode_t mode = 0;
+    if (flags & O_CREAT) {
+        va_list args;
+        va_start(args, flags);
+        mode = (mode_t)va_arg(args, int);
+        va_end(args);
+    }
+    int fd = openat(dirfd, path, flags, mode);
+    int error = errno;
+    if (dirfd == AT_FDCWD && below_target(path)) opened("openat", path, fd, flags, error);
+    errno = error;
+    return fd;
+}
+
+static int is_traced(int fd) {
+    pthread_mutex_lock(&lock);
+    int traced = fd >= 0 && fd < MAX_FD && traced_fd[fd];
+    pthread_mutex_unlock(&lock);
+    return traced;
+}
+
+static ssize_t k7_pread(int fd, void *buffer, size_t count, off_t offset) {
+    if (!is_traced(fd)) return pread(fd, buffer, count, offset);
+    long nth = count_and_arm("pread");
+    char path[MAXPATHLEN] = "";
+    fcntl(fd, F_GETPATH, path);
+    if (nth < 0) {
+        nth = -nth;
+        pause_here("pread", path, nth);
+    }
+    struct stat info;
+    fstat(fd, &info);
+    ssize_t n = pread(fd, buffer, count, offset);
+    int error = errno;
+    trace("\"event\":\"pread\",\"fd\":%d,\"nth\":%ld,\"ino\":%llu,\"size_before\":%lld,"
+          "\"offset\":%lld,\"count\":%zu,\"returned\":%zd,\"errno\":%d",
+          fd, nth, (unsigned long long)info.st_ino, (long long)info.st_size, (long long)offset,
+          count, n, n < 0 ? error : 0);
+    errno = error;
+    return n;
+}
+
+static int k7_close(int fd) {
+    int traced = is_traced(fd);
+    if (traced) {
+        pthread_mutex_lock(&lock);
+        traced_fd[fd] = 0;
+        pthread_mutex_unlock(&lock);
+    }
+    int rc = close(fd);
+    int error = errno;
+    if (traced) trace("\"event\":\"close\",\"fd\":%d,\"rc\":%d", fd, rc);
+    errno = error;
+    return rc;
+}
+
+static int k7_bind(int socket, const struct sockaddr *address, socklen_t length) {
+    const char *loopback = env("K7_LOOPBACK");
+    if (!loopback || strcmp(loopback, "1") != 0 || !address) return bind(socket, address, length);
+    if (address->sa_family == AF_INET && length >= sizeof(struct sockaddr_in)) {
+        struct sockaddr_in copy;
+        memcpy(&copy, address, sizeof copy);
+        int rewritten = copy.sin_addr.s_addr == htonl(INADDR_ANY);
+        if (rewritten) copy.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        int rc = bind(socket, (const struct sockaddr *)&copy, sizeof copy);
+        int error = errno;
+        trace("\"event\":\"bind\",\"family\":\"inet\",\"port\":%d,\"rewritten\":%s,\"rc\":%d",
+              ntohs(copy.sin_port), rewritten ? "true" : "false", rc);
+        errno = error;
+        return rc;
+    }
+    if (address->sa_family == AF_INET6 && length >= sizeof(struct sockaddr_in6)) {
+        struct sockaddr_in6 copy;
+        memcpy(&copy, address, sizeof copy);
+        int rewritten = IN6_IS_ADDR_UNSPECIFIED(&copy.sin6_addr);
+        if (rewritten) copy.sin6_addr = in6addr_loopback;
+        int rc = bind(socket, (const struct sockaddr *)&copy, sizeof copy);
+        int error = errno;
+        trace("\"event\":\"bind\",\"family\":\"inet6\",\"port\":%d,\"rewritten\":%s,\"rc\":%d",
+              ntohs(copy.sin6_port), rewritten ? "true" : "false", rc);
+        errno = error;
+        return rc;
+    }
+    return bind(socket, address, length);
+}
+
+INTERPOSE(k7_stat, stat);
+INTERPOSE(k7_lstat, lstat);
+INTERPOSE(k7_fstatat, fstatat);
+INTERPOSE(k7_open, open);
+INTERPOSE(k7_openat, openat);
+INTERPOSE(k7_pread, pread);
+INTERPOSE(k7_close, close);
+INTERPOSE(k7_bind, bind);
