                elif fault == "malformed":
                    payload = b"{"
                elif fault == "duplicate-key":
                    payload = b'{"stdout":"",' + payload[1:]
                if fault == "oversized-frame":
                    frame = struct.pack("!I", 1024 * 1024 + 1)
