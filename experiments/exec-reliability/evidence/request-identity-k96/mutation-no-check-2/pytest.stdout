                    if "sid" in value
                    else "complete"
                    if "complete" in value
                    else "fork-error"
                    if "errno" in value
                    else "created"
                    if "ppid" in value
                    else "intent"
                )
            if kind == message:
                identity = value["identity"]
                if damage == "missing":
                    value.pop("identity")
                elif damage == "boolean":
                    identity["signal_epoch"] = True
                elif isinstance(identity[damage], str):
                    identity[damage] += "-stale"
                else:
                    identity[damage] += 1
            encoded = json.dumps(value).encode()
