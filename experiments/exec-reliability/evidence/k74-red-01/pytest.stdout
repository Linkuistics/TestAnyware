                    "control-tail": b"",
                    "short-header": b"\x00",
                    "short-frame": worker_capture.HEADER.pack(100) + b"{",
                    "oversized": worker_capture.HEADER.pack(worker_capture.FRAME_CAP + 1),
                }.get(mode, data)
                if not data:
                    os._exit(70)
