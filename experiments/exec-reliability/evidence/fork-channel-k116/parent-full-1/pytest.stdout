                if mode != "failure-term":
                    signal.signal(signal.SIGTERM, signal.SIG_IGN)
                identity = {
                    "session": session,
                    "pid": os.getpid(),
                    "pgid": os.getpgrp(),
                    "sid": os.getsid(0),
                }
                worker_capture._write(control, json.dumps(identity).encode() + b"\n", deadline)
                while True:
                    signal.pause()
            finally:
                os._exit(70)
    
        def waitpid(pid, flags):
            nonlocal injected
            assert flags == os.WNOHANG
