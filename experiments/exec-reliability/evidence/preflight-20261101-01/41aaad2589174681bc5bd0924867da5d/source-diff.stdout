diff --git a/experiments/exec-reliability/peer.py b/experiments/exec-reliability/peer.py
new file mode 100644
index 0000000000..cb39774574
--- /dev/null
+++ b/experiments/exec-reliability/peer.py
@@ -0,0 +1,53 @@ def main() -> None:
+"""Local fake public command peer; never touches a VM or a real app."""
+
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+
+def main() -> None:
+    mode, *args = sys.argv[1:]
+    if mode == "bytes":
+        sys.stdout.buffer.write(bytes.fromhex("00ff80410a"))
+        sys.stderr.buffer.write(b"separate stderr\n")
+    elif mode == "hang":
+        print("partial", flush=True)
+        time.sleep(60)
+    elif mode == "ignore-term":
+        signal.signal(signal.SIGTERM, signal.SIG_IGN)
+        print("ready", flush=True)
+        time.sleep(60)
+    elif mode == "fork":
+        child = subprocess.Popen(["/bin/sleep", "60"])
+
+        def terminate(_signal: int, _frame: object) -> None:
+            child.wait(timeout=1)
+            sys.exit(0)
+
+        signal.signal(signal.SIGTERM, terminate)
+        print(child.pid, flush=True)
+        child.wait()
+    elif mode == "fail":
+        print("forced public interface failure", file=sys.stderr)
+        sys.exit(23)
+    elif mode == "drift":
+        Path(args[0]).write_bytes(b"changed")
+    elif mode in {"acquire", "dispose", "inspect"}:
+        identity, root = args
+        marker = Path(root) / identity
+        if mode == "acquire":
+            marker.write_bytes(b"owned")
+        elif mode == "dispose":
+            marker.unlink()
+        elif not marker.exists():
+            print("absent")
+        else:
+            sys.exit(1)
+    else:
+        raise ValueError(mode)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/exec-reliability/preflight.py b/experiments/exec-reliability/preflight.py
new file mode 100644
index 0000000000..e5d49fb8d0
--- /dev/null
+++ b/experiments/exec-reliability/preflight.py
@@ -0,0 +1,113 @@ def main() -> None:
+"""Finite read-only host preflight. No guest requests, launches or installation."""
+
+import shutil
+import sys
+import uuid
+from dataclasses import asdict
+from pathlib import Path
+
+from controller import Call, Plan, execute, write_json
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+
+def main() -> None:
+    output = Path(sys.argv[1]).resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    cli = shutil.which("testanyware")
+    tart = shutil.which("tart")
+    jj = shutil.which("jj")
+    if cli is None or tart is None or jj is None:
+        raise SystemExit("preflight unavailable: testanyware, tart and jj must be on PATH")
+    app = Path("/Applications/TestAnyware.app/Contents/MacOS/testanyware-app")
+    socket = Path.home() / "Library/Application Support/TestAnyware/testanyware.sock"
+    commands: list[tuple[str, tuple[str, ...], float]] = [
+        ("cli-version", (cli, "--version"), 10),
+        ("cli-help", (cli, "--help"), 10),
+        ("agent-help", (cli, "agent", "--help"), 10),
+        ("file-help", (cli, "file", "--help"), 10),
+        ("exec-help", (cli, "file", "exec", "--help"), 10),
+        ("upload-help", (cli, "file", "upload", "--help"), 10),
+        ("download-help", (cli, "file", "download", "--help"), 10),
+        ("golden-help", (cli, "vm", "create-golden", "--help"), 10),
+        ("start-help", (cli, "vm", "start", "--help"), 10),
+        ("stop-help", (cli, "vm", "stop", "--help"), 10),
+        ("delete-help", (cli, "vm", "delete", "--help"), 10),
+        ("vm-list", (cli, "vm", "list", "--all", "--json"), 60),
+        ("doctor", (cli, "doctor", "--json"), 60),
+        (
+            "app-status",
+            (
+                "/usr/bin/curl",
+                "--silent",
+                "--show-error",
+                "--include",
+                "--max-time",
+                "10",
+                "--unix-socket",
+                str(socket),
+                "http://localhost/v1/status",
+            ),
+            15,
+        ),
+        ("socket-holder", ("/usr/sbin/lsof", "-n", "-a", "-U", str(socket)), 10),
+        ("tart-version", (tart, "--version"), 10),
+        ("tart-list", (tart, "list", "--format", "json"), 60),
+        ("app-signature", ("/usr/bin/codesign", "-d", "--verbose=4", str(app)), 10),
+        ("app-uuid", ("/usr/bin/dwarfdump", "--uuid", str(app)), 10),
+        ("host-version", ("/usr/bin/sw_vers",), 10),
+        (
+            "parent-source",
+            (jj, "log", "--no-pager", "-r", "@-", "--no-graph", "-T", "commit_id"),
+            10,
+        ),
+        ("source-diff", (jj, "diff", "--no-pager", "--git"), 10),
+    ]
+    subjects = (
+        Path(__file__),
+        HERE / "controller.py",
+        HERE / "peer.py",
+        HERE / "test_controller.py",
+        HERE / "pyproject.toml",
+        HERE / "uv.lock",
+        REPO / "Taskfile.yml",
+        REPO / "cli-rs/Cargo.toml",
+        REPO / "cli-rs/Cargo.lock",
+        Path(cli).resolve(),
+        Path(tart).resolve(),
+        app,
+        app.parent.parent / "Info.plist",
+    )
+    # Every independent condition is frozen before the first one runs. A failed
+    # condition is retained; continuing the inventory is not retrying that call.
+    plans = tuple(
+        Plan(
+            uuid.uuid4().hex,
+            (Call(name, argv, budget),),
+            subjects=tuple(p for p in subjects if p.is_file()),
+        )
+        for name, argv, budget in commands
+    )
+    write_json(output / "inventory.json", [asdict(plan) for plan in plans])
+    write_json(
+        output / "paths.json",
+        {
+            str(path): path.exists()
+            for path in (
+                REPO / "cli-rs/target/debug/testanyware",
+                REPO / "cli-rs/target/debug/testanyware-app",
+                REPO / "cli-rs/target/app/dev/TestAnyware Dev.app",
+                REPO / "agents/macos/.build/release/testanyware-agent",
+                app,
+                socket,
+            )
+        },
+    )
+    for plan in plans:
+        path = execute(plan, output)
+        print(f"{plan.calls[0].name}: {path}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/exec-reliability/pyproject.toml b/experiments/exec-reliability/pyproject.toml
new file mode 100644
index 0000000000..736002c689
--- /dev/null
+++ b/experiments/exec-reliability/pyproject.toml
@@ -0,0 +1,23 @@
+[project]
+name = "exec-reliability-diagnostics"
+version = "0.0.0"
+requires-python = ">=3.12"
+dependencies = []
+
+[dependency-groups]
+dev = ["pytest>=9,<10", "ruff>=0.17,<0.18", "pyright>=1.1,<2"]
+
+[tool.pytest.ini_options]
+pythonpath = ["."]
+testpaths = ["test_controller.py"]
+
+[tool.ruff]
+line-length = 100
+target-version = "py312"
+
+[tool.ruff.lint]
+select = ["E", "F", "W", "I", "UP", "B"]
+
+[tool.pyright]
+typeCheckingMode = "strict"
+include = ["controller.py", "peer.py", "preflight.py"]
diff --git a/experiments/exec-reliability/test_controller.py b/experiments/exec-reliability/test_controller.py
new file mode 100644
index 0000000000..9cc716afea
--- /dev/null
+++ b/experiments/exec-reliability/test_controller.py
@@ -0,0 +1,170 @@ def call(name, mode, *args, budget=3, interrupt_after=None):
+"""Failure controls operate on real local processes and fake VM markers only."""
+
+import json
+import os
+import signal
+import sys
+import uuid
+from pathlib import Path
+
+from controller import Call, Plan, Resource, execute
+
+HERE = Path(__file__).resolve().parent
+PEER = HERE / "peer.py"
+
+
+def call(name, mode, *args, budget=3, interrupt_after=None):
+    return Call(
+        name,
+        (sys.executable, str(PEER), mode, *map(str, args)),
+        budget,
+        interrupt_after=interrupt_after,
+    )
+
+
+def run(tmp_path, calls, resources=(), subjects=(), run_id=None):
+    root = Path(os.environ.get("DIAGNOSTIC_EVIDENCE", tmp_path / "evidence"))
+    plan = Plan(
+        run_id or uuid.uuid4().hex,
+        tuple(calls),
+        tuple(resources),
+        (PEER, Path(__file__), HERE / "pyproject.toml", HERE / "uv.lock", *subjects),
+        term_grace=0.15,
+        kill_wait=0.3,
+    )
+    path = execute(plan, root)
+    return path, json.loads((path / "result.json").read_text())
+
+
+def resource(tmp_path, run_id, *, inspection="inspect", cleanup="bytes", dispose="dispose"):
+    identity = f"diag-{run_id}-vm"
+    return Resource(
+        "vm",
+        identity,
+        call("acquire", "acquire", identity, tmp_path),
+        call("cleanup", cleanup, identity, tmp_path, budget=0.2),
+        call("dispose", dispose, identity, tmp_path, budget=0.2),
+        Call(
+            "inspect",
+            (sys.executable, str(PEER), inspection, identity, str(tmp_path)),
+            0.2,
+            expected_stdout=b"absent\n",
+        ),
+    )
+
+
+def test_exact_raw_capture_and_subject_freeze(tmp_path):
+    path, result = run(tmp_path, [call("bytes", "bytes")])
+    assert result["ok"] is True
+    assert (path / "bytes.stdout").read_bytes() == bytes.fromhex("00ff80410a")
+    assert (path / "bytes.stderr").read_bytes() == b"separate stderr\n"
+    assert result["subjects_before"] == result["subjects_after"]
+    assert result["calls"][0]["elapsed"] >= 0
+    assert json.loads((path / "plan.json").read_text())["calls"][0]["name"] == "bytes"
+
+
+def test_overlong_call_fails_and_retains_partial_bytes(tmp_path):
+    path, result = run(tmp_path, [call("overlong", "hang", budget=0.2), call("unreached", "bytes")])
+    assert result["ok"] is False
+    assert result["calls"][0]["reason"] == "deadline"
+    assert (path / "overlong.stdout").read_bytes() == b"partial\n"
+    assert result["unreached"] == ["unreached"]
+
+
+def test_cli_interruption_kills_term_ignorer_and_controller_survives(tmp_path):
+    controller_pid = os.getpid()
+    _, result = run(tmp_path, [call("interrupt", "ignore-term", interrupt_after=0.3)])
+    receipt = result["calls"][0]
+    assert receipt["reason"] == "interrupted"
+    assert receipt["returncode"] == -signal.SIGKILL
+    assert [event["signal"] for event in receipt["signals"]] == ["TERM", "KILL"]
+    assert receipt["reaped"] is True
+    assert os.getpid() == controller_pid
+
+
+def test_finally_disposal_independent_of_blocked_channel_and_failed_cleanup(tmp_path):
+    run_id = uuid.uuid4().hex
+    owned = resource(tmp_path, run_id, cleanup="fail")
+    unrelated = tmp_path / "unrelated"
+    unrelated.write_bytes(b"keep")
+    _, result = run(
+        tmp_path, [call("blocked-transfer", "hang", budget=0.2)], [owned], run_id=run_id
+    )
+    assert result["ok"] is False
+    assert result["resources"][0]["state"] == "disposed"
+    assert result["resources"][0]["cleanup_ok"] is False
+    assert not (tmp_path / owned.identity).exists()
+    assert unrelated.read_bytes() == b"keep"
+
+
+def test_failed_inspection_is_uncertain_even_after_successful_disposal(tmp_path):
+    run_id = uuid.uuid4().hex
+    _, result = run(tmp_path, [], [resource(tmp_path, run_id, inspection="fail")], run_id=run_id)
+    assert result["ok"] is False
+    assert result["resources"][0]["state"] == "uncertain"
+
+
+def test_blocked_disposal_is_bounded_and_retains_exact_residual(tmp_path):
+    run_id = uuid.uuid4().hex
+    owned = resource(tmp_path, run_id, dispose="ignore-term")
+    _, result = run(tmp_path, [], [owned], run_id=run_id)
+    assert result["ok"] is False
+    assert result["resources"][0]["state"] == "uncertain"
+    assert result["resources"][0]["identity"] == owned.identity
+    assert (tmp_path / owned.identity).read_bytes() == b"owned"
+
+
+def test_failed_transfer_preserves_raw_failure(tmp_path):
+    path, result = run(tmp_path, [call("transfer", "fail")])
+    assert result["ok"] is False
+    assert result["calls"][0]["returncode"] == 23
+    assert b"forced public interface failure" in (path / "transfer.stderr").read_bytes()
+
+
+def test_hashing_drift_fails_instead_of_reinterpreting_measurement(tmp_path):
+    subject = tmp_path / "input"
+    subject.write_bytes(b"frozen")
+    _, result = run(tmp_path, [call("drift", "drift", subject)], subjects=[subject])
+    assert result["ok"] is False
+    assert result["subjects_before"] != result["subjects_after"]
+
+
+def test_foreign_resource_and_reused_output_are_rejected_before_calls(tmp_path):
+    import pytest
+
+    with pytest.raises(ValueError, match="identity"):
+        run(tmp_path, [], [resource(tmp_path, "foreign")])
+    run_id = uuid.uuid4().hex
+    run(tmp_path, [], run_id=run_id)
+    with pytest.raises(FileExistsError):
+        run(tmp_path, [], run_id=run_id)
+
+
+def test_owned_fork_is_terminated_and_known_child_absent(tmp_path):
+    import pytest
+
+    path, result = run(tmp_path, [call("fork", "fork", budget=0.3)])
+    child = int((path / "fork.stdout").read_text())
+    assert result["calls"][0]["reaped"] is True
+    assert result["calls"][0]["elapsed"] < 0.3 + 0.15 + 0.3
+    with pytest.raises(ProcessLookupError):
+        os.kill(child, 0)
+
+
+def test_blocked_cleanup_and_inspection_do_not_skip_disposal(tmp_path):
+    run_id = uuid.uuid4().hex
+    owned = resource(tmp_path, run_id, cleanup="hang", inspection="hang")
+    path, result = run(tmp_path, [], [owned], run_id=run_id)
+    assert result["resources"][0]["state"] == "uncertain"
+    assert json.loads((path / "dispose.json").read_text())["ok"] is True
+    assert not (tmp_path / owned.identity).exists()
+
+
+def test_spawn_error_is_not_numeric_exit(tmp_path):
+    executable = tmp_path / "not-executable"
+    executable.write_bytes(b"no executable permission")
+    _, result = run(tmp_path, [Call("missing", (str(executable),), 1)])
+    assert result["ok"] is False
+    receipt = result["calls"][0]
+    assert receipt["reason"] == "spawn_error"
+    assert receipt["returncode"] is None
