diff --git a/experiments/exec-reliability/evidence/preflight-20261101-01/86ff6593afe44087a4486dfa2a860aaa/download-help.stdout b/experiments/exec-reliability/evidence/preflight-20261101-01/86ff6593afe44087a4486dfa2a860aaa/download-help.stdout
new file mode 100644
index 0000000000..548474f1a1
--- /dev/null
+++ b/experiments/exec-reliability/evidence/preflight-20261101-01/86ff6593afe44087a4486dfa2a860aaa/download-help.stdout
@@ -0,0 +1,62 @@
+Download a file from guest to host
+
+Usage: testanyware file download [OPTIONS] <REMOTE> <LOCAL>
+
+Arguments:
+  <REMOTE>
+          
+
+  <LOCAL>
+          
+
+Options:
+      --connect <PATH>
+          Path to connection spec JSON file
+
+      --vm <ID>
+          [env: TESTANYWARE_VM_ID=]
+
+      --vnc <HOST:PORT>
+          [env: TESTANYWARE_VNC=]
+
+      --agent <HOST:PORT>
+          [env: TESTANYWARE_AGENT=]
+
+      --platform <PLATFORM>
+          [env: TESTANYWARE_PLATFORM=]
+
+      --json
+          Emit JSON envelope on stdout
+
+      --dry-run
+          Plan the download but do not perform it
+
+  -h, --help
+          Print help (see a summary with '-h')
+
+  -V, --version
+          Print version
+
+OUTPUT:
+    Stable formats: text (one-line confirmation), --json (schema:
+    file-download).
+
+EXIT CODES:
+    0  success
+    1  DOWNLOAD_FAILED, generic agent failure
+    2  USAGE_ERROR / NO_CONNECTION_SPECIFIED
+    3  VM_NOT_FOUND
+    7  CONNECTION_TIMEOUT
+
+IDEMPOTENCY:
+    Idempotent — overwrites the local file completely. Retry-safe.
+
+EXAMPLES:
+    # Pull a log file off the VM
+    testanyware file download --vm "$TESTANYWARE_VM_ID" /var/log/system.log ./system.log
+
+    # JSON envelope for scripting
+    testanyware file download --vm "$TESTANYWARE_VM_ID" /tmp/x ./x --json
+
+SEE ALSO:
+    testanyware file upload, testanyware file exec
