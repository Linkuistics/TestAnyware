++def test_burst_budget_covers_the_longest_mode() -> None:
++    longest = (
++        burst.ORIGINAL_BOUND
++        + burst.TRANSFER_BOUND
++        + 6 * burst.FOLLOW_BOUND
++        + 8 * 2 * burst.STOP_WAIT
++    )
++    assert disconnect_k13.BURST_BUDGET > longest
