index 0000000000..4715a576c3
--- /dev/null
+++ b/experiments/exec-reliability/disconnect_k13_burst.py
@@ -0,0 +1,327 @@ def guest_dir(mode: str) -> str:
+"""One k13 live mode against one clone, on one monotonic clock.
+
+    disconnect_k13_burst.py CLI VM MODE DOWNLOADS
+
+MODE is `control`, `concurrent` or `term`. The script starts the original exec:
+the issue #14 fork/wait payload with a 20 s guest timeout.
+
+- `control`: the original runs to its end. The follow-up sequence runs after.
+- `concurrent`: the follow-up sequence starts 2 s after the original starts.
+  The original is not signalled.
+- `term`: 2 s after the start, the script sends TERM to the CLI PID only.
+  After 2 s more, it sends KILL if the CLI still runs. The follow-up
+  sequence starts at once after the CLI ends or the KILL wait ends.
+
+The follow-up sequence is: inspect, health, ordinary exec, download of the
+immutable partial file, inspect again. Each request runs once, with no retry,
+inside its own bound. A request that exceeds its bound gets TERM, then KILL, on
+its process group, and stays a failed request. Two more inspections run on
+their own timer threads, at `MID_AT` and at `LATE_AT` seconds after the start.
+A slow follow-up therefore cannot move them. A waiter thread stamps the exit of
+the original CLI when it happens.
+
+The script prints one JSON document. It judges nothing.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import signal
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+GUEST_TIMEOUT = 20
+ACT_AFTER = 2.0
+TERM_GRACE = 2.0
+KILL_WAIT = 2.0
+ORIGINAL_BOUND = 40.0  # the guest timeout plus the 20 s host margin
+FOLLOW_BOUND = 30.0  # the ordinary observation bound
+TRANSFER_BOUND = 150.0  # the transfer ceiling
+INSPECT_TIMEOUT = 10  # the guest timeout of one inspection
+MID_AT = 18.0  # 2 s before the guest deadline
+LATE_AT = 30.0  # after the deadline, the runner terminate wait and scheduling
+STOP_WAIT = 2.0
+MODES = ("control", "concurrent", "term")
+ORDINARY = "printf ordinary-ok"
+PARTIAL = b"partial\n"
+
+
+def guest_dir(mode: str) -> str:
+    return f"/tmp/taw-k13/{mode}"
+
+
+def payload(mode: str) -> str:
+    """The issue #14 fork/wait payload. Only its directory differs from k4."""
+    d = guest_dir(mode)
+    return "\n".join(
+        (
+            f"mkdir -p {d}",
+            "sleep 120 & child=$!",
+            f"printf '%s\\n' \"$child\" > {d}/child.pid",
+            f"printf 'partial\\n' > {d}/partial",
+            "wait",
+        )
+    )
+
+
+def inspection(mode: str) -> str:
+    """Print one line per role: `ROLE pid=PID STATE ppid=PPID command=COMMAND`.
+
+    STATE is `present`, `absent` (no such process) or `unknown` (any other
+    error). A role with no PID file prints `ROLE pid=none`. The payload writes
+    no shell PID. The first inspection that sees the child alive under a parent
+    other than PID 1 records that parent as the shell. The record is named by
+    the child PID, so a record from an earlier payload never names this shell.
+    """
+    d = guest_dir(mode)
+    return "\n".join(
+        (
+            f"cpid=$(cat {d}/child.pid 2>/dev/null)",
+            f'if [ -n "$cpid" ] && [ ! -s {d}/shell.of."$cpid" ]; then',
+            "  ppid=$(ps -o ppid= -p \"$cpid\" | tr -d ' ')",
+            "  case \"$ppid\" in ''|1) ;; *)",
+            f'    printf \'%s\\n\' "$ppid" > {d}/shell.of."$cpid" ;;',
+            "  esac",
+            "fi",
+            "for role in shell child; do",
+            '  if [ "$role" = shell ]; then',
+            f'    pid=$(cat {d}/shell.of."$cpid" 2>/dev/null)',
+            "  else",
+            "    pid=$cpid",
+            "  fi",
+            '  if [ -z "$pid" ]; then printf \'%s pid=none\\n\' "$role"; continue; fi',
+            '  if err=$(kill -0 "$pid" 2>&1); then state=present',
+            '  else case "$err" in',
+            "    *[Nn]o\\ such\\ process*) state=absent ;;",
+            "    *) state=unknown ;;",
+            "  esac",
+            "  fi",
+            "  ppid=$(ps -p \"$pid\" -o ppid= | tr -d ' ')",
+            "  cmd=$(ps -p \"$pid\" -o command= | sed 's/ *$//')",
+            "  fmt='%s pid=%s %s ppid=%s command=%s\\n'",
+            '  printf "$fmt" "$role" "$pid" "$state" "$ppid" "$cmd"',
+            "done",
+        )
+    )
+
+
+def now_ns() -> int:
+    return time.monotonic_ns()
+
+
+def exec_argv(cli: str, vm: str, guest_timeout: int, command: str) -> list[str]:
+    return [cli, "file", "exec", "--vm", vm, "--timeout", str(guest_timeout), "--json", command]
+
+
+def stop_group(child: subprocess.Popen[bytes]) -> list[dict[str, Any]]:
+    signals: list[dict[str, Any]] = []
+    for sig, wait in ((signal.SIGTERM, STOP_WAIT), (signal.SIGKILL, STOP_WAIT)):
+        try:
+            os.killpg(child.pid, sig)
+            result = "sent"
+        except ProcessLookupError:
+            result = "gone"
+        signals.append({"signal": sig.name, "ns": now_ns(), "result": result})
+        try:
+            child.wait(timeout=wait)
+            break
+        except subprocess.TimeoutExpired:
+            continue
+    return signals
+
+
+def request(name: str, argv: list[str], bound: float) -> dict[str, Any]:
+    record: dict[str, Any] = {"name": name, "argv": argv, "start_ns": now_ns()}
+    child = subprocess.Popen(  # noqa: S603 - the CLI under test
+        argv,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        start_new_session=True,
+    )
+    try:
+        stdout, stderr = child.communicate(timeout=bound)
+        record["bound_exceeded"] = False
+    except subprocess.TimeoutExpired:
+        record["bound_exceeded"] = True
+        record["signals"] = stop_group(child)
+        stdout, stderr = child.communicate()
+    record.update(
+        end_ns=now_ns(),
+        returncode=child.returncode,
+        stdout_hex=stdout.hex(),
+        stderr_hex=stderr.hex(),
+    )
+    return record
+
+
+def follow_sequence(cli: str, vm: str, mode: str, downloads: Path) -> list[dict[str, Any]]:
+    local = downloads / f"{mode}-partial.bin"
+    steps = [
+        request("inspect", exec_argv(cli, vm, INSPECT_TIMEOUT, inspection(mode)), FOLLOW_BOUND),
+        request("health", [cli, "agent", "health", "--vm", vm, "--json"], FOLLOW_BOUND),
+        request("ordinary", exec_argv(cli, vm, INSPECT_TIMEOUT, ORDINARY), FOLLOW_BOUND),
+        request(
+            "download",
+            [
+                cli,
+                "file",
+                "download",
+                "--vm",
+                vm,
+                f"{guest_dir(mode)}/partial",
+                str(local),
+                "--json",
+            ],
+            TRANSFER_BOUND,
+        ),
+        request(
+            "inspect-after", exec_argv(cli, vm, INSPECT_TIMEOUT, inspection(mode)), FOLLOW_BOUND
+        ),
+    ]
+    download = steps[3]
+    download["local_hex"] = local.read_bytes().hex() if local.is_file() else None
+    return steps
+
+
+def sleep_until(deadline_ns: int) -> None:
+    remaining = (deadline_ns - now_ns()) / 1e9
+    if remaining > 0:
+        time.sleep(remaining)
+
+
+class Waiter:
+    """Stamp the exit of one process on the monotonic clock as it happens."""
+
+    def __init__(self, child: subprocess.Popen[bytes]) -> None:
+        self.child = child
+        self.exit_ns: int | None = None
+        self.done = threading.Event()
+        threading.Thread(target=self._wait, daemon=True).start()
+
+    def _wait(self) -> None:
+        self.child.wait()
+        self.exit_ns = now_ns()
+        self.done.set()
+
+    def wait_until(self, until_ns: int) -> bool:
+        return self.done.wait(timeout=max(0.0, (until_ns - now_ns()) / 1e9))
+
+
+def signal_cli(original: subprocess.Popen[bytes], waiter: Waiter) -> list[dict[str, Any]]:
+    """Send TERM to the CLI PID only. Send KILL after the grace if it still runs."""
+    signals: list[dict[str, Any]] = []
+    for sig, wait in ((signal.SIGTERM, TERM_GRACE), (signal.SIGKILL, KILL_WAIT)):
+        if waiter.done.is_set():
+            break
+        try:
+            os.kill(original.pid, sig)
+            outcome = "sent"
+        except ProcessLookupError:
+            outcome = "gone"
+        signals.append({"signal": sig.name, "ns": now_ns(), "result": outcome})
+        waiter.wait_until(now_ns() + int(wait * 1e9))
+    return signals
+
+
+def inspect(cli: str, vm: str, mode: str, name: str) -> dict[str, Any]:
+    return request(name, exec_argv(cli, vm, INSPECT_TIMEOUT, inspection(mode)), FOLLOW_BOUND)
+
+
+class Timed:
+    """One inspection that starts at a fixed time on its own thread."""
+
+    def __init__(self, cli: str, vm: str, mode: str, name: str, at_ns: int) -> None:
+        self.record: dict[str, Any] | None = None
+        self._args = (cli, vm, mode, name)
+        self._at_ns = at_ns
+        self._thread = threading.Thread(target=self._run, daemon=True)
+        self._thread.start()
+
+    def _run(self) -> None:
+        sleep_until(self._at_ns)
+        self.record = inspect(*self._args)
+
+    def join(self) -> dict[str, Any]:
+        # `request` bounds the inspection and stops its process group, so the join ends.
+        self._thread.join()
+        assert self.record is not None
+        return self.record
+
+
+def run(cli: str, vm: str, mode: str, downloads: Path) -> dict[str, Any]:
+    out_path = downloads / f"{mode}-original.stdout"
+    err_path = downloads / f"{mode}-original.stderr"
+    argv = exec_argv(cli, vm, GUEST_TIMEOUT, payload(mode))
+    result: dict[str, Any] = {"mode": mode, "argv": argv, "bounds": bounds()}
+    with out_path.open("wb") as out, err_path.open("wb") as err:
+        start = now_ns()
+        original = subprocess.Popen(  # noqa: S603 - the CLI under test
+            argv, stdin=subprocess.DEVNULL, stdout=out, stderr=err, start_new_session=True
+        )
+    waiter = Waiter(original)
+    result["start_ns"] = start
+    record: dict[str, Any] = {"pid": original.pid, "signals": []}
+    limit_ns = start + int(ORIGINAL_BOUND * 1e9)
+    timed: list[Timed] = []
+    if mode == "control":
+        waiter.wait_until(limit_ns)
+    else:
+        mid_ns = start + int(MID_AT * 1e9)
+        timed.append(Timed(cli, vm, mode, "inspect-mid", mid_ns))
+        timed.append(Timed(cli, vm, mode, "inspect-late", start + int(LATE_AT * 1e9)))
+        sleep_until(start + int(ACT_AFTER * 1e9))
+        if mode == "term":
+            record["signals"] = signal_cli(original, waiter)
+    result["act_ns"] = now_ns()
+    result["follow"] = follow_sequence(cli, vm, mode, downloads)
+    if mode == "control":
+        # The control inspections run after the follow-up sequence, so they never overlap it.
+        result["mid"] = inspect(cli, vm, mode, "inspect-mid")
+        result["late"] = inspect(cli, vm, mode, "inspect-late")
+    else:
+        result["mid"], result["late"] = (item.join() for item in timed)
+    if not waiter.wait_until(limit_ns):
+        record["stop"] = stop_group(original)
+        waiter.wait_until(now_ns() + int(STOP_WAIT * 1e9))
+    record.update(
+        bound_exceeded="stop" in record,
+        exit_ns=waiter.exit_ns,
+        returncode=original.returncode,
+        stdout_hex=out_path.read_bytes().hex(),
+        stderr_hex=err_path.read_bytes().hex(),
+    )
+    result["original"] = record
+    result["end_ns"] = now_ns()
+    return result
+
+
+def bounds() -> dict[str, float]:
+    return {
+        "guest_timeout": GUEST_TIMEOUT,
+        "act_after": ACT_AFTER,
+        "term_grace": TERM_GRACE,
+        "kill_wait": KILL_WAIT,
+        "original_bound": ORIGINAL_BOUND,
+        "follow_bound": FOLLOW_BOUND,
+        "transfer_bound": TRANSFER_BOUND,
+        "inspect_timeout": INSPECT_TIMEOUT,
+        "mid_at": MID_AT,
+        "late_at": LATE_AT,
+    }
+
+
+def main() -> None:
+    if len(sys.argv) != 5 or sys.argv[3] not in MODES:
+        raise SystemExit("usage: disconnect_k13_burst.py CLI VM control|concurrent|term DOWNLOADS")
+    cli, vm, mode, downloads = sys.argv[1], sys.argv[2], sys.argv[3], Path(sys.argv[4])
+    print(json.dumps(run(cli, vm, mode, downloads), sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/exec-reliability/disconnect_k13_check.py b/experiments/exec-reliability/disconnect_k13_check.py
new file mode 100644
index 0000000000..580e19bf3d
--- /dev/null
+++ b/experiments/exec-reliability/disconnect_k13_check.py
@@ -0,0 +1,732 @@ def mapping(value: object) -> dict[str, Any]:
+"""Judge the k13 disconnect evidence.
+
+    disconnect_k13_check.py host OUT
+    disconnect_k13_check.py live OUT
+
+`host` reads OUT/summary.json and the stdout of the `host` call in the run
+directory. `live` reads OUT/summary.json and the receipts of the live calls.
+Each mode writes OUT/check.json and prints one line per judged item.
+
+The exit status is 0 when the evidence is complete and sound. A finding, such as
+a blocked channel or a surviving child, is a measured outcome. A finding does
+not change the exit status. An unknown outcome is incomplete evidence, so it is
+a problem.
+
+Responsiveness oracle, declared before any run. A follow-up request is
+`responsive` when three conditions hold:
+
+1. It ends with its expected outcome inside its bound.
+2. Its answer comes before the original handler ends. This condition applies
+   only to a request that began before the handler ended.
+
+In the live mode, condition 2 fails only when the request provably spans the
+handler end. It began no later than one sighting of the shell alive, and it
+answered no earlier than one sighting of the shell gone.
+3. Its latency is at most the latency of the same request in the concurrent
+   control, plus `LATENCY_ALLOWANCE` seconds.
+
+A request with the expected outcome that fails condition 2 or 3 is `blocked`.
+A request that ends with another outcome, or exceeds its bound, is `failed`.
+In the live mode, an exec follow-up with complete output but a deadline reply
+is `completed-reported-timeout`. The k12 report names this receipt.
+A request whose control or handler end is unknown is `unknown`.
+
+In the live mode, the reference for condition 3 is a mode of the same clone.
+`concurrent` compares with `control`, and `term` compares with `concurrent`.
+When that mode has no sound latency for a request, `term` uses `control`. The
+`control` follow-ups run after the handler ends, so they are the `baseline`.
+
+Handler outcomes, from the end of the parent shell after the start:
+
+- `deadline`: the shell ended inside the deadline window.
+- `cancelled`: the shell ended before the window, so a disconnect ended it.
+- `overran`: the shell ended after the window, or did not end in the bound.
+- `unknown`: the evidence has no shell identity or end.
+
+The host mode reads each end from a process watch. The live mode cannot watch
+the guest, so it places the end between two inspections. One inspection saw the
+shell alive, and a later one saw it gone. The live mode accepts `deadline` only
+when the shell was seen alive at most 1 s before `MID_AT`.
+
+Child outcomes, from the end of the child relative to the end of the shell:
+
+- `ended-with-handler`: the child ended within `CHILD_SLACK` of the shell.
+  In the live mode, the late inspection found the child gone.
+- `survived-handler`: the child was still present after that.
+  In the live mode, the late inspection found `sleep 120` at the child PID.
+- `unknown`: the evidence has no child identity, or the inspection failed.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+from disconnect_k13_burst import MID_AT, MODES, PARTIAL, guest_dir
+from disconnect_k13_seam import CASES, GUEST_TIMEOUT, KILL_WAIT, ORIGINAL_BOUND, TERM_GRACE
+
+LATENCY_ALLOWANCE = 5.0  # the oracle allowance over the control latency
+SLACK = 0.25  # the scheduling allowance on a 2 s signal bound
+DEADLINE_EARLY = 0.5  # the deadline window starts this long before the guest timeout
+DEADLINE_LATE = 3.0 + 1.0  # the terminate wait of the runner, plus scheduling
+CHILD_SLACK = 1.0  # a child that ends within this of the shell ended with the handler
+ORDINARY_STDOUT = "ordinary-ok"
+
+
+def mapping(value: object) -> dict[str, Any]:
+    return value if isinstance(value, dict) else {}  # type: ignore[return-value]
+
+
+def items(value: object) -> list[dict[str, Any]]:
+    if not isinstance(value, list):
+        return []
+    return [mapping(item) for item in value]  # type: ignore[misc]
+
+
+def seconds(start_ns: object, end_ns: object) -> float | None:
+    if not isinstance(start_ns, int) or not isinstance(end_ns, int):
+        return None
+    return (end_ns - start_ns) / 1e9
+
+
+def json_body(data: bytes) -> dict[str, Any] | None:
+    try:
+        value = json.loads(data)
+    except ValueError:
+        return None
+    return mapping(value) if isinstance(value, dict) else None  # pyright: ignore[reportUnknownArgumentType]
+
+
+# ---- host mode ----
+
+
+def http_reply(raw: bytes) -> tuple[int | None, dict[str, Any] | None]:
+    head, sep, body = raw.partition(b"\r\n\r\n")
+    if not sep:
+        return None, None
+    parts = head.split(b"\r\n", 1)[0].split()
+    status = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else None
+    return status, json_body(body)
+
+
+def original_outcome(case: dict[str, Any]) -> dict[str, Any]:
+    """What the original request returned, and whether that is its expected outcome."""
+    record = mapping(case.get("original"))
+    start = case.get("start_ns")
+    if case.get("path") == "http":
+        if case.get("action") in ("close", "reset"):
+            return {"outcome": "not-read", "expected": True}
+        raw = b"".join(bytes.fromhex(str(c.get("hex", ""))) for c in items(record.get("chunks")))
+        status, body = http_reply(raw)
+        first = items(record.get("chunks"))[0].get("ns") if record.get("chunks") else None
+        body = body or {}
+        expected = status == 200 and body.get("exitCode") == -1 and body.get("timedOut") is True
+        return {
+            "outcome": "response" if status is not None else "no-response",
+            "status": status,
+            "exit_code": body.get("exitCode"),
+            "timed_out": body.get("timedOut"),
+            "error": record.get("error"),
+            "seconds": seconds(start, first),
+            "expected": expected,
+        }
+    returncode = record.get("returncode")
+    stdout = bytes.fromhex(str(record.get("stdout_hex", "")))
+    end = seconds(start, record.get("exit_ns"))
+    if case.get("action") == "term":
+        signals = [str(s.get("signal")) for s in items(record.get("signals"))]
+        after = seconds(case.get("act_ns"), record.get("exit_ns"))
+        bound = TERM_GRACE + SLACK if signals == ["SIGTERM"] else TERM_GRACE + KILL_WAIT + SLACK
+        expected = returncode in (-15, -9) and after is not None and after <= bound
+        return {
+            "outcome": "exit",
+            "returncode": returncode,
+            "signals": signals,
+            "seconds": end,
+            "exit_after_signal": after,
+            "expected": expected,
+        }
+    body = json_body(stdout) or {}
+    expected = (
+        returncode == 0
+        and body.get("ok") is True
+        and body.get("exit_code") == -1
+        and body.get("timed_out") is True
+    )
+    return {
+        "outcome": "exit",
+        "returncode": returncode,
+        "exit_code": body.get("exit_code"),
+        "timed_out": body.get("timed_out"),
+        "seconds": end,
+        "expected": expected,
+    }
+
+
+def follow_expected(record: dict[str, Any]) -> bool:
+    """Whether one follow-up request ended with its expected outcome inside its bound."""
+    if record.get("path") == "http":
+        if record.get("transport_error") or record.get("status") != 200:
+            return False
+        body = json_body(bytes.fromhex(str(record.get("body_hex", "")))) or {}
+        if record.get("kind") == "health":
+            return body.get("platform") == "macos"
+        return body.get("stdout") == ORDINARY_STDOUT and body.get("exitCode") == 0
+    if record.get("bound_exceeded") is not False:
+        return False
+    body = json_body(bytes.fromhex(str(record.get("stdout_hex", "")))) or {}
+    if record.get("kind") == "health":
+        # The host denies accessibility, so a healthy agent gives exit status 4.
+        return (
+            record.get("returncode") == 4
+            and body.get("ok") is True
+            and body.get("reachable") is True
+        )
+    return (
+        record.get("returncode") == 0
+        and body.get("stdout") == ORDINARY_STDOUT
+        and body.get("exit_code") == 0
+    )
+
+
+def host_completed_reported_timeout(record: dict[str, Any]) -> bool:
+    """An ordinary follow-up with complete output, but a deadline reply (the k12 receipt)."""
+    if record.get("kind") != "ordinary":
+        return False
+    if record.get("path") == "http":
+        if record.get("transport_error") or record.get("status") != 200:
+            return False
+        body = json_body(bytes.fromhex(str(record.get("body_hex", "")))) or {}
+        return (
+            body.get("stdout") == ORDINARY_STDOUT
+            and body.get("exitCode") == -1
+            and body.get("timedOut") is True
+        )
+    if record.get("bound_exceeded") is not False or record.get("returncode") != 0:
+        return False
+    body = json_body(bytes.fromhex(str(record.get("stdout_hex", "")))) or {}
+    return reported_timeout(body) and body.get("stdout") == ORDINARY_STDOUT
+
+
+def identity(case: dict[str, Any], role: str) -> dict[str, Any] | None:
+    for record in items(case.get("identities")):
+        if record.get("role") == role:
+            return record
+    return None
+
+
+def handler_outcome(case: dict[str, Any]) -> tuple[str, float | None]:
+    shell = identity(case, "shell")
+    if shell is None:
+        return "unknown", None
+    if shell.get("gone_reason") not in ("absent", None):
+        return "unknown", None
+    end = seconds(case.get("start_ns"), shell.get("gone_ns"))
+    if end is None:
+        return "overran", None
+    if end < GUEST_TIMEOUT - DEADLINE_EARLY:
+        return "cancelled", end
+    if end <= GUEST_TIMEOUT + DEADLINE_LATE:
+        return "deadline", end
+    return "overran", end
+
+
+def child_outcome(case: dict[str, Any]) -> tuple[str, float | None]:
+    shell, child = identity(case, "shell"), identity(case, "child")
+    if child is None or shell is None or child.get("gone_reason") not in ("absent", None):
+        return "unknown", None
+    child_end = seconds(case.get("start_ns"), child.get("gone_ns"))
+    shell_end = seconds(case.get("start_ns"), shell.get("gone_ns"))
+    if child_end is None:
+        return "survived-handler", None
+    if shell_end is not None and child_end <= shell_end + CHILD_SLACK:
+        return "ended-with-handler", child_end
+    return "survived-handler", child_end
+
+
+def follow_verdicts(
+    case: dict[str, Any], handler_end: float | None, control: dict[str, float]
+) -> list[dict[str, Any]]:
+    verdicts: list[dict[str, Any]] = []
+    start = case.get("start_ns")
+    for record in items(case.get("follow")):
+        kind = str(record.get("kind"))
+        latency = seconds(record.get("start_ns"), record.get("end_ns"))
+        answered = seconds(start, record.get("end_ns"))
+        verdict: dict[str, Any] = {
+            "kind": kind,
+            "latency": latency,
+            "answered_at": answered,
+            "control_latency": control.get(kind),
+        }
+        if host_completed_reported_timeout(record):
+            verdict["class"] = "completed-reported-timeout"
+        elif not follow_expected(record):
+            verdict["class"] = "failed"
+        elif kind not in control:
+            # The control request of this kind did not give a sound latency.
+            verdict["class"] = "unknown"
+            verdict["unknown_reason"] = "no-sound-control"
+        elif latency is None or answered is None or handler_end is None:
+            verdict["class"] = "unknown"
+        elif answered < handler_end and latency <= control[kind] + LATENCY_ALLOWANCE:
+            verdict["class"] = "responsive"
+        else:
+            verdict["class"] = "blocked"
+        verdicts.append(verdict)
+    return verdicts
+
+
+def host_check(summary: dict[str, Any], seam: dict[str, Any] | None) -> dict[str, Any]:
+    problems: list[str] = []
+    if summary.get("verdict") is not True:
+        problems.append(f"controller verdict is {summary.get('verdict')!r}")
+    if summary.get("leftovers"):
+        problems.append(f"the runner found leftovers: {summary.get('leftovers')}")
+    if summary.get("build_dir_removed") is not True:
+        problems.append("the build directory remains")
+    if seam is None:
+        problems.append("the host call printed no JSON")
+        return {"problems": problems, "cases": []}
+    if seam.get("error"):
+        problems.append(f"seam error: {seam.get('error')}")
+    for server in items(seam.get("servers")):
+        if server.get("ready") is not True:
+            problems.append(f"{server.get('role')} did not become ready")
+    for stop in items(seam.get("stops")):
+        if stop.get("state") != "terminated":
+            problems.append(f"{stop.get('role')} stop state is {stop.get('state')}")
+    if seam.get("final_sweep"):
+        problems.append(
+            f"a token process remained after the servers stopped: {seam['final_sweep']}"
+        )
+    if seam.get("root_removed") is not True:
+        problems.append("the temporary root remains")
+    cases = {str(case.get("case")): case for case in items(seam.get("cases"))}
+    missing = [case.name for case in CASES if case.name not in cases]
+    if missing:
+        problems.append(f"missing cases: {missing}")
+    controls: dict[str, dict[str, float]] = {}
+    for name in ("http-concurrent", "cli-concurrent"):
+        for record in items(cases.get(name, {}).get("follow")):
+            latency = seconds(record.get("start_ns"), record.get("end_ns"))
+            if latency is not None and follow_expected(record):
+                controls.setdefault(name.split("-")[0], {})[str(record.get("kind"))] = latency
+    verdicts: list[dict[str, Any]] = []
+    for name, case in cases.items():
+        handler, handler_end = handler_outcome(case)
+        child, child_end = child_outcome(case)
+        original = original_outcome(case)
+        control = controls.get(str(case.get("path")), {})
+        follow = follow_verdicts(case, handler_end, control)
+        verdict = {
+            "case": name,
+            "identity_error": case.get("identity_error"),
+            "handler": handler,
+            "handler_end": handler_end,
+            "child": child,
+            "child_end": child_end,
+            "original": original,
+            "follow": follow,
+            "swept": case.get("sweep", []),
+        }
+        verdicts.append(verdict)
+        if case.get("identity_error"):
+            problems.append(f"{name}: no identity ({case['identity_error']})")
+        if handler == "unknown" or child == "unknown":
+            problems.append(f"{name}: handler {handler}, child {child}")
+        if any(item["class"] == "unknown" for item in follow):
+            problems.append(f"{name}: a follow-up outcome is unknown")
+        # The controls must show the expected behaviour, or no comparison holds.
+        if name in ("http-control", "http-concurrent", "cli-concurrent"):
+            if handler != "deadline" or original["expected"] is not True:
+                problems.append(f"{name}: the control did not end at the deadline as expected")
+            # A completed reported timeout in a control is a finding. Each comparison
+            # that needs its latency becomes unknown, and that is the problem.
+            sound = ("responsive", "completed-reported-timeout")
+            if any(item["class"] not in sound for item in follow):
+                problems.append(f"{name}: a control follow-up is not responsive")
+        elif original["expected"] is not True:
+            problems.append(f"{name}: the original request has an unexpected outcome")
+        if original.get("seconds") is not None and original["seconds"] > ORIGINAL_BOUND:
+            problems.append(f"{name}: the original request exceeded {ORIGINAL_BOUND} s")
+    return {"problems": problems, "controls": controls, "cases": verdicts}
+
+
+def host_main(out: Path) -> int:
+    summary = json.loads((out / "summary.json").read_text())
+    run = Path(str(summary.get("run", "")))
+    try:
+        seam = json.loads((run / "host.stdout").read_bytes())
+    except (OSError, ValueError):
+        seam = None
+    report = host_check(summary, seam)
+    (out / "check.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    for verdict in report["cases"]:
+        follow = " ".join(f"{f['kind']}={f['class']}" for f in verdict["follow"]) or "-"
+        end = verdict["handler_end"]
+        shown = f"{end:7.3f}s" if end is not None else "      ?"
+        print(
+            f"{verdict['case']:<16} handler {verdict['handler']:<9} {shown} "
+            f"child {verdict['child']:<18} {follow}"
+        )
+    for problem in report["problems"]:
+        print(f"PROBLEM {problem}")
+    return 0 if not report["problems"] else 1
+
+
+# ---- live mode ----
+
+PARTIAL_HEX = PARTIAL.hex()
+# Each mode compares its follow-up latencies with one reference mode.
+REFERENCE = {"concurrent": "control", "term": "concurrent"}
+FOLLOW_NAMES = ("inspect", "health", "ordinary", "download", "inspect-after")
+
+
+def cli_body(record: dict[str, Any]) -> dict[str, Any]:
+    return json_body(bytes.fromhex(str(record.get("stdout_hex", "")))) or {}
+
+
+def reported_timeout(body: dict[str, Any]) -> bool:
+    """The agent reported its deadline, with exit -1, for a command."""
+    return body.get("timed_out") is True and body.get("exit_code") == -1
+
+
+def parse_inspection(record: dict[str, Any]) -> dict[str, dict[str, str]] | None:
+    """The role table of one inspection, or None when the inspection failed.
+
+    A reported timeout with a complete role table still holds a sighting. The
+    sighting happened somewhere inside the request window, and the bracket uses
+    only the ends of that window.
+    """
+    body = cli_body(record)
+    if record.get("bound_exceeded") is not False or record.get("returncode") != 0:
+        return None
+    if body.get("exit_code") != 0 and not reported_timeout(body):
+        return None
+    roles: dict[str, dict[str, str]] = {}
+    for line in str(body.get("stdout", "")).splitlines():
+        role, _, rest = line.partition(" ")
+        head, _, command = rest.partition(" command=")
+        fields = {"state": "none", "command": command}
+        for word in head.split():
+            key, sep, value = word.partition("=")
+            if sep:
+                fields[key] = value
+            else:
+                fields["state"] = word
+        roles[role] = fields
+    if set(roles) != {"shell", "child"}:
+        return None
+    shell, child = roles["shell"], roles["child"]
+    parent = child.get("ppid", "")
+    if child["state"] == "present" and parent not in ("", "1") and shell.get("pid") != parent:
+        return None  # the recorded shell is not the parent of this child
+    return roles
+
+
+def completed_reported_timeout(record: dict[str, Any]) -> bool:
+    """An exec follow-up whose output is complete, but whose reply is a deadline."""
+    name = str(record.get("name"))
+    body = cli_body(record)
+    if record.get("bound_exceeded") is not False or not reported_timeout(body):
+        return False
+    if name.startswith("inspect"):
+        return parse_inspection(record) is not None
+    return name == "ordinary" and body.get("stdout") == ORDINARY_STDOUT
+
+
+def live_follow_expected(record: dict[str, Any]) -> bool:
+    name = str(record.get("name"))
+    if record.get("bound_exceeded") is not False:
+        return False
+    if name.startswith("inspect"):
+        return parse_inspection(record) is not None and not reported_timeout(cli_body(record))
+    body = cli_body(record)
+    if name == "health":
+        return (
+            record.get("returncode") == 0
+            and body.get("ok") is True
+            and body.get("reachable") is True
+        )
+    if name == "ordinary":
+        return (
+            record.get("returncode") == 0
+            and body.get("stdout") == ORDINARY_STDOUT
+            and body.get("exit_code") == 0
+        )
+    return record.get("returncode") == 0 and record.get("local_hex") == PARTIAL_HEX
+
+
+def inspections(result: dict[str, Any]) -> list[dict[str, Any]]:
+    named = [r for r in items(result.get("follow")) if str(r.get("name")).startswith("inspect")]
+    return [*named, mapping(result.get("mid")), mapping(result.get("late"))]
+
+
+def handler_bracket(result: dict[str, Any]) -> tuple[float | None, float | None]:
+    """The latest time the shell is known alive and the earliest time it is known gone."""
+    start = result.get("start_ns")
+    lo: float | None = None
+    hi: float | None = None
+    for record in inspections(result):
+        roles = parse_inspection(record)
+        if roles is None:
+            continue
+        began = seconds(start, record.get("start_ns"))
+        ended = seconds(start, record.get("end_ns"))
+        shell, child = roles["shell"], roles["child"]
+        # The agent runs `/bin/bash -c PAYLOAD`, and only the payload names the mode directory.
+        alive = (
+            shell["state"] == "present" and guest_dir(str(result.get("mode"))) in shell["command"]
+        )
+        orphan = child["state"] == "present" and child.get("ppid") == "1"
+        gone = shell["state"] == "absent" or (shell["state"] == "none" and orphan)
+        if alive and began is not None:
+            lo = began if lo is None else max(lo, began)
+        if gone and ended is not None:
+            hi = ended if hi is None else min(hi, ended)
+    original = mapping(result.get("original"))
+    if result.get("mode") != "term" and original_live(result)["expected"]:
+        # The CLI prints the reply after the handler ends, so its exit bounds the end.
+        reply = seconds(start, original.get("exit_ns"))
+        if reply is not None:
+            hi = reply if hi is None else min(hi, reply)
+    return lo, hi
+
+
+def live_handler(result: dict[str, Any]) -> tuple[str, float | None, float | None]:
+    lo, hi = handler_bracket(result)
+    late = parse_inspection(mapping(result.get("late")))
+    if late is not None and late["shell"]["state"] == "present":
+        return "overran", lo, hi
+    if hi is None:
+        return "unknown", lo, hi
+    if hi < GUEST_TIMEOUT - DEADLINE_EARLY:
+        return "cancelled", lo, hi
+    if result.get("mode") == "control":
+        # No inspection runs before the reply in the control, so the reply alone places the end.
+        return ("deadline" if hi <= GUEST_TIMEOUT + DEADLINE_LATE else "overran"), lo, hi
+    if lo is None or lo < MID_AT - 1.0:
+        return "unknown", lo, hi
+    if lo > GUEST_TIMEOUT + DEADLINE_LATE:
+        return "overran", lo, hi
+    return "deadline", lo, hi
+
+
+def live_child(result: dict[str, Any]) -> str:
+    late = parse_inspection(mapping(result.get("late")))
+    if late is None or late["child"]["state"] in ("none", "unknown"):
+        return "unknown"
+    if late["child"]["state"] == "present" and late["child"]["command"] == "sleep 120":
+        return "survived-handler"
+    if late["child"]["state"] == "absent":
+        return "ended-with-handler"
+    return "unknown"
+
+
+def original_live(result: dict[str, Any]) -> dict[str, Any]:
+    record = mapping(result.get("original"))
+    start = result.get("start_ns")
+    returncode = record.get("returncode")
+    end = seconds(start, record.get("exit_ns"))
+    if result.get("mode") == "term":
+        signals = items(record.get("signals"))
+        names = [str(s.get("signal")) for s in signals]
+        first = signals[0].get("ns") if signals else None
+        after = seconds(first, record.get("exit_ns"))
+        bound = TERM_GRACE + SLACK if names == ["SIGTERM"] else TERM_GRACE + KILL_WAIT + SLACK
+        expected = returncode in (-15, -9) and after is not None and after <= bound
+        return {
+            "returncode": returncode,
+            "signals": names,
+            "seconds": end,
+            "exit_after_signal": after,
+            "expected": expected,
+        }
+    body = cli_body(record)
+    expected = (
+        record.get("bound_exceeded") is False
+        and returncode == 0
+        and body.get("ok") is True
+        and body.get("exit_code") == -1
+        and body.get("timed_out") is True
+    )
+    return {
+        "returncode": returncode,
+        "exit_code": body.get("exit_code"),
+        "timed_out": body.get("timed_out"),
+        "seconds": end,
+        "expected": expected,
+    }
+
+
+def live_follow(
+    result: dict[str, Any], lo: float | None, hi: float | None, reference: dict[str, float] | None
+) -> list[dict[str, Any]]:
+    verdicts: list[dict[str, Any]] = []
+    start = result.get("start_ns")
+    for record in items(result.get("follow")):
+        name = str(record.get("name"))
+        latency = seconds(record.get("start_ns"), record.get("end_ns"))
+        answered = seconds(start, record.get("end_ns"))
+        verdict: dict[str, Any] = {
+            "name": name,
+            "returncode": record.get("returncode"),
+            "bound_exceeded": record.get("bound_exceeded"),
+            "latency": latency,
+            "answered_at": answered,
+        }
+        if name == "download":
+            verdict["content_matches"] = record.get("local_hex") == PARTIAL_HEX
+        roles = parse_inspection(record) if name.startswith("inspect") else None
+        if roles is not None:
+            verdict["shell"] = roles["shell"]["state"]
+            verdict["child"] = roles["child"]["state"]
+        began = seconds(start, record.get("start_ns"))
+        # Condition 2 fails only when the request provably spans the handler end:
+        # it began no later than a sighting of the shell alive, and it answered no
+        # earlier than a sighting of the shell gone. Condition 3 bounds any other hold.
+        spanned = (
+            began is not None
+            and answered is not None
+            and lo is not None
+            and hi is not None
+            and began <= lo
+            and answered >= hi
+        )
+        verdict["spans_handler_end"] = spanned
+        if completed_reported_timeout(record):
+            verdict["class"] = "completed-reported-timeout"
+        elif not live_follow_expected(record):
+            verdict["class"] = "failed"
+        elif reference is None:
+            verdict["class"] = "baseline"
+        elif name not in reference:
+            verdict["class"] = "unknown"
+            verdict["unknown_reason"] = "no-sound-control"
+        elif latency is None:
+            verdict["class"] = "unknown"
+        else:
+            verdict["reference_latency"] = reference[name]
+            fast = latency <= reference[name] + LATENCY_ALLOWANCE
+            verdict["class"] = "blocked" if spanned or not fast else "responsive"
+        verdicts.append(verdict)
+    return verdicts
+
+
+def receipt_ok(run: Path, name: str) -> bool:
+    try:
+        return mapping(json.loads((run / f"{name}.json").read_bytes())).get("ok") is True
+    except (OSError, ValueError):
+        return False
+
+
+def chained_reference(mode: str, references: dict[str, dict[str, float]]) -> dict[str, float]:
+    """The sound latency of each request, from the nearest reference mode that has one.
+
+    The chain is `term`, then `concurrent`, then `control`. This fallback was
+    declared before the live run.
+    """
+    merged: dict[str, float] = {}
+    current = mode
+    while current in REFERENCE:
+        current = REFERENCE[current]
+        for name, latency in references.get(current, {}).items():
+            merged.setdefault(name, latency)
+    return merged
+
+
+def live_check(summary: dict[str, Any], run: Path) -> dict[str, Any]:
+    problems: list[str] = []
+    if summary.get("verdict") is not True:
+        problems.append(f"controller verdict is {summary.get('verdict')!r}")
+    for name in ("health-before", "health-after"):
+        if not receipt_ok(run, name):
+            problems.append(f"{name} did not succeed")
+    results: dict[str, dict[str, Any]] = {}
+    for mode in MODES:
+        try:
+            results[mode] = mapping(json.loads((run / f"burst-{mode}.stdout").read_bytes()))
+        except (OSError, ValueError):
+            problems.append(f"burst-{mode} printed no JSON")
+            continue
+        if not receipt_ok(run, f"burst-{mode}"):
+            problems.append(f"the burst-{mode} receipt is not ok")
+    references: dict[str, dict[str, float]] = {}
+    verdicts: list[dict[str, Any]] = []
+    for mode in MODES:
+        result = results.get(mode)
+        if result is None:
+            continue
+        handler, lo, hi = live_handler(result)
+        child = live_child(result)
+        original = original_live(result)
+        reference = chained_reference(mode, references) if mode in REFERENCE else None
+        if mode in REFERENCE and not reference:
+            problems.append(f"{mode}: the reference mode {REFERENCE[mode]} has no latencies")
+        follow = live_follow(result, lo, hi, reference)
+        references[mode] = {
+            str(f["name"]): float(f["latency"])
+            for f in follow
+            if f["class"] in ("baseline", "responsive") and f["latency"] is not None
+        }
+        verdicts.append(
+            {
+                "mode": mode,
+                "handler": handler,
+                "handler_alive_at": lo,
+                "handler_gone_by": hi,
+                "child": child,
+                "original": original,
+                "follow": follow,
+                "mid": parse_inspection(mapping(result.get("mid"))),
+                "late": parse_inspection(mapping(result.get("late"))),
+            }
+        )
+        if handler == "unknown" or child == "unknown":
+            problems.append(f"{mode}: handler {handler}, child {child}")
+        if original["expected"] is not True:
+            problems.append(f"{mode}: the original request has an unexpected outcome")
+        if any(f["class"] == "unknown" for f in follow):
+            problems.append(f"{mode}: a follow-up outcome is unknown")
+        if mode != "term":
+            # The controls must show the expected behaviour, or no comparison holds.
+            if handler != "deadline":
+                problems.append(f"{mode}: the control did not end at the deadline")
+            # A completed reported timeout is a finding, as in the host mode.
+            sound = ("baseline", "responsive", "completed-reported-timeout")
+            if any(f["class"] not in sound for f in follow):
+                problems.append(f"{mode}: a control follow-up is not as expected")
+    return {"problems": problems, "modes": verdicts}
+
+
+def live_main(out: Path) -> int:
+    summary = json.loads((out / "summary.json").read_text())
+    report = live_check(summary, Path(str(summary.get("run", ""))))
+    (out / "check.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
+    for verdict in report["modes"]:
+        follow = " ".join(f"{f['name']}={f['class']}" for f in verdict["follow"]) or "-"
+        lo, hi = verdict["handler_alive_at"], verdict["handler_gone_by"]
+        bracket = f"({'?' if lo is None else f'{lo:.2f}'}, {'?' if hi is None else f'{hi:.2f}'}]"
+        print(
+            f"{verdict['mode']:<10} handler {verdict['handler']:<9} {bracket:<15} "
+            f"child {verdict['child']:<18} {follow}"
+        )
+    for problem in report["problems"]:
+        print(f"PROBLEM {problem}")
+    return 0 if not report["problems"] else 1
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 3 or argv[1] not in ("host", "live"):
+        print(__doc__, file=sys.stderr)
+        return 64
+    if argv[1] == "host":
+        return host_main(Path(argv[2]))
+    return live_main(Path(argv[2]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
diff --git a/experiments/exec-reliability/disconnect_k13_host.py b/experiments/exec-reliability/disconnect_k13_host.py
new file mode 100644
index 0000000000..cee8e46938
--- /dev/null
+++ b/experiments/exec-reliability/disconnect_k13_host.py
@@ -0,0 +1,230 @@ def build(work: Path, out: Path) -> tuple[Path, dict[str, Any]]:
+"""Frozen macOS disconnect cases on the local host (leaf macos-disconnect-availability-k13).
+
+    disconnect_k13_host.py OUT
+
+The script builds one subject into a temporary directory outside OUT: a copy of
+`agents/macos` whose `main.swift` binds 127.0.0.1 on the port in its first
+argument. `AgentServer.swift` and `ProcessRunner.swift` stay byte-identical,
+and the script checks that. The checkout CLI and app come from
+`cli-rs/target/debug`. The Taskfile builds them first.
+
+The script freezes the cases, the bounds, the subject digests and the plan in
+OUT/inventory.json before the first case runs. Then it runs one controller plan
+once. The plan has one call: `disconnect_k13_seam.py`. No call retries.
+
+After the plan, the script audits the host for owned leftovers: any process whose
+command names the build directory or holds a sleep token of this run. It checks
+the start time and command of each match again, then kills and records it. Then
+it removes the build directory. `disconnect_k13_check.py` judges the evidence.
+This script judges nothing beyond the controller verdict.
+"""
+
+from __future__ import annotations
+
+import os
+import platform
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import uuid
+from dataclasses import asdict
+from pathlib import Path
+from typing import Any
+
+from controller import Call, Plan, execute_outcome, write_json
+from disconnect_k13_seam import (
+    ACT_AFTER,
+    CASES,
+    FOLLOW_BOUND,
+    GUEST_TIMEOUT,
+    KILL_WAIT,
+    OBSERVE_BOUND,
+    ORDINARY,
+    ORDINARY_TIMEOUT,
+    ORIGINAL_BOUND,
+    TERM_GRACE,
+    token,
+)
+from outcomes_k12 import LOOPBACK_MAIN, run_build, run_tag, sha256, tool_version
+from outcomes_k12_seam import current, processes
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+AGENT_PACKAGE = REPO / "agents/macos"
+RUNNER = AGENT_PACKAGE / "Sources/TestAnywareAgent/ProcessRunner.swift"
+SERVER = AGENT_PACKAGE / "Sources/testanyware-agent/AgentServer.swift"
+SEAM = HERE / "disconnect_k13_seam.py"
+CLI = REPO / "cli-rs/target/debug/testanyware"
+APP = REPO / "cli-rs/target/debug/testanyware-app"
+LOCKFILES = (REPO / "cli-rs/Cargo.lock", AGENT_PACKAGE / "Package.resolved", HERE / "uv.lock")
+
+# Seven cases, each at most OBSERVE_BOUND + ORIGINAL_BOUND seconds, plus server starts.
+SEAM_BUDGET = 900.0
+
+
+def build(work: Path, out: Path) -> tuple[Path, dict[str, Any]]:
+    copy = work / "agent"
+    subprocess.run(
+        [
+            "/usr/bin/rsync",
+            "-a",
+            "--exclude",
+            ".build",
+            "--exclude",
+            "Tests",
+            f"{AGENT_PACKAGE}/",
+            f"{copy}/",
+        ],
+        check=True,
+        timeout=60,
+    )
+    (copy / "Sources/testanyware-agent/main.swift").write_text(LOOPBACK_MAIN)
+    manifest = copy / "Package.swift"
+    text = manifest.read_text()
+    pruned = re.sub(r"\n        \.testTarget\(.*?\n        \),", "", text, count=1, flags=re.DOTALL)
+    if pruned == text:
+        raise SystemExit("the agent manifest has no test target to remove")
+    manifest.write_text(pruned)
+    for original, copied in (
+        (RUNNER, copy / "Sources/TestAnywareAgent/ProcessRunner.swift"),
+        (SERVER, copy / "Sources/testanyware-agent/AgentServer.swift"),
+    ):
+        if original.read_bytes() != copied.read_bytes():
+            raise SystemExit(f"the agent copy changed {original.name}")
+    argv = [
+        "/usr/bin/swift",
+        "build",
+        "--package-path",
+        str(copy),
+        "--product",
+        "testanyware-agent",
+    ]
+    record = run_build("agent", argv, out)
+    agent = copy / ".build/debug/testanyware-agent"
+    record["binary_sha256"] = sha256(agent)
+    record["manifest_sha256"] = sha256(manifest)
+    record["main_sha256"] = sha256(copy / "Sources/testanyware-agent/main.swift")
+    return agent, record
+
+
+def audit(work: Path, tag: str | None) -> list[dict[str, Any]]:
+    """Record and kill each owned leftover: the build directory or a token of this run."""
+    needles = [str(work), *(token(case, tag) for case in CASES)] if tag else [str(work)]
+    found: list[dict[str, Any]] = []
+    for pid, start, command in processes():
+        if pid == os.getpid() or not any(needle in command for needle in needles):
+            continue
+        if current(pid) != (start, command):
+            found.append({"pid": pid, "start": start, "command": command, "killed": False})
+            continue
+        try:
+            os.kill(pid, signal.SIGKILL)
+            killed = True
+        except ProcessLookupError:
+            killed = False
+        found.append({"pid": pid, "start": start, "command": command, "killed": killed})
+    return found
+
+
+def plan(python: str, agent: Path) -> Plan:
+    run_id = uuid.uuid4().hex
+    argv = (python, "-E", "-s", str(SEAM), run_tag(run_id), str(agent), str(APP), str(CLI))
+    subjects = (
+        Path(__file__),
+        SEAM,
+        HERE / "controller.py",
+        HERE / "outcomes_k12.py",
+        HERE / "outcomes_k12_seam.py",
+        HERE / "disconnect_k13_check.py",
+        RUNNER,
+        SERVER,
+        CLI,
+        APP,
+        agent,
+        *(path for path in LOCKFILES if path.exists()),
+    )
+    return Plan(run_id, (Call("host", argv, SEAM_BUDGET),), subjects=subjects)
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: disconnect_k13_host.py OUT")
+    out = Path(sys.argv[1]).resolve()
+    for path in (CLI, APP):
+        if not path.exists():
+            raise SystemExit(f"unavailable prerequisite: {path} (run task cli:build app:build)")
+    out.mkdir(parents=True, exist_ok=False)
+    work = Path(tempfile.mkdtemp(prefix="k13-build-"))
+    summary: dict[str, Any] = {"build_dir": str(work)}
+    tag: str | None = None
+    try:
+        agent, built = build(work, out)
+        frozen = plan(sys.executable, agent)
+        tag = run_tag(frozen.run_id)
+        write_json(
+            out / "inventory.json",
+            {
+                "leaf": "macos-disconnect-availability-k13",
+                "rule": "one plan, run once; no retry; failed samples stay",
+                "host": {
+                    "sw_vers": tool_version(["/usr/bin/sw_vers"]),
+                    "machine": platform.machine(),
+                    "kernel": platform.release(),
+                },
+                "run_tag": tag,
+                "commit": tool_version(["/usr/bin/git", "-C", str(REPO), "rev-parse", "HEAD"]),
+                "tools": {
+                    "swift": tool_version(["/usr/bin/swift", "--version"]),
+                    "cargo": tool_version(["cargo", "--version"]),
+                    "python": sys.version,
+                },
+                "lockfiles": {
+                    str(path.relative_to(REPO)): sha256(path) for path in LOCKFILES if path.exists()
+                },
+                "sources": {
+                    str(path.relative_to(REPO)): sha256(path)
+                    for path in (RUNNER, SERVER, SEAM, Path(__file__).resolve())
+                },
+                "executables": {
+                    "cli": {"path": str(CLI), "sha256": sha256(CLI)},
+                    "app": {"path": str(APP), "sha256": sha256(APP)},
+                },
+                "build": built,
+                "bounds": {
+                    "guest_timeout": GUEST_TIMEOUT,
+                    "act_after": ACT_AFTER,
+                    "follow_bound": FOLLOW_BOUND,
+                    "ordinary_timeout": ORDINARY_TIMEOUT,
+                    "term_grace": TERM_GRACE,
+                    "kill_wait": KILL_WAIT,
+                    "observe_bound": OBSERVE_BOUND,
+                    "original_bound": ORIGINAL_BOUND,
+                    "seam_budget": SEAM_BUDGET,
+                },
+                "ordinary": ORDINARY,
+                "cases": [asdict(case) | {"token": token(case, tag)} for case in CASES],
+                "plan": asdict(frozen),
+            },
+        )
+        outcome = execute_outcome(frozen, out)
+        summary.update(
+            verdict=outcome.verdict,
+            run=str(outcome.run_dir),
+            ledger=outcome.ledger,
+            residuals=outcome.residuals,
+        )
+    finally:
+        summary["leftovers"] = audit(work, tag)
+        shutil.rmtree(work, ignore_errors=True)
+        summary["build_dir_removed"] = not work.exists()
+        write_json(out / "summary.json", summary)
+    print(f"verdict {summary.get('verdict')} run {summary.get('run')}", flush=True)
+    if summary.get("verdict") is not True or summary["leftovers"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/exec-reliability/disconnect_k13_run.sh b/experiments/exec-reliability/disconnect_k13_run.sh
new file mode 100755
index 0000000000..6dcf763a0c
--- /dev/null
+++ b/experiments/exec-reliability/disconnect_k13_run.sh
@@ -0,0 +1,63 @@
+#!/bin/sh
+# One k13 disconnect-availability run (leaf macos-disconnect-availability-k13).
+# Usage: disconnect_k13_run.sh host|live OUT
+# host: the deterministic HTTP and client controls on a loopback copy of the
+#   checkout agent. The run builds the copy, so it needs no VM.
+# live: the control, concurrent and term modes on one fresh unchanged macOS clone.
+# The outer records are read only. tooling-before.sha256 is taken before the probe.
+# tooling-after.sha256 is taken after the check. The script exits 0 only when the
+# probe exits 0 with verdict True, the check exits 0 and the two digest lists are equal.
+# A finding, such as a blocked channel, is a measured outcome. It does not change
+# the exit status. An unknown outcome does.
+set -u
+MODE=${1:-}
+OUT=${2:-}
+case "$MODE" in host | live) ;; *) echo "usage: disconnect_k13_run.sh host|live OUT" >&2; exit 64 ;; esac
+test -n "$OUT" || { echo "usage: disconnect_k13_run.sh host|live OUT" >&2; exit 64; }
+test ! -e "$OUT" && test ! -e "$OUT-outer" || { echo "refusing an existing OUT: $OUT" >&2; exit 2; }
+HERE=experiments/exec-reliability
+TOOLS="$HERE/disconnect_k13_run.sh $HERE/disconnect_k13.py $HERE/disconnect_k13_burst.py
+$HERE/disconnect_k13_host.py $HERE/disconnect_k13_seam.py $HERE/disconnect_k13_check.py
+$HERE/outcomes_k12.py $HERE/outcomes_k12_seam.py $HERE/timeout_k4.py $HERE/routes_k19.py
+$HERE/controller.py $HERE/pyproject.toml $HERE/uv.lock scripts/vm_inventory.py Taskfile.yml"
+if test "$MODE" = host; then
+  PROBE=$HERE/disconnect_k13_host.py
+  TOOLS="$TOOLS cli-rs/target/debug/testanyware cli-rs/target/debug/testanyware-app"
+else
+  PROBE=$HERE/disconnect_k13.py
+fi
+mkdir -p "$OUT-outer"
+echo "$MODE" > "$OUT-outer/mode"
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-before.sha256"
+jj log -r @- --no-graph -T 'commit_id ++ "\n"' > "$OUT-outer/source-commit"
+jj diff --git > "$OUT-outer/source-dirty.diff"
+testanyware --version > "$OUT-outer/cli-version" 2>&1
+codesign -dv --verbose=4 /Applications/TestAnyware.app > "$OUT-outer/app-codesign" 2>&1
+shasum -a 256 /opt/homebrew/opt/testanyware/share/testanyware/agents/macos/testanyware-agent > "$OUT-outer/bundle-agent.sha256"
+sysctl hw.ncpu hw.activecpu kern.wq_max_threads kern.wq_max_constrained_threads > "$OUT-outer/host-sysctl"
+tart list --format json > "$OUT-outer/tart-before.json"
+testanyware vm list --json --all > "$OUT-outer/vm-before.json"
+pgrep -x testanyware-app > "$OUT-outer/app-pid-before" || echo none > "$OUT-outer/app-pid-before"
+uv run --project "$HERE" --locked python "$PROBE" "$OUT" > "$OUT-outer/probe.stdout" 2> "$OUT-outer/probe.stderr"
+echo $? > "$OUT-outer/probe.exit"
+tart list --format json > "$OUT-outer/tart-after.json"
+testanyware vm list --json --all > "$OUT-outer/vm-after.json"
+pgrep -x testanyware-app > "$OUT-outer/app-pid-after" || echo none > "$OUT-outer/app-pid-after"
+if test -f "$OUT/summary.json"; then
+  uv run --project "$HERE" --locked python "$HERE/disconnect_k13_check.py" "$MODE" "$OUT" > "$OUT-outer/check.stdout"
+  echo $? > "$OUT-outer/check.exit"
+else
+  echo "no summary in OUT" > "$OUT-outer/check.exit"
+fi
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-after.sha256"
+cat "$OUT-outer/probe.stdout" "$OUT-outer/probe.exit"
+test -f "$OUT-outer/check.stdout" && cat "$OUT-outer/check.stdout"
+STATUS=0
+test "$(cat "$OUT-outer/probe.exit")" = 0 || { echo "probe exit $(cat "$OUT-outer/probe.exit")" >&2; STATUS=1; }
+grep -q '^verdict True run ' "$OUT-outer/probe.stdout" || { echo "probe verdict is not True" >&2; STATUS=1; }
+test "$(cat "$OUT-outer/check.exit")" = 0 || { echo "check exit $(cat "$OUT-outer/check.exit")" >&2; STATUS=1; }
+cmp -s "$OUT-outer/tooling-before.sha256" "$OUT-outer/tooling-after.sha256" || { echo "tool digests changed during the run" >&2; STATUS=1; }
+echo "$STATUS" > "$OUT-outer/run.exit"
+exit "$STATUS"
diff --git a/experiments/exec-reliability/disconnect_k13_seam.py b/experiments/exec-reliability/disconnect_k13_seam.py
new file mode 100644
index 0000000000..53a659fa21
--- /dev/null
+++ b/experiments/exec-reliability/disconnect_k13_seam.py
@@ -0,0 +1,585 @@ class Case:
+"""Run the k13 host disconnect cases against a loopback agent and print the raw evidence.
+
+Usage:
+  disconnect_k13_seam.py RUN AGENT APP CLI
+
+RUN is the run tag: 12 decimal digits that the runner derives from its run ID.
+AGENT is a loopback build of the unchanged agent. APP and CLI are checkout builds.
+
+The script prints one JSON object on stdout. Bytes are hex. The script judges
+nothing. `disconnect_k13_check.py` judges the object.
+
+Each case sends the issue #14 fork/wait shape with a guest timeout of 20 s. The
+agent runs that shell on this host, so the script sees the shell and its child
+in the process table. The shell exits when the handler kills it at the deadline,
+so the exit of the shell marks the end of the original handler.
+
+- `http-control` reads the response on the open connection.
+- `http-concurrent` also sends a health request and an ordinary exec at 2 s.
+- `http-close` closes the connection at 2 s and then sends the two requests.
+- `http-reset` resets the connection at 2 s and then sends the two requests.
+- `http-half-close` shuts down only the write half at 2 s, sends the two
+  requests and keeps reading the original connection.
+- `cli-concurrent` sends the command through the CLI and a test-mode app. It
+  sends the CLI health and ordinary exec at 2 s without an interruption.
+- `cli-term` sends TERM to the command CLI at 2 s, waits at most 2 s, then
+  sends KILL and waits at most 2 s. It then sends the two CLI requests.
+
+The sleep of each case is `120.<digit>` seconds followed by the run tag, for
+example `sleep 120.3004718293846`. The token is unique to one run, so it names
+a process of this run. After each case, the script kills each process whose
+command holds the token, after it checks the start time and the command again.
+"""
+
+from __future__ import annotations
+
+import http.client
+import json
+import os
+import re
+import select
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from outcomes_k12_seam import (
+    Owned,
+    free_port,
+    now_ns,
+    processes,
+    tcp_connect,
+    unix_connect,
+    wait_connect,
+    write_spec,
+)
+
+GUEST_TIMEOUT = 20  # the issue #14 guest timeout
+ACT_AFTER = 2.0  # the interruption, or the concurrent requests, happen at this time
+FOLLOW_BOUND = 30.0  # the ordinary bound of one follow-up request
+ORDINARY_TIMEOUT = 10  # the guest timeout of the ordinary follow-up exec
+TERM_GRACE = 2.0  # the faithful TERM grace of the command CLI
+KILL_WAIT = 2.0  # the faithful kill and reap bound of the command CLI
+OBSERVE_BOUND = 35.0  # deadline 20 s + terminate wait 3 s + 12 s of margin
+ORIGINAL_BOUND = GUEST_TIMEOUT + 20.0  # the raw host exec ceiling
+PIDFILE_BOUND = 5.0  # the shell writes the child PID file within this
+POLL = 0.05
+ORDINARY = "printf ordinary-ok"
+RUN_TAG = re.compile(r"^[0-9]{12}$")
+
+
+@dataclass(frozen=True)
+class Case:
+    name: str
+    digit: int
+    path: str  # "http" or "cli"
+    action: str  # "none", "concurrent", "close", "reset", "half-close", "term"
+
+
+CASES = (
+    Case("http-control", 1, "http", "none"),
+    Case("http-concurrent", 2, "http", "concurrent"),
+    Case("http-close", 3, "http", "close"),
+    Case("http-reset", 4, "http", "reset"),
+    Case("http-half-close", 5, "http", "half-close"),
+    Case("cli-concurrent", 6, "cli", "concurrent"),
+    Case("cli-term", 7, "cli", "term"),
+)
+
+
+def token(case: Case, tag: str) -> str:
+    return f"120.{case.digit}{tag}"
+
+
+def payload(case: Case, tag: str, directory: Path) -> str:
+    """The issue #14 fork/wait shape, with a run token and a private directory."""
+    return "\n".join(
+        (
+            f"mkdir -p {directory}",
+            f"sleep {token(case, tag)} & child=$!",
+            f"printf '%s\\n' \"$child\" > {directory}/child.pid",
+            f"printf 'partial\\n' > {directory}/partial",
+            "wait",
+        )
+    )
+
+
+# ---- process observation ----
+
+
+def row(pid: int) -> dict[str, Any] | None:
+    """The parent PID, start time and command of one process, or None when it is gone."""
+    listing = subprocess.run(
+        ["/bin/ps", "-p", str(pid), "-o", "ppid=,lstart=,command="],
+        capture_output=True,
+        text=True,
+        timeout=10,
+        check=False,
+    ).stdout.strip()
+    parts = listing.split(None, 6)
+    if len(parts) < 7 or not parts[0].isdigit():
+        return None
+    return {"ppid": int(parts[0]), "start": " ".join(parts[1:6]), "command": parts[6]}
+
+
+class Watch:
+    """The first and last sight of one process identity, polled on one clock."""
+
+    def __init__(self, role: str, pid: int, seen: dict[str, Any]) -> None:
+        self.role = role
+        self.pid = pid
+        self.start: str = seen["start"]
+        self.command: str = seen["command"]
+        self.ppid: int = seen["ppid"]
+        self.first_ns = now_ns()
+        self.last_seen_ns = self.first_ns
+        self.gone_ns: int | None = None
+        self.gone_reason: str | None = None
+
+    def poll(self) -> None:
+        if self.gone_ns is not None:
+            return
+        seen = row(self.pid)
+        stamp = now_ns()
+        if seen is None:
+            self.gone_ns, self.gone_reason = stamp, "absent"
+        elif (seen["start"], seen["command"]) != (self.start, self.command):
+            self.gone_ns, self.gone_reason = stamp, "pid-reused"
+        else:
+            self.last_seen_ns = stamp
+
+    def record(self) -> dict[str, Any]:
+        return {
+            "role": self.role,
+            "pid": self.pid,
+            "ppid": self.ppid,
+            "start": self.start,
+            "command": self.command,
+            "first_ns": self.first_ns,
+            "last_seen_ns": self.last_seen_ns,
+            "gone_ns": self.gone_ns,
+            "gone_reason": self.gone_reason,
+        }
+
+
+def find_identities(directory: Path, deadline_ns: int) -> dict[str, Any]:
+    """Read the child PID file, then record the child and its parent shell."""
+    pidfile = directory / "child.pid"
+    while now_ns() < deadline_ns:
+        try:
+            text = pidfile.read_text()
+        except FileNotFoundError:
+            time.sleep(POLL)
+            continue
+        if text.endswith("\n") and text.strip().isdigit():
+            child_pid = int(text)
+            child = row(child_pid)
+            if child is None:
+                return {"error": f"child {child_pid} gone before the first sight"}
+            shell = row(child["ppid"])
+            if shell is None:
+                return {"error": f"shell {child['ppid']} gone before the first sight"}
+            return {
+                "child": Watch("child", child_pid, child),
+                "shell": Watch("shell", child["ppid"], shell),
+            }
+        time.sleep(POLL)
+    return {"error": "no child PID file within the bound"}
+
+
+def sweep(needle: str) -> list[dict[str, Any]]:
+    """Record and kill each process whose command holds this run's token."""
+    found: list[dict[str, Any]] = []
+    for pid, start, command in processes():
+        if needle not in command or pid == os.getpid():
+            continue
+        seen = row(pid)
+        if seen is None or (seen["start"], seen["command"]) != (start, command):
+            found.append({"pid": pid, "start": start, "command": command, "killed": False})
+            continue
+        try:
+            os.kill(pid, signal.SIGKILL)
+            killed = True
+        except ProcessLookupError:
+            killed = False
+        found.append({"pid": pid, "start": start, "command": command, "killed": killed})
+    return found
+
+
+# ---- the original request ----
+
+
+class RawExec:
+    """One exec request on a socket that the case can close, reset or half-close."""
+
+    def __init__(self, port: int, command: str) -> None:
+        body = json.dumps({"command": command, "timeout": GUEST_TIMEOUT}).encode()
+        head = (
+            "POST /exec HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\n"
+            f"Content-Length: {len(body)}\r\nConnection: close\r\n\r\n"
+        ).encode()
+        self.request = head + body
+        self.sock = socket.create_connection(("127.0.0.1", port), timeout=5)
+        self.chunks: list[tuple[int, str]] = []
+        self.eof_ns: int | None = None
+        self.error: str | None = None
+        self.error_ns: int | None = None
+        self.reader: threading.Thread | None = None
+
+    def send(self) -> int:
+        self.sock.sendall(self.request)
+        return now_ns()
+
+    def read(self, deadline_ns: int) -> None:
+        """Read until EOF, an error or the deadline. Each chunk keeps its arrival time."""
+        try:
+            while now_ns() < deadline_ns:
+                left = (deadline_ns - now_ns()) / 1e9
+                ready, _, _ = select.select([self.sock], [], [], max(0.0, min(left, 0.5)))
+                if not ready:
+                    continue
+                data = self.sock.recv(65536)
+                if not data:
+                    self.eof_ns = now_ns()
+                    return
+                self.chunks.append((now_ns(), data.hex()))
+        except OSError as error:
+            self.error = f"{type(error).__name__}: {error}"
+            self.error_ns = now_ns()
+
+    def start_reader(self, deadline_ns: int) -> None:
+        self.reader = threading.Thread(target=self.read, args=(deadline_ns,), daemon=True)
+        self.reader.start()
+
+    def record(self) -> dict[str, Any]:
+        return {
+            "request_hex": self.request.hex(),
+            "chunks": [{"ns": ns, "hex": data} for ns, data in self.chunks],
+            "eof_ns": self.eof_ns,
+            "error": self.error,
+            "error_ns": self.error_ns,
+        }
+
+
+class CliExec:
+    """One command CLI, its streams drained by threads, its signals recorded."""
+
+    def __init__(self, cli: str, env: dict[str, str], command: str) -> None:
+        self.argv = [
+            cli,
+            "file",
+            "exec",
+            "--vm",
+            "normal",
+            "--timeout",
+            str(GUEST_TIMEOUT),
+            "--json",
+            command,
+        ]
+        self.child = subprocess.Popen(  # noqa: S603 - the checkout CLI
+            self.argv,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=env,
+            start_new_session=True,
+        )
+        self.start_ns = now_ns()
+        self.out: dict[str, bytes] = {"stdout": b"", "stderr": b""}
+        self.eof_ns: dict[str, int | None] = {"stdout": None, "stderr": None}
+        self.signals: list[dict[str, Any]] = []
+        self.exit_ns: int | None = None
+        self.status: int | None = None
+        self.threads = [
+            threading.Thread(target=self.drain, args=(name,), daemon=True)
+            for name in ("stdout", "stderr")
+        ]
+        for thread in self.threads:
+            thread.start()
+
+    def drain(self, name: str) -> None:
+        stream = self.child.stdout if name == "stdout" else self.child.stderr
+        assert stream is not None
+        while True:
+            data = os.read(stream.fileno(), 65536)
+            if not data:
+                self.eof_ns[name] = now_ns()
+                return
+            self.out[name] += data
+
+    def wait(self, seconds: float) -> bool:
+        deadline = time.monotonic() + seconds
+        while time.monotonic() < deadline:
+            pid, status = os.waitpid(self.child.pid, os.WNOHANG)
+            if pid:
+                self.exit_ns = now_ns()
+                self.status = status
+                self.child.returncode = os.waitstatus_to_exitcode(status)
+                return True
+            time.sleep(0.005)
+        return False
+
+    def signal(self, sig: signal.Signals) -> None:
+        try:
+            os.kill(self.child.pid, sig)  # only the CLI PID, never its group
+            result = "sent"
+        except ProcessLookupError:
+            result = "ProcessLookupError"
+        self.signals.append({"signal": sig.name, "ns": now_ns(), "result": result})
+
+    def interrupt(self) -> None:
+        self.signal(signal.SIGTERM)
+        if self.wait(TERM_GRACE):
+            return
+        self.signal(signal.SIGKILL)
+        self.wait(KILL_WAIT)
+
+    def finish(self, seconds: float) -> None:
+        if self.exit_ns is None and not self.wait(seconds):
+            self.signal(signal.SIGKILL)
+            self.wait(KILL_WAIT)
+        for thread in self.threads:
+            thread.join(timeout=1.0)
+
+    def record(self) -> dict[str, Any]:
+        return {
+            "argv": self.argv,
+            "pid": self.child.pid,
+            "start_ns": self.start_ns,
+            "signals": self.signals,
+            "exit_ns": self.exit_ns,
+            "wait_status": self.status,
+            "returncode": self.child.returncode if self.exit_ns is not None else None,
+            "stdout_hex": self.out["stdout"].hex(),
+            "stderr_hex": self.out["stderr"].hex(),
+            "stdout_eof_ns": self.eof_ns["stdout"],
+            "stderr_eof_ns": self.eof_ns["stderr"],
+        }
+
+
+# ---- follow-up requests ----
+
+
+def http_follow(port: int, kind: str) -> dict[str, Any]:
+    record: dict[str, Any] = {"kind": kind, "path": "http", "start_ns": now_ns()}
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=FOLLOW_BOUND)
+    try:
+        if kind == "health":
+            connection.request("GET", "/health")
+        else:
+            body = json.dumps({"command": ORDINARY, "timeout": ORDINARY_TIMEOUT}).encode()
+            record["request_hex"] = body.hex()
+            connection.request(
+                "POST", "/exec", body=body, headers={"Content-Type": "application/json"}
+            )
+        response = connection.getresponse()
+        record["status"] = response.status
+        record["body_hex"] = response.read().hex()
+    except OSError as error:
+        record["transport_error"] = f"{type(error).__name__}: {error}"
+    finally:
+        connection.close()
+    record["end_ns"] = now_ns()
+    return record
+
+
+def cli_follow(cli: str, env: dict[str, str], kind: str) -> dict[str, Any]:
+    if kind == "health":
+        argv = [cli, "agent", "health", "--vm", "normal", "--json"]
+    else:
+        timeout = str(ORDINARY_TIMEOUT)
+        argv = [cli, "file", "exec", "--vm", "normal", "--timeout", timeout, "--json", ORDINARY]
+    record: dict[str, Any] = {"kind": kind, "path": "cli", "argv": argv, "start_ns": now_ns()}
+    child = subprocess.Popen(  # noqa: S603 - the checkout CLI
+        argv,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=env,
+        start_new_session=True,
+    )
+    try:
+        stdout, stderr = child.communicate(timeout=FOLLOW_BOUND)
+        record["bound_exceeded"] = False
+    except subprocess.TimeoutExpired:
+        os.killpg(child.pid, signal.SIGKILL)
+        stdout, stderr = child.communicate()
+        record["bound_exceeded"] = True
+    record["end_ns"] = now_ns()
+    record["returncode"] = child.returncode
+    record["stdout_hex"] = stdout.hex()
+    record["stderr_hex"] = stderr.hex()
+    return record
+
+
+# ---- one case ----
+
+
+def abort(raw: RawExec, how: str) -> None:
+    if how == "reset":
+        raw.sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+    if how == "half-close":
+        raw.sock.shutdown(socket.SHUT_WR)
+    else:
+        raw.sock.close()
+
+
+def run_case(
+    case: Case, tag: str, root: Path, port: int, cli: str, env: dict[str, str]
+) -> dict[str, Any]:
+    directory = root / f"c{case.digit}"
+    command = payload(case, tag, directory)
+    record: dict[str, Any] = {
+        "case": case.name,
+        "path": case.path,
+        "action": case.action,
+        "token": token(case, tag),
+        "command": command,
+    }
+    raw: RawExec | None = None
+    cli_exec: CliExec | None = None
+    if case.path == "http":
+        raw = RawExec(port, command)
+        start_ns = raw.send()
+        if case.action in ("none", "concurrent", "half-close"):
+            raw.start_reader(start_ns + int(ORIGINAL_BOUND * 1e9))
+    else:
+        cli_exec = CliExec(cli, env, command)
+        start_ns = cli_exec.start_ns
+    record["start_ns"] = start_ns
+    found = find_identities(directory, start_ns + int(PIDFILE_BOUND * 1e9))
+    watches = [found[k] for k in ("shell", "child") if k in found]
+    if "error" in found:
+        record["identity_error"] = found["error"]
+    act_ns = start_ns + int(ACT_AFTER * 1e9)
+    while now_ns() < act_ns:
+        for watch in watches:
+            watch.poll()
+        time.sleep(POLL)
+    record["act_ns"] = now_ns()
+    if raw is not None and case.action in ("close", "reset", "half-close"):
+        abort(raw, case.action)
+    if cli_exec is not None and case.action == "term":
+        cli_exec.interrupt()
+    record["act_done_ns"] = now_ns()
+    follow: list[dict[str, Any]] = []
+    if case.action != "none":
+        for kind in ("health", "ordinary"):
+            follow.append(
+                http_follow(port, kind) if case.path == "http" else cli_follow(cli, env, kind)
+            )
+            for watch in watches:
+                watch.poll()
+    record["follow"] = follow
+    observe_ns = start_ns + int(OBSERVE_BOUND * 1e9)
+    while now_ns() < observe_ns:
+        for watch in watches:
+            watch.poll()
+        if all(watch.gone_ns is not None for watch in watches):
+            break
+        time.sleep(POLL)
+    record["identities"] = [watch.record() for watch in watches]
+    if raw is not None:
+        if raw.reader is not None:
+            raw.reader.join(timeout=max(0.0, (start_ns + ORIGINAL_BOUND * 1e9 - now_ns()) / 1e9))
+        if case.action not in ("close", "reset"):
+            raw.sock.close()
+        record["original"] = raw.record()
+    if cli_exec is not None:
+        cli_exec.finish(max(0.0, (start_ns + ORIGINAL_BOUND * 1e9 - now_ns()) / 1e9))
+        record["original"] = cli_exec.record()
+    record["sweep"] = sweep(token(case, tag))
+    record["end_ns"] = now_ns()
+    return record
+
+
+def seam(tag: str, agent: str, app: str, cli: str) -> dict[str, Any]:
+    result: dict[str, Any] = {"seam": "k13-host", "tag": tag, "servers": [], "stops": []}
+    owned: list[Owned] = []
+    root = Path(tempfile.mkdtemp(prefix="k13", dir="/tmp"))  # a socket path has 103 bytes at most
+    result["root"] = str(root)
+    try:
+        state = root / "xdg-state" / "testanyware"
+        data = root / "xdg-data" / "testanyware"
+        tools, tmp, run = root / "tools", root / "tmp", root / "run"
+        for directory in (state / "vms", data, tools, tmp, run):
+            directory.mkdir(parents=True)
+        run.chmod(0o700)
+        sock = run / "testanyware.sock"
+        port = free_port()
+        base = {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}
+        app_argv = [
+            app,
+            "--test-mode",
+            "--socket",
+            str(sock),
+            "--state-dir",
+            str(state),
+            "--data-dir",
+            str(data),
+            "--tool-dir",
+            str(tools),
+        ]
+        for role, argv, env, connect in (
+            ("agent", [agent, str(port)], base, tcp_connect(port)),
+            ("app", app_argv, {**base, "TMPDIR": str(tmp)}, unix_connect(sock)),
+        ):
+            server = Owned(role, argv, env)
+            owned.append(server)
+            ready = wait_connect(connect, server.child)
+            result["servers"].append(
+                {
+                    "role": role,
+                    "argv": argv,
+                    "pid": server.child.pid,
+                    "start": server.start,
+                    "ready": ready,
+                }
+            )
+            if not ready:
+                result["error"] = f"{role} did not accept a connection"
+                return result
+        write_spec(state, "normal", port)
+        cli_env = {
+            **base,
+            "HOME": str(root),
+            "TMPDIR": str(tmp),
+            "XDG_STATE_HOME": str(root / "xdg-state"),
+            "XDG_DATA_HOME": str(root / "xdg-data"),
+            "TESTANYWARE_APP_SOCKET": str(sock),
+        }
+        result["cases"] = [run_case(case, tag, root, port, cli, cli_env) for case in CASES]
+        return result
+    finally:
+        for server in reversed(owned):
+            result["stops"].append(server.stop())
+        result["final_sweep"] = [entry for case in CASES for entry in sweep(token(case, tag))]
+        for path in sorted(root.rglob("*"), reverse=True):
+            if path.is_dir() and not path.is_symlink():
+                if not any(path.iterdir()):
+                    path.rmdir()
+            else:
+                path.unlink()
+        if root.exists() and not any(root.iterdir()):
+            root.rmdir()
+        result["root_removed"] = not root.exists()
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 5 or not RUN_TAG.match(argv[1]):
+        print(__doc__, file=sys.stderr)
+        return 64
+    result = seam(argv[1], argv[2], argv[3], argv[4])
+    sys.stdout.write(json.dumps(result, sort_keys=True) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
