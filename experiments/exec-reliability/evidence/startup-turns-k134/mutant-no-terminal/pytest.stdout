        original_run = worker_capture.run_turns
        original_read = os.read
        reads = []
        observations = []
        captured = []
    
        def read(fd, size):
            if fd == worker.control:
                reads.append(size)
                return original_read(fd, min(fragment, size))
            return original_read(fd, size)
    
