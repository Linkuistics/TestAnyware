                        cleanup.callback(signal.signal, signal.SIGCHLD, old_handler)
                    elif mutation == "native-auto-reap":
                        cleanup.enter_context(native_auto_reap(0x0020))
                    elif mutation == "observation-error":
    
                        def unavailable():
