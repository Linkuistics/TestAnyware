                    finally:
                        queue.close()
                else:
                    worker_capture._signal(
                        owner, signal.SIGKILL if mode == "retiring-kill" else signal.SIGTERM
                    )
                prior_deadline = time.monotonic() + (0 if mode == "expired" else 0.4)
                owner.shutdown_deadline_monotonic = prior_deadline
