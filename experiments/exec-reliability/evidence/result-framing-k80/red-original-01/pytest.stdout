                    "boolean-pid": {"pid": True, "created_monotonic": now},
                    "string-pid": {"pid": "123", "created_monotonic": now},
                    "pid-without-created": {"pid": os.getpid()},
                    "created-without-pid": {"created_monotonic": now},
