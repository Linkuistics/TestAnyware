                        "created_monotonic": now,
                        "kill_monotonic": finished,
                        "reaped": True,
                        "reaped_monotonic": now,
                    },
                    "kill-without-create": {"kill_monotonic": now},
                    "reaped-without-stamp": {"reaped": True},
                    "stamp-without-reaped": {
