            encoded = {**raw, "stdout": body.stdout.hex(), "stderr": body.stderr.hex()}
            witness.write_text(json.dumps({"mode": mode, "synthetic_helper": True, "body": encoded}))
            return body
    
        monkeypatch.setattr(inspection, "capture_helper", synthetic_capture)
