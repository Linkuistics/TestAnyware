diff --git a/agents/linux/tests/http_agent.py b/agents/linux/tests/http_agent.py
new file mode 100644
index 0000000000..2592cdb40f
--- /dev/null
+++ b/agents/linux/tests/http_agent.py
@@ -0,0 +1,187 @@ def free_port() -> int:
+"""Reach a Linux agent over raw HTTP, in this process or as its own process.
+
+The responsiveness, cancellation, shutdown and download controls use the
+transport seam: real sockets and the real request handler. `AgentProcess`
+starts `python3 -m testanyware_agent` through its `main` entry, so a control
+that uses it runs unchanged against an older agent checkout. `raw_exchange`
+reads every byte until the agent closes the connection, so it sees bytes past
+the declared `Content-Length`.
+"""
+
+from __future__ import annotations
+
+import http.client
+import json
+import os
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+from collections.abc import Iterator
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+AGENT_ROOT = Path(__file__).resolve().parent.parent
+
+# The launcher installs the AT-SPI stand-ins of tests/agent_server.py, applies
+# an optional seam module, and then runs the unchanged entry point.
+LAUNCHER = """
+import importlib, sys
+sys.path.insert(0, sys.argv[1])
+from tests.agent_server import agent_request_handler
+agent_request_handler()
+if sys.argv[3]:
+    importlib.import_module(sys.argv[3])
+from testanyware_agent.__main__ import main
+sys.argv = ["testanyware_agent", "--port", sys.argv[2]]
+main()
+"""
+
+
+def free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return int(s.getsockname()[1])
+
+
+@dataclass
+class RawReply:
+    status: int
+    headers: dict[str, str]
+    body: bytes  # the bytes up to the declared length
+    extra: bytes  # the bytes after the declared length, before the close
+    declared: int | None
+
+
+def raw_exchange(port: int, request: bytes, timeout: float = 10.0) -> RawReply:
+    """Send one request and read until the agent closes the connection."""
+    with socket.create_connection(("127.0.0.1", port), timeout=timeout) as s:
+        s.sendall(request)
+        chunks = []
+        while chunk := s.recv(65536):
+            chunks.append(chunk)
+    data = b"".join(chunks)
+    head, _, rest = data.partition(b"\r\n\r\n")
+    lines = head.decode("latin-1").split("\r\n")
+    status = int(lines[0].split()[1])
+    headers = {}
+    for line in lines[1:]:
+        name, _, value = line.partition(":")
+        headers[name.strip().lower()] = value.strip()
+    declared = int(headers["content-length"]) if "content-length" in headers else None
+    if declared is None:
+        return RawReply(status, headers, rest, b"", None)
+    return RawReply(status, headers, rest[:declared], rest[declared:], declared)
+
+
+def post_request(path: str, body: bytes = b"") -> bytes:
+    return (
+        f"POST {path} HTTP/1.1\r\nHost: agent\r\nContent-Length: {len(body)}\r\n"
+        "Connection: close\r\n\r\n"
+    ).encode() + body
+
+
+def post_json(port: int, path: str, body: dict[str, Any], timeout: float = 30.0) -> Any:
+    """POST a JSON body and return `(status, decoded reply)`."""
+    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
+    try:
+        payload = json.dumps(body).encode()
+        conn.request("POST", path, body=payload, headers={"Content-Type": "application/json"})
+        response = conn.getresponse()
+        return response.status, json.loads(response.read())
+    finally:
+        conn.close()
+
+
+def get_health(port: int, timeout: float) -> tuple[int, Any]:
+    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
+    try:
+        conn.request("GET", "/health")
+        response = conn.getresponse()
+        return response.status, json.loads(response.read())
+    finally:
+        conn.close()
+
+
+def timed(call: Any, *args: Any, **kwargs: Any) -> tuple[float, Any]:
+    started = time.monotonic()
+    result = call(*args, **kwargs)
+    return time.monotonic() - started, result
+
+
+class AgentProcess:
+    """One agent process on a free port, with its capture root in `captures`."""
+
+    def __init__(self, captures: Path, seam_module: str = "") -> None:
+        self.port = free_port()
+        env = {
+            **os.environ,
+            "TESTANYWARE_AGENT_CAPTURE_ROOT": str(captures),
+            "PYTHONDONTWRITEBYTECODE": "1",
+        }
+        self.process = subprocess.Popen(
+            [sys.executable, "-c", LAUNCHER, str(AGENT_ROOT), str(self.port), seam_module],
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+        self._wait_listening(10.0)
+
+    def _wait_listening(self, limit: float) -> None:
+        end = time.monotonic() + limit
+        while time.monotonic() < end:
+            if self.process.poll() is not None:
+                raise RuntimeError(f"the agent exited early: {self.output()}")
+            try:
+                socket.create_connection(("127.0.0.1", self.port), timeout=0.2).close()
+                return
+            except OSError:
+                time.sleep(0.02)
+        raise RuntimeError("the agent did not listen within its start limit")
+
+    def output(self) -> str:
+        if self.process.poll() is None:
+            return ""
+        out, err = self.process.communicate()
+        return (out + err).decode(errors="replace")
+
+    def terminate_and_time(self, limit: float) -> float | None:
+        """Send SIGTERM and return the seconds to the agent exit, or None."""
+        started = time.monotonic()
+        self.process.send_signal(signal.SIGTERM)
+        try:
+            self.process.wait(limit)
+        except subprocess.TimeoutExpired:
+            return None
+        return time.monotonic() - started
+
+    def stop(self) -> None:
+        if self.process.poll() is None:
+            self.process.kill()
+        self.process.wait(10)
+        for stream in (self.process.stdout, self.process.stderr):
+            if stream is not None:
+                stream.close()
+
+
+@contextmanager
+def in_process_agent() -> Iterator[int]:
+    """Serve the production server class on a free loopback port in this process."""
+    from tests.agent_server import agent_request_handler
+
+    agent_request_handler()  # installs the AT-SPI stand-ins before the import below
+    from testanyware_agent import server
+
+    agent = server.make_server("127.0.0.1", 0)
+    thread = threading.Thread(target=agent.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield int(agent.server_address[1])
+    finally:
+        agent.shutdown()
+        agent.server_close()
+        thread.join(5)
diff --git a/agents/linux/tests/processes.py b/agents/linux/tests/processes.py
new file mode 100644
index 0000000000..4def8fcf8d
--- /dev/null
+++ b/agents/linux/tests/processes.py
@@ -0,0 +1,80 @@ def _stat_fields(pid: int) -> list[str] | None:
+"""Identify a process by its PID and start time (proc(5), /proc/PID/stat)."""
+
+from __future__ import annotations
+
+import os
+import signal
+import threading
+import time
+from pathlib import Path
+
+
+def _stat_fields(pid: int) -> list[str] | None:
+    try:
+        text = Path(f"/proc/{pid}/stat").read_text()
+    except OSError:
+        return None
+    # The command name in field 2 can hold spaces and parentheses.
+    return text[text.rindex(")") + 2 :].split()
+
+
+def start_ticks(pid: int) -> str | None:
+    fields = _stat_fields(pid)
+    return None if fields is None else fields[19]
+
+
+def process_state(pid: int) -> str | None:
+    fields = _stat_fields(pid)
+    return None if fields is None else fields[0]
+
+
+def read_child(path: Path) -> tuple[int, str]:
+    pid = int(path.read_text().split()[0])
+    ticks = start_ticks(pid)
+    assert ticks is not None, "the child had already gone when the test read it"
+    return pid, ticks
+
+
+def child_survives(pid: int, ticks: str) -> bool:
+    """True when the same process (PID and start time) still runs."""
+    return start_ticks(pid) == ticks and process_state(pid) != "Z"
+
+
+def wait_for_child(path: Path, limit: float = 5.0) -> tuple[int, str]:
+    end = time.monotonic() + limit
+    while time.monotonic() < end:
+        try:
+            if path.read_text().strip():
+                return read_child(path)
+        except (OSError, ValueError, AssertionError):
+            pass
+        time.sleep(0.01)
+    raise AssertionError("the command never wrote its child PID")
+
+
+def kill_if_same(pid: int, ticks: str) -> None:
+    """Clean up a test child only while its identity still matches."""
+    if child_survives(pid, ticks):
+        os.kill(pid, signal.SIGKILL)
+
+
+class ChildRecorder:
+    """Read the child PID file while the command runs, before the owner ends it."""
+
+    def __init__(self, path: Path, limit: float = 1.5) -> None:
+        self.path = path
+        self.limit = limit
+        self.child: tuple[int, str] | None = None
+        self._thread = threading.Thread(target=self._watch, daemon=True)
+        self._thread.start()
+
+    def _watch(self) -> None:
+        try:
+            self.child = wait_for_child(self.path, self.limit)
+        except AssertionError:
+            pass
+
+    def result(self) -> tuple[int, str]:
+        self._thread.join(self.limit + 0.5)
+        assert self.child is not None, "the command never wrote its child PID"
+        return self.child
diff --git a/agents/linux/tests/seam_hidden_exit.py b/agents/linux/tests/seam_hidden_exit.py
new file mode 100644
index 0000000000..7f4ec364b2
--- /dev/null
+++ b/agents/linux/tests/seam_hidden_exit.py
@@ -0,0 +1,36 @@ class NeverExitWaiter(exec_owner.PidfdLeaderWaiter):
+"""Seam module for an agent process: every leader status stays unavailable.
+
+Importing it replaces the leader-wait source of the owner (spec, section "Test
+seams and required controls", the unavailable-status control). The waiter
+still wakes on a cancellation, but it never reports a leader exit. The leader
+is real and receives the real signals. The seam is not a second backend.
+"""
+
+from __future__ import annotations
+
+import select
+import time
+
+from testanyware_agent import exec_owner
+from testanyware_agent.models import LeaderStatus
+
+
+class NeverExitWaiter(exec_owner.PidfdLeaderWaiter):
+    def wait_exit(self, timeout: float | None, wake: int | None = None) -> bool:
+        limit = exec_owner.MAX_KERNEL_WAIT_S if timeout is None else max(0.0, timeout)
+        end = time.monotonic() + limit
+        while True:
+            left = min(end - time.monotonic(), exec_owner.MAX_KERNEL_WAIT_S)
+            if left <= 0:
+                return False
+            if wake is not None:
+                if select.select([wake], [], [], left)[0]:
+                    return False
+            else:
+                time.sleep(left)
+
+    def peek(self) -> LeaderStatus | None:
+        return None
+
+
+exec_owner.DEFAULT_SEAMS.leader_waiter = NeverExitWaiter
diff --git a/agents/linux/tests/test_agent_process.py b/agents/linux/tests/test_agent_process.py
new file mode 100644
index 0000000000..b7f2113ba8
--- /dev/null
+++ b/agents/linux/tests/test_agent_process.py
@@ -0,0 +1,214 @@ def agent(tmp_path: Path) -> Iterator[AgentProcess]:
+"""Controls that run the agent as its own process, through its `main` entry.
+
+Each test names its row of the required-control table in
+docs/specs/guest-command-lifecycle.md, section "Test seams and required
+controls", and its kind (see tests/test_exec_lifecycle.py). These controls use
+only the HTTP interface and the entry point, so the old-fail controls run
+unchanged against the agent before leaf k220.
+"""
+
+from __future__ import annotations
+
+import json
+import socket
+import struct
+import threading
+import time
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from tests.exec_validity import record_errors, stream_bytes
+from tests.http_agent import (
+    AgentProcess,
+    get_health,
+    post_json,
+    post_request,
+    raw_exchange,
+    timed,
+)
+from tests.processes import child_survives, kill_if_same, wait_for_child
+
+pytestmark = pytest.mark.linux_kernel
+
+HEALTH_BOUND_S = 1.0  # spec, section "Bounds": health during a running command
+SHUTDOWN_BOUND_S = 4.0  # the two root bounds of 2 s, from SIGTERM to the last record
+EXIT_MARGIN_S = 0.5  # interpreter exit and process reaping after the last record
+
+
+@pytest.fixture
+def agent(tmp_path: Path) -> Iterator[AgentProcess]:
+    process = AgentProcess(tmp_path / "captures")
+    try:
+        yield process
+    finally:
+        process.stop()
+
+
+class Background:
+    """One request on its own thread, so the test can act while it runs."""
+
+    def __init__(self, call: Any, *args: Any) -> None:
+        self.result: Any = None
+        self.error: BaseException | None = None
+        self._thread = threading.Thread(target=self._run, args=(call, *args), daemon=True)
+        self._thread.start()
+
+    def _run(self, call: Any, *args: Any) -> None:
+        try:
+            self.result = call(*args)
+        except BaseException as e:  # the test inspects every failure
+            self.error = e
+
+    def join(self, limit: float) -> Any:
+        self._thread.join(limit)
+        assert not self._thread.is_alive(), "the background request did not end"
+        return self.result
+
+
+# ---- Responsive agent during a command (old-fail) -------------------------
+
+
+def test_health_exec_and_download_reply_during_a_command(
+    agent: AgentProcess, tmp_path: Path
+) -> None:
+    """Old path: `diagnostic:linux-disconnect-container` (k6). The old agent
+    served one request at a time, so health waited for the running command
+    until its deadline. Each request here has its own 1 s client deadline."""
+    pid_file = tmp_path / "leader.pid"
+    partial = tmp_path / "partial.txt"
+    partial.write_bytes(b"partial evidence\n")
+    command = f"echo $$ > {pid_file}; exec sleep 30"
+    running = Background(post_json, agent.port, "/exec", {"command": command, "timeout": 3})
+    leader = wait_for_child(pid_file)
+    try:
+        elapsed, (status, health) = timed(get_health, agent.port, HEALTH_BOUND_S)
+        assert status == 200 and health["platform"] == "linux"
+        assert elapsed < HEALTH_BOUND_S
+        elapsed, (status, reply) = timed(
+            post_json, agent.port, "/exec", {"command": "printf ok", "timeout": 5}, HEALTH_BOUND_S
+        )
+        assert (status, reply["stdout"]) == (200, "ok")
+        elapsed, raw = timed(
+            raw_exchange, agent.port, post_request(f"/download?path={partial}"), HEALTH_BOUND_S
+        )
+        assert (raw.status, raw.body, raw.extra) == (200, b"partial evidence\n", b"")
+        assert elapsed < HEALTH_BOUND_S
+        assert child_survives(*leader), "a request ended the running command"
+    finally:
+        running.join(10)
+        kill_if_same(*leader)
+
+
+# ---- Download never sends extra bytes (old-fail) ---------------------------
+
+
+def test_download_never_sends_bytes_past_the_declared_length(agent: AgentProcess) -> None:
+    """Old path: `diagnostic:linux-download-consistency-container` (k14). The
+    old agent read to end-of-file, not to the length that `fstat` gave. A
+    procfs file reports size 0 and still reads bytes, which is the same growth
+    without a race. The new agent sends exactly the declared 0 bytes."""
+    raw = raw_exchange(agent.port, post_request("/download?path=/proc/self/status"))
+    assert raw.status == 200
+    assert raw.declared == 0
+    assert raw.extra == b"", f"{len(raw.extra)} bytes followed the declared length"
+
+
+# ---- Disconnect changes nothing, record retained (corrected-pass) ----------
+
+
+def _start_and_drop(port: int, body: dict[str, Any], how: str) -> None:
+    s = socket.create_connection(("127.0.0.1", port), timeout=5)
+    s.sendall(post_request("/exec", json.dumps(body).encode()))
+    time.sleep(0.3)
+    if how == "close":
+        s.close()
+    elif how == "reset":
+        # SO_LINGER with a zero time makes the close send RST (socket(7)).
+        s.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+        s.close()
+    else:
+        s.shutdown(socket.SHUT_WR)
+        s.settimeout(10)
+        s.recv(1)  # keep reading on the half-closed connection
+        s.close()
+
+
+@pytest.mark.parametrize("how", ["close", "reset", "half-close"])
+def test_disconnect_changes_nothing_and_the_record_is_retained(
+    agent: AgentProcess, how: str
+) -> None:
+    """The old-fail case of this row is macOS (k13). The command runs to its
+    outcome after the client drops the connection. A later cancellation of the
+    finished id returns the retained record and changes nothing."""
+    exec_id = f"drop-{how}"
+    body = {"command": "sleep 0.6; printf done", "timeout": 10, "id": exec_id}
+    dropper = threading.Thread(target=_start_and_drop, args=(agent.port, body, how), daemon=True)
+    dropper.start()
+    time.sleep(2.0)
+    status, reply = post_json(agent.port, "/exec/cancel", {"id": exec_id})
+    dropper.join(10)
+    assert (status, reply["state"]) == (200, "terminal")
+    record = reply["record"]
+    assert record_errors(record, exec_id=exec_id) == []
+    assert record["outcome"] == {"kind": "exited", "exitCode": 0}
+    assert stream_bytes(record, "stdout") == b"done"
+    status, again = post_json(agent.port, "/exec/cancel", {"id": exec_id})
+    assert again == reply
+
+
+# ---- Agent shutdown at SIGTERM (new behaviour) -----------------------------
+
+
+def test_sigterm_during_a_command_ends_the_group_and_exits_in_bounds(
+    agent: AgentProcess, tmp_path: Path
+) -> None:
+    pid_file = tmp_path / "child.pid"
+    command = f"sleep 120 & echo $! > {pid_file}; wait"
+    running = Background(
+        post_json, agent.port, "/exec", {"command": command, "timeout": 60, "id": "at-sigterm"}
+    )
+    child = wait_for_child(pid_file)
+    try:
+        exit_after = agent.terminate_and_time(SHUTDOWN_BOUND_S + 5)
+        assert exit_after is not None, "the agent did not exit"
+        assert exit_after < SHUTDOWN_BOUND_S + EXIT_MARGIN_S
+        assert agent.process.returncode == 0, agent.output()
+        assert not child_survives(*child), "the command group outlived the agent"
+        running.join(5)
+        if running.result is not None:
+            status, record = running.result
+            assert status == 200
+            assert record_errors(record, exec_id="at-sigterm") == []
+            assert record["outcome"] == {"kind": "cancelled", "beforeStart": False}
+            assert record["termination"]["groupEmpty"] == "yes"
+    finally:
+        kill_if_same(*child)
+
+
+def test_sigterm_does_not_wait_for_a_leader_whose_status_stays_unavailable(
+    tmp_path: Path,
+) -> None:
+    """The seam module hides every leader exit from the owner, so the status
+    stays unavailable past K + 1.4 s (spec, section "Agent shutdown")."""
+    agent = AgentProcess(tmp_path / "captures", seam_module="tests.seam_hidden_exit")
+    try:
+        leader_file = tmp_path / "leader.pid"
+        command = f"echo $$ > {leader_file}; exec sleep 120"
+        running = Background(
+            post_json, agent.port, "/exec", {"command": command, "timeout": 60, "id": "held"}
+        )
