    def test_termination_turn_deadlines_and_wakes(monkeypatch, pid_only, exited):
        import controller
    
        now = [10.0]
        signals = []
        observations = []
    
        def observe(pid):
            observations.append(now[0])
            return exited
    
        def forbidden(*args, **kwargs):
