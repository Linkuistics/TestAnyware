index 0000000000..b2d8e7ffa0
--- /dev/null
+++ b/experiments/exec-reliability/linux_k6_run.sh
@@ -0,0 +1,69 @@
+#!/bin/sh
+# One Linux disconnect availability run (leaf linux-disconnect-availability-k6).
+# Usage: linux_k6_run.sh container|live OUT
+# `container` runs the seven HTTP and client controls in one fresh container of the
+# pinned k5 image. `live` runs the k13 burst on one fresh unchanged Linux clone.
+# The outer records read only: inventories, source identity, host identity and agent bundle.
+# tooling-before.sha256 and tooling-after.sha256 hold the digests of the tools that decide
+# the outcome. The first is taken before the probe, the second after the check.
+# The probe verdict is True only when every call ends as planned. A blocked channel or a
+# surviving child is a finding, so verdict True can still go with a reproduced failure.
+# The script exits 0 only when the probe exits 0 with verdict True, the check exits 0
+# and the two tool digest lists are equal. Otherwise it exits 1.
+set -u
+MODE=$1
+OUT=$2
+case "$MODE" in container|live) ;; *) echo "usage: linux_k6_run.sh container|live OUT" >&2; exit 64 ;; esac
+test ! -e "$OUT" && test ! -e "$OUT-outer" || { echo "refusing an existing OUT: $OUT" >&2; exit 2; }
+HERE=experiments/exec-reliability
+BUNDLE=/opt/homebrew/opt/testanyware/share/testanyware/agents/linux/testanyware_agent
+TOOLS="$HERE/linux_k6_run.sh $HERE/linux_k6.py $HERE/linux_k6_seam.py $HERE/linux_k6_check.py
+$HERE/disconnect_k13_burst.py $HERE/disconnect_k13_check.py $HERE/disconnect_k13_seam.py
+$HERE/linux_k204.py $HERE/linux_k5.py $HERE/linux_k5_seam.py $HERE/outcomes_k12_seam.py
+$HERE/routes_k19.py $HERE/controller.py $HERE/inspection.py $HERE/retention.py
+$HERE/storage_client.py $HERE/turns.py $HERE/worker_capture.py $HERE/writer.py
+$HERE/linux_k5_stub/gi/__init__.py $HERE/linux_k5_stub/gi/repository/__init__.py
+$HERE/linux_k5_stub/pyatspi/__init__.py agents/linux/testanyware_agent/*.py
+$HERE/pyproject.toml $HERE/uv.lock scripts/vm_inventory.py Taskfile.yml"
+mkdir -p "$OUT-outer"
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-before.sha256"
+jj log -r @- --no-graph -T 'commit_id ++ "\n"' > "$OUT-outer/source-commit"
+jj diff --git > "$OUT-outer/source-dirty.diff"
+sysctl hw.ncpu hw.activecpu hw.memsize > "$OUT-outer/host-sysctl"
+shasum -a 256 agents/linux/testanyware_agent/*.py > "$OUT-outer/checkout-agent.sha256"
+if test "$MODE" = live; then
+  testanyware --version > "$OUT-outer/cli-version"
+  tart --version > "$OUT-outer/tart-version"
+  shasum -a 256 "$BUNDLE"/*.py > "$OUT-outer/bundle-agent.sha256"
+  tart list --format json > "$OUT-outer/tart-before.json"
+  testanyware vm list --json --all > "$OUT-outer/vm-before.json"
+else
+  docker version --format '{{json .}}' > "$OUT-outer/docker-version.json"
+  docker ps -a --format '{{json .}}' > "$OUT-outer/containers-before.jsonl"
+fi
+uv run --project "$HERE" --locked python "$HERE/linux_k6.py" "$MODE" "$OUT" > "$OUT-outer/probe.stdout" 2> "$OUT-outer/probe.stderr"
+echo $? > "$OUT-outer/probe.exit"
+if test "$MODE" = live; then
+  tart list --format json > "$OUT-outer/tart-after.json"
+  testanyware vm list --json --all > "$OUT-outer/vm-after.json"
+else
+  docker ps -a --format '{{json .}}' > "$OUT-outer/containers-after.jsonl"
+fi
+if test -f "$OUT/summary.json"; then
+  uv run --project "$HERE" --locked python "$HERE/linux_k6_check.py" "$MODE" "$OUT" > "$OUT-outer/check.stdout"
+  echo $? > "$OUT-outer/check.exit"
+else
+  echo "no summary in OUT" > "$OUT-outer/check.exit"
+fi
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-after.sha256"
+cat "$OUT-outer/probe.stdout" "$OUT-outer/probe.exit"
+test -f "$OUT-outer/check.stdout" && cat "$OUT-outer/check.stdout"
+STATUS=0
+test "$(cat "$OUT-outer/probe.exit")" = 0 || { echo "probe exit $(cat "$OUT-outer/probe.exit")" >&2; STATUS=1; }
+grep -q '^verdict True run ' "$OUT-outer/probe.stdout" || { echo "probe verdict is not True" >&2; STATUS=1; }
+test "$(cat "$OUT-outer/check.exit")" = 0 || { echo "check exit $(cat "$OUT-outer/check.exit")" >&2; STATUS=1; }
+cmp -s "$OUT-outer/tooling-before.sha256" "$OUT-outer/tooling-after.sha256" || { echo "tool digests changed during the run" >&2; STATUS=1; }
+echo "$STATUS" > "$OUT-outer/run.exit"
+exit "$STATUS"
diff --git a/experiments/exec-reliability/linux_k6_seam.py b/experiments/exec-reliability/linux_k6_seam.py
new file mode 100644
index 0000000000..b6b35790ca
--- /dev/null
+++ b/experiments/exec-reliability/linux_k6_seam.py
@@ -0,0 +1,525 @@ class Case:
+"""Run the k6 Linux disconnect cases in one container and print the raw evidence.
+
+Usage:
+  linux_k6_seam.py RUN cases
+  linux_k6_seam.py RUN agent PORT serial|threading
+
+RUN is the run tag: 12 decimal digits that the runner derives from its run ID.
+`cases` runs every case and prints one JSON object on stdout. Bytes are hex.
+The script judges nothing. `linux_k6_check.py` judges the object. `agent` is
+the agent launcher that `cases` starts once for each case.
+
+The script runs inside one fresh container. The container mounts the unchanged
+agent at /agent, the k5 desktop stubs at /stub and this directory at /seam.
+Client, agent and process table share one Linux kernel and one loopback.
+
+Each case starts a fresh agent. The client sends the issue #14 fork/wait shape
+with a guest timeout of 20 s on a raw socket. At 2 s the case acts on the
+original connection. Then it sends health, an ordinary exec and a download of
+the partial file, one after the other, each on its own connection.
+
+- `serial-control` reads the original response, then sends the follow-ups.
+- `serial-concurrent` keeps the original connection open and reading.
+- `serial-close` closes the original connection.
+- `serial-reset` resets the original connection.
+- `serial-half-close` shuts down the write half and keeps reading.
+- `host-deadline` keeps reading, and first sends a health request with a 5 s
+  client deadline. When the deadline passes, it closes that connection.
+- `threaded-reset` resets the original connection. Its agent serves the
+  unchanged `AgentRequestHandler` from `ThreadingHTTPServer`. It is the
+  identified experimental control `experimental: threading-server`.
+
+Two watchers sample every 50 ms. Each recorded change keeps the times of its
+sample and of the sample before it. The process watcher records the payload shell
+and its `sleep` child. The handler kills the shell at the deadline, so the exit
+of the shell marks the end of the original handler. The socket watcher records
+each row of /proc/net/tcp that has the agent port. On the listening row,
+`rx_queue` is the accept-queue length. On an agent connection row, `rx_queue` is
+the count of request bytes that the agent has not read.
+
+The sleep of each case is `120.<digit>` seconds followed by the run tag. After
+each case the script kills the shell and the sleep of the token with a pidfd,
+after it reads the start ticks again. It then stops the agent.
+"""
+
+from __future__ import annotations
+
+import importlib
+import json
+import os
+import platform
+import re
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from linux_k5_seam import kill_here, proc_rows
+
+GUEST_TIMEOUT = 20  # the issue #14 guest timeout
+ACT_AFTER = 2.0  # the case acts on the original connection at this time
+FOLLOW_BOUND = 30.0  # the ordinary bound of one follow-up request
+TRANSFER_BOUND = 150.0  # the bound of the partial-file download
+HOST_DEADLINE = 5.0  # the client deadline of the `host-deadline` health request
+ORDINARY_TIMEOUT = 10  # the guest timeout of the ordinary follow-up exec
+ORIGINAL_BOUND = GUEST_TIMEOUT + 20.0  # the raw host exec ceiling
+OBSERVE_BOUND = 35.0  # deadline 20 s + terminate wait 3 s + 12 s of margin
+READY_BOUND = 10.0  # a fresh agent must accept a connection within this
+STOP_WAIT = 2.0  # the TERM wait, and then the KILL wait, of one agent
+KILL_WAIT = 2.0  # owned processes must be gone within this after SIGKILL
+POLL = 0.05
+FIRST_PORT = 18648
+ORDINARY = "printf ordinary-ok"
+PARTIAL = b"partial\n"
+RUN_TAG = re.compile(r"^[0-9]{12}$")
+LISTEN = "0A"
+
+
+@dataclass(frozen=True)
+class Case:
+    name: str
+    server: str  # "serial" or "threading"
+    action: str  # "none", "keep", "close", "reset", "half-close" or "deadline"
+
+
+CASES = (
+    Case("serial-control", "serial", "none"),
+    Case("serial-concurrent", "serial", "keep"),
+    Case("serial-close", "serial", "close"),
+    Case("serial-reset", "serial", "reset"),
+    Case("serial-half-close", "serial", "half-close"),
+    Case("host-deadline", "serial", "deadline"),
+    Case("threaded-reset", "threading", "reset"),
+)
+
+
+def now_ns() -> int:
+    return time.monotonic_ns()
+
+
+def token(index: int, tag: str) -> str:
+    return f"120.{index + 1}{tag}"
+
+
+def payload(sleep: str, directory: str) -> str:
+    """The fork/wait shape of issue #14, as in `disconnect_k13_burst.payload`."""
+    return "\n".join(
+        (
+            f"mkdir -p {directory}",
+            f"sleep {sleep} &",
+            "child=$!",
+            f"printf '%s\\n' \"$child\" > {directory}/child.pid",
+            f"printf 'partial\\n' > {directory}/partial",
+            "wait",
+        )
+    )
+
+
+def http_request(method: str, target: str, port: int, body: bytes = b"") -> bytes:
+    head = f"{method} {target} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nConnection: close\r\n"
+    if method == "POST":
+        head += f"Content-Type: application/json\r\nContent-Length: {len(body)}\r\n"
+    return head.encode() + b"\r\n" + body
+
+
+def exec_request(port: int, command: str, timeout: int) -> bytes:
+    body = json.dumps({"command": command, "timeout": timeout}).encode()
+    return http_request("POST", "/exec", port, body)
+
+
+# ---- watchers ----
+
+
+def tcp_rows(port: int) -> list[tuple[str, str, str, int, int]]:
+    """The /proc/net/tcp rows with `port` at either end: local, remote, state, tx, rx."""
+    wanted = f"{port:04X}"
+    rows: list[tuple[str, str, str, int, int]] = []
+    for line in Path("/proc/net/tcp").read_text().splitlines()[1:]:
+        fields = line.split()
+        local, remote, state, queues = fields[1], fields[2], fields[3], fields[4]
+        if local.endswith(":" + wanted) or remote.endswith(":" + wanted):
+            tx, rx = queues.split(":")
+            rows.append((local, remote, state, int(tx, 16), int(rx, 16)))
+    return sorted(rows)
+
+
+class Watch:
+    """Sample one source every POLL seconds and keep each change with its time."""
+
+    def __init__(self, sample: Any) -> None:
+        self.sample = sample
+        self.changes: list[dict[str, Any]] = []
+        self.stopped = threading.Event()
+        self.thread = threading.Thread(target=self._run, daemon=True)
+        self.thread.start()
+
+    def _run(self) -> None:
+        """Each change keeps `prev_ns`, the time of the last sample before it.
+
+        The change happened in the interval from `prev_ns` to `ns`.
+        """
+        last: Any = None
+        prev_ns: int | None = None
+        while not self.stopped.is_set():
+            try:
+                value = self.sample()
+            except OSError as error:
+                value = {"error": str(error)}
+            ns = now_ns()
+            if value != last:
+                self.changes.append({"ns": ns, "prev_ns": prev_ns, "value": value})
+                last = value
+            prev_ns = ns
+            self.stopped.wait(POLL)
+
+    def stop(self) -> list[dict[str, Any]]:
+        self.stopped.set()
+        self.thread.join(timeout=2 * POLL + 1.0)
+        return self.changes
+
+
+def payload_rows(sleep: str) -> list[dict[str, Any]]:
+    """The payload shell and its sleep child: role, pid, state, ppid and start ticks."""
+    found: list[dict[str, Any]] = []
+    for row in proc_rows():
+        argv = row["argv"]
+        if argv == ["sleep", sleep]:
+            role = "child"
+        elif argv[:2] == ["/bin/bash", "-c"] and f"sleep {sleep} &" in " ".join(argv):
+            role = "shell"
+        else:
+            continue
+        found.append(
+            {
+                "role": role,
+                "pid": row["pid"],
+                "state": row["state"],
+                "ppid": row["ppid"],
+                "pgid": row["pgid"],
+                "start_ticks": row["start_ticks"],
+            }
+        )
+    return found
+
+
+# ---- one connection ----
+
+
+class Exchange:
+    """One request on its own socket, read to EOF or to its deadline."""
+
+    def __init__(self, name: str, port: int, request: bytes, bound: float) -> None:
+        self.name = name
+        self.port = port
+        self.request = request
+        self.bound = bound
+        self.record: dict[str, Any] = {"name": name, "bound": bound}
+        self.sock: socket.socket | None = None
+        self.done = threading.Event()
+
+    def open(self) -> None:
+        self.record["start_ns"] = now_ns()
+        sock = socket.create_connection(("127.0.0.1", self.port), timeout=self.bound)
+        self.sock = sock
+        self.record["connected_ns"] = now_ns()
+        self.record["local_port"] = sock.getsockname()[1]
+        sock.sendall(self.request)
+        self.record["sent_ns"] = now_ns()
+
+    def read(self) -> None:
+        """Read until EOF, an error or the deadline. The record keeps every outcome."""
+        assert self.sock is not None
+        received = bytearray()
+        deadline = self.record["start_ns"] + int(self.bound * 1e9)
+        try:
+            while True:
+                left = (deadline - now_ns()) / 1e9
+                if left <= 0:
+                    self.record["bound_exceeded"] = True
+                    break
+                self.sock.settimeout(left)
+                try:
+                    chunk = self.sock.recv(65536)
+                except TimeoutError:
+                    self.record["bound_exceeded"] = True
+                    break
+                if not chunk:
+                    break
+                if not received:
+                    self.record["first_byte_ns"] = now_ns()
+                received.extend(chunk)
+        except OSError as error:
+            self.record["error"] = f"{type(error).__name__}: {error}"
+        finally:
+            self.record["end_ns"] = now_ns()
+            self.record["response_hex"] = bytes(received).hex()
+            self.done.set()
+
+    def run(self) -> dict[str, Any]:
+        try:
+            self.open()
+        except OSError as error:
+            self.record["error"] = f"{type(error).__name__}: {error}"
+            self.record["end_ns"] = now_ns()
+            self.done.set()
+            return self.record
+        self.read()
+        self.close()
+        return self.record
+
+    def close(self) -> None:
+        if self.sock is not None:
+            self.sock.close()
+
+
+def act(original: Exchange, action: str) -> dict[str, Any]:
+    """Apply the case action to the original connection, and record its time."""
+    assert original.sock is not None
+    record: dict[str, Any] = {"action": action, "ns": now_ns()}
+    if action == "close":
+        original.sock.close()
+    elif action == "reset":
+        original.sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+        original.sock.close()
+    elif action == "half-close":
+        original.sock.shutdown(socket.SHUT_WR)
+    record["done_ns"] = now_ns()
+    return record
+
+
+# ---- agents ----
+
+
+def agent(port: int, kind: str) -> None:
+    """Serve the unchanged agent handler. `threading` is the experimental control."""
+    sys.path[:0] = ["/stub", "/agent"]
+    server: Any = importlib.import_module("testanyware_agent.server")
+
+    if kind == "serial":
+        server.run_server(port)  # the unchanged entry: a plain HTTPServer
+        return
+    from http.server import ThreadingHTTPServer
+
+    ThreadingHTTPServer(("0.0.0.0", port), server.AgentRequestHandler).serve_forever()
+
+
+def start_agent(tag: str, port: int, kind: str, logs: Path) -> tuple[subprocess.Popen[bytes], Any]:
+    argv = [sys.executable, "-E", "-s", "-B", __file__, tag, "agent", str(port), kind]
+    out = (logs / f"agent-{port}.out").open("wb")
+    child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=out)
+    return child, out
+
+
+def wait_ready(port: int) -> dict[str, Any]:
+    start = now_ns()
+    deadline = start + int(READY_BOUND * 1e9)
+    while now_ns() < deadline:
+        try:
+            socket.create_connection(("127.0.0.1", port), timeout=1.0).close()
+            return {"ready": True, "seconds": (now_ns() - start) / 1e9}
+        except OSError:
+            time.sleep(POLL)
+    return {"ready": False, "seconds": (now_ns() - start) / 1e9}
+
+
+def stop_agent(child: subprocess.Popen[bytes]) -> list[dict[str, Any]]:
+    steps: list[dict[str, Any]] = []
+    for sig in (signal.SIGTERM, signal.SIGKILL):
+        if child.poll() is not None:
+            break
+        child.send_signal(sig)
+        try:
+            child.wait(timeout=STOP_WAIT)
+        except subprocess.TimeoutExpired:
+            steps.append({"signal": sig.name, "exited": False})
+            continue
+        steps.append({"signal": sig.name, "exited": True})
+    steps.append({"returncode": child.poll()})
+    return steps
+
+
+# ---- one case ----
+
+
+def wait_until(mark_ns: int) -> None:
+    left = (mark_ns - now_ns()) / 1e9
+    if left > 0:
+        time.sleep(left)
+
+
+def follow_ups(case: Case, port: int, directory: str) -> list[dict[str, Any]]:
+    steps: list[tuple[str, bytes, float]] = []
+    if case.action == "deadline":
+        steps.append(("health-deadline", http_request("GET", "/health", port), HOST_DEADLINE))
+    steps += [
+        ("health", http_request("GET", "/health", port), FOLLOW_BOUND),
+        ("ordinary", exec_request(port, ORDINARY, ORDINARY_TIMEOUT), FOLLOW_BOUND),
+        (
+            "download",
+            http_request("POST", f"/download?path={directory}/partial", port),
+            TRANSFER_BOUND,
+        ),
+    ]
+    return [Exchange(name, port, request, bound).run() for name, request, bound in steps]
+
+
+def handler_gone(watch: Watch) -> bool:
+    """True once the shell was seen and the latest sample no longer holds it."""
+    seen = any(
+        any(row.get("role") == "shell" for row in change["value"]) for change in watch.changes
+    )
+    latest: list[Any] = watch.changes[-1]["value"] if watch.changes else []
+    return seen and not any(row.get("role") == "shell" for row in latest)
+
+
+def cleanup(sleep: str) -> dict[str, Any]:
+    """Kill the shell and the sleep of this token, then confirm that both are gone."""
+    targets = [(row["pid"], row["start_ticks"]) for row in payload_rows(sleep)]
+    kills = kill_here(targets)
+    deadline = now_ns() + int(KILL_WAIT * 1e9)
+    left = payload_rows(sleep)
+    while left and now_ns() < deadline:
+        time.sleep(POLL)
+        left = payload_rows(sleep)
+    return {"kills": kills, "left": left}
+
+
+def run_case(index: int, case: Case, tag: str, root: Path) -> dict[str, Any]:
+    port = FIRST_PORT + index
+    sleep = token(index, tag)
+    directory = str(root / case.name)
+    record: dict[str, Any] = {"case": case.name, "server": case.server, "port": port}
+    record["token"] = sleep
+    child, log = start_agent(tag, port, case.server, root)
+    try:
+        record["ready"] = wait_ready(port)
+        if not record["ready"]["ready"]:
+            return record
+        processes = Watch(lambda: payload_rows(sleep))
+        sockets = Watch(lambda: tcp_rows(port))
+        request = exec_request(port, payload(sleep, directory), GUEST_TIMEOUT)
+        original = Exchange("original", port, request, ORIGINAL_BOUND)
+        original.open()
+        start = original.record["start_ns"]
+        record["start_ns"] = start
+        reader: threading.Thread | None = None
+        if case.action not in ("close", "reset"):
+            reader = threading.Thread(target=original.read, daemon=True)
+            reader.start()
+        wait_until(start + int(ACT_AFTER * 1e9))
+        if case.action == "none":
+            original.done.wait(ORIGINAL_BOUND + 1.0)
+        else:
+            record["act"] = act(original, case.action)
+        record["follow"] = follow_ups(case, port, directory)
+        deadline = start + int(OBSERVE_BOUND * 1e9)
+        while not handler_gone(processes) and now_ns() < deadline:
+            time.sleep(POLL)
+        if reader is not None:
+            reader.join(timeout=max(0.0, (deadline - now_ns()) / 1e9))
+        original.close()
+        record["original"] = original.record
+        record["after_handler"] = {"ns": now_ns(), "rows": payload_rows(sleep)}
+        record["evidence"] = evidence(directory)
+        record["cleanup"] = cleanup(sleep)
+        record["processes"] = processes.stop()
+        record["sockets"] = sockets.stop()
+    finally:
+        record["agent_stop"] = stop_agent(child)
+        log.close()
+        record["agent_log_hex"] = (root / f"agent-{port}.out").read_bytes().hex()
+    return record
+
+
+def evidence(directory: str) -> dict[str, Any]:
+    """The partial file and the child PID file, read on this kernel."""
+    found: dict[str, Any] = {}
+    for name in ("partial", "child.pid"):
+        try:
+            found[name] = Path(directory, name).read_bytes().hex()
+        except OSError as error:
+            found[name] = f"unreadable: {error}"
+    return found
+
+
+def owned_by_run(argv: list[str], tag: str) -> bool:
+    """True for a payload sleep, a payload shell or an agent launcher of this run.
+
+    The container init and this script also name the tag, but only as their
+    own arguments. Neither is a payload or an agent, so neither matches.
+    """
+    if (
+        len(argv) == 2
+        and argv[0] == "sleep"
+        and argv[1].startswith("120.")
+        and argv[1].endswith(tag)
+    ):
+        return True
+    if argv[:2] == ["/bin/bash", "-c"] and len(argv) >= 3 and f"{tag} &" in argv[2]:
+        return True
+    return tag in argv and argv[argv.index(tag) + 1 :][:1] == ["agent"]
+
+
+def final_sweep(tag: str) -> dict[str, Any]:
+    """Every process that still names the run tag, and the kill of each."""
+    rows = [row for row in proc_rows() if owned_by_run(row["argv"], tag)]
+    kills = kill_here([(row["pid"], row["start_ticks"]) for row in rows])
+    return {"rows": rows, "kills": kills}
+
+
+def bounds() -> dict[str, Any]:
+    return {
+        "guest_timeout": GUEST_TIMEOUT,
+        "act_after": ACT_AFTER,
+        "follow_bound": FOLLOW_BOUND,
+        "transfer_bound": TRANSFER_BOUND,
+        "host_deadline": HOST_DEADLINE,
+        "ordinary_timeout": ORDINARY_TIMEOUT,
+        "original_bound": ORIGINAL_BOUND,
+        "observe_bound": OBSERVE_BOUND,
+        "ready_bound": READY_BOUND,
+        "stop_wait": STOP_WAIT,
+        "kill_wait": KILL_WAIT,
+        "poll": POLL,
+    }
+
+
+def cases(tag: str) -> dict[str, Any]:
+    result: dict[str, Any] = {
+        "tag": tag,
+        "python": sys.version,
+        "kernel": platform.release(),
+        "uid": os.getuid(),
+        "pid": os.getpid(),
+        "bounds": bounds(),
+        "cases": [],
+    }
+    root = Path(tempfile.mkdtemp(prefix="k6-"))
+    try:
+        for index, case in enumerate(CASES):
+            result["cases"].append(run_case(index, case, tag, root))
+    finally:
+        result["final_sweep"] = final_sweep(tag)
+    return result
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) >= 3 and RUN_TAG.fullmatch(argv[1]) and argv[2] == "agent" and len(argv) == 5:
+        agent(int(argv[3]), argv[4])
+        return 0
+    if len(argv) == 3 and RUN_TAG.fullmatch(argv[1]) and argv[2] == "cases":
+        print(json.dumps(cases(argv[1])), flush=True)
+        return 0
+    print(__doc__, file=sys.stderr)
+    return 64
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/experiments/exec-reliability/test_linux_k6.py b/experiments/exec-reliability/test_linux_k6.py
new file mode 100644
index 0000000000..561a7e1731
--- /dev/null
+++ b/experiments/exec-reliability/test_linux_k6.py
@@ -0,0 +1,300 @@ def http(status: int, body: bytes) -> str:
+"""Controls for the k6 Linux disconnect tooling (leaf linux-disconnect-availability-k6).
+
+Each container control builds a run directory without Docker. The cases are
+synthetic records in the shape that `linux_k6_seam.py cases` prints. The
+control case answers its follow-ups after the handler. A test case then
+changes one property and expects the checker to classify it.
+"""
+
+import copy
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+import controller
+import linux_k6
+import linux_k6_check as checker
+import linux_k6_seam as seam
+
+HERE = Path(__file__).resolve().parent
+S = 1_000_000_000
+START = 100 * S
+PORT = 18648
+SHELL = {"role": "shell", "pid": 10, "ppid": 5}
+CHILD = {"role": "child", "pid": 11, "ppid": 10}
+ORPHAN = {"role": "child", "pid": 11, "ppid": 1}
+
+
+def http(status: int, body: bytes) -> str:
+    head = f"HTTP/1.0 {status} OK\r\nContent-Type: application/json\r\n\r\n".encode()
+    return (head + body).hex()
+
+
+HEALTH = http(200, json.dumps(checker.HEALTH_BODY).encode())
+ORDINARY = http(200, json.dumps({"exitCode": 0, "stdout": "ordinary-ok", "stderr": ""}).encode())
+DOWNLOAD = http(200, seam.PARTIAL)
+DEADLINE = http(200, json.dumps(checker.DEADLINE_BODY).encode())
+REPLIES = {"health": HEALTH, "health-deadline": HEALTH, "ordinary": ORDINARY, "download": DOWNLOAD}
+
+
+def at(seconds: float) -> int:
+    return START + int(seconds * S)
+
+
+def follow(name: str, began: float, latency: float, port: int) -> dict[str, Any]:
+    return {
+        "name": name,
+        "start_ns": at(began),
+        "end_ns": at(began + latency),
+        "response_hex": REPLIES[name],
+        "bound": seam.FOLLOW_BOUND,
+        "bound_exceeded": False,
+        "error": None,
+        "local_port": port,
+    }
+
+
+def case(name: str, server: str = "serial", gone: float = 20.05) -> dict[str, Any]:
+    """One case whose shell ends at `gone` and whose child survives."""
+    processes = [
+        {"ns": at(0.05), "prev_ns": at(0.0), "value": [SHELL, CHILD]},
+        {"ns": at(gone), "prev_ns": at(gone - seam.POLL), "value": [ORPHAN]},
+    ]
+    if name == checker.CONTROL:
+        records = [
+            follow("health", 20.06, 0.001, 50001),
+            follow("ordinary", 20.07, 0.002, 50002),
+            follow("download", 20.08, 0.001, 50003),
+        ]
+    else:
+        records = [
+            follow("health", 2.0, gone + 0.01 - 2.0, 50001),
+            follow("ordinary", gone + 0.02, 0.002, 50002),
+            follow("download", gone + 0.03, 0.001, 50003),
+        ]
+    return {
+        "case": name,
+        "server": server,
+        "port": PORT,
+        "ready": {"ready": True},
+        "start_ns": START,
+        "processes": processes,
+        "after_handler": {"rows": [ORPHAN]},
+        "original": {"response_hex": DEADLINE, "end_ns": at(20.01), "local_port": 50000},
+        "act": {},
+        "follow": records,
+        "sockets": [],
+        "evidence": {},
+        "cleanup": {"kills": [{"pid": 11, "why": "killed"}], "left": []},
+        "agent_stop": {},
+        "agent_log_hex": "",
+    }
+
+
+def cases() -> list[dict[str, Any]]:
+    result = [case(c.name, c.server) for c in seam.CASES]
+    threaded = result[-1]
+    threaded["follow"] = [
+        follow("health", 2.0, 0.002, 50001),
+        follow("ordinary", 2.01, 0.002, 50002),
+        follow("download", 2.02, 0.001, 50003),
+    ]
+    return result
+
+
+def run_dir(tmp_path: Path, items: list[dict[str, Any]], ok: bool = True) -> Path:
+    run = tmp_path / "run"
+    run.mkdir()
+    (run / "cases.json").write_text(json.dumps({"ok": ok}))
+    output: dict[str, Any] = {"cases": items, "final_sweep": {"rows": []}, "bounds": seam.bounds()}
+    (run / "cases.stdout").write_text(json.dumps(output))
+    return run
+
+
+def judge(tmp_path: Path, items: list[dict[str, Any]]) -> dict[str, Any]:
+    return checker.container_check({"verdict": True}, run_dir(tmp_path, items))
+
+
+def classes(report: dict[str, Any], name: str) -> dict[str, str]:
+    verdict = next(v for v in report["cases"] if v["case"] == name)
+    return {f["name"]: f["class"] for f in verdict["follow"]}
+
+
+# ---- shape ----
+
+
+def test_cases_and_bounds_are_frozen() -> None:
+    names = [c.name for c in seam.CASES]
+    assert names[0] == checker.CONTROL
+    assert [c.server for c in seam.CASES].count("threading") == 1
+    assert seam.GUEST_TIMEOUT == 20
+    assert seam.ACT_AFTER == 2.0
+    assert seam.FOLLOW_BOUND == 30
+    assert seam.TRANSFER_BOUND == 150
+    assert checker.LATENCY_ALLOWANCE == 5.0
+
+
+def test_both_plans_pass_the_controller_rules(tmp_path: Path) -> None:
+    controller._validate(linux_k6.container_plan("/usr/bin/python3"), None)  # pyright: ignore[reportPrivateUsage]
+    tools = {"python": "/usr/bin/python3", "cli": "/bin/testanyware", "tart": "/bin/tart"}
+    controller._validate(linux_k6.live_plan(tools, tmp_path), None)  # pyright: ignore[reportPrivateUsage]
+
+
+def test_the_sweep_owns_payloads_and_agents_but_not_the_container_init() -> None:
+    tag = "000000000042"
+    assert seam.owned_by_run(["sleep", f"120.3{tag}"], tag)
+    assert seam.owned_by_run(["/bin/bash", "-c", f"sleep 120.3{tag} & wait"], tag)
+    assert seam.owned_by_run(["python3", "/seam/linux_k6_seam.py", tag, "agent", "18649"], tag)
+    assert not seam.owned_by_run(["/sbin/docker-init", "--", "python3", "x.py", tag, "cases"], tag)
+    assert not seam.owned_by_run(["python3", "/seam/linux_k6_seam.py", tag, "cases"], tag)
+
+
+# ---- container oracle ----
+
+
+def test_clean_cases_are_complete_and_queued_health_is_blocked(tmp_path: Path) -> None:
+    report = judge(tmp_path, cases())
+    assert report["problems"] == []
+    assert set(classes(report, checker.CONTROL).values()) == {"baseline"}
+    assert classes(report, "serial-reset") == {
+        "health": "blocked",
+        "ordinary": "responsive",
+        "download": "responsive",
+    }
+    assert set(classes(report, "threaded-reset").values()) == {"responsive"}
+    for verdict in report["cases"]:
+        assert verdict["handler"]["class"] == "deadline"
+        assert verdict["child"]["class"] == "survived-handler"
+
+
+def test_a_fast_answer_that_spans_the_handler_end_is_blocked(tmp_path: Path) -> None:
+    items = cases()
+    items[3]["follow"][0] = follow("health", 19.9, 0.2, 50001)
+    report = judge(tmp_path, items)
+    assert classes(report, "serial-reset")["health"] == "blocked"
+
+
+def test_an_exceeded_bound_or_wrong_body_is_failed(tmp_path: Path) -> None:
+    items = cases()
+    items[5]["follow"][0]["bound_exceeded"] = True
+    items[5]["follow"][0]["response_hex"] = ""
+    items[4]["follow"][2]["response_hex"] = http(200, b"other\n")
+    report = judge(tmp_path, items)
+    assert classes(report, "host-deadline")["health"] == "failed"
+    assert classes(report, "serial-half-close")["download"] == "failed"
+    assert report["problems"] == []
+
+
+@pytest.mark.parametrize(
+    ("gone", "expected"), [(10.0, "cancelled"), (20.05, "deadline"), (30.0, "overran")]
+)
+def test_the_handler_class_follows_the_shell_end(
+    tmp_path: Path, gone: float, expected: str
+) -> None:
+    items = cases()
+    items[3] = case("serial-reset", gone=gone)
+    report = judge(tmp_path, items)
+    verdict = next(v for v in report["cases"] if v["case"] == "serial-reset")
+    assert verdict["handler"]["class"] == expected
+
+
+def test_a_child_that_ends_with_the_shell_did_not_survive(tmp_path: Path) -> None:
+    items = cases()
+    items[2]["after_handler"] = {"rows": []}
+    items[2]["processes"][1]["value"] = []
+    report = judge(tmp_path, items)
+    verdict = next(v for v in report["cases"] if v["case"] == "serial-close")
+    assert verdict["child"]["class"] == "ended-with-handler"
+
+
+@pytest.mark.parametrize(
+    "edit",
+    ["no-shell", "left", "control-late", "receipt", "missing-case"],
+)
+def test_incomplete_evidence_is_a_problem(tmp_path: Path, edit: str) -> None:
+    items = cases()
+    ok = True
+    if edit == "no-shell":
+        items[1]["processes"] = []
+        items[1]["after_handler"] = {"rows": []}
+    elif edit == "left":
+        items[1]["cleanup"]["left"] = [ORPHAN]
+    elif edit == "control-late":
+        items[0] = case(checker.CONTROL, gone=30.0)
+    elif edit == "receipt":
+        ok = False
+    else:
+        del items[2]
+    report = checker.container_check({"verdict": True}, run_dir(tmp_path, items, ok))
+    assert report["problems"]
+
+
+def test_the_queue_record_reads_unread_request_bytes(tmp_path: Path) -> None:
+    items = cases()
+    agent = f"0100007F:{PORT:04X}"
+    remote = "0100007F:C351"  # 50001, the health follow-up
+    items[3]["sockets"] = [
+        {"ns": at(0.0), "prev_ns": None, "value": [[f"00000000:{PORT:04X}", "x", "0A", 0, 0]]},
+        {
+            "ns": at(2.05),
+            "prev_ns": at(2.0),
+            "value": [[f"00000000:{PORT:04X}", "x", "0A", 0, 1], [agent, remote, "01", 0, 66]],
+        },
+        {"ns": at(20.06), "prev_ns": at(20.01), "value": [[agent, remote, "01", 0, 0]]},
+    ]
+    report = judge(tmp_path, items)
+    verdict = next(v for v in report["cases"] if v["case"] == "serial-reset")
+    assert verdict["listen_peak"] == 1
+    queue = verdict["follow"][0]["queue"]
+    assert queue == {"waited_from": pytest.approx(2.05), "read_by": pytest.approx(20.06)}
+    assert verdict["queue_release"] == pytest.approx(0.01)
+
+
+# ---- live rule ----
+
+
+LIVE_01 = (
+    HERE / "evidence/linux-disconnect-availability-k6/live-01/f5158780256d4fad9def8d77a9554797"
+)
+
+
+def live_result(mode: str) -> dict[str, Any]:
+    return json.loads((LIVE_01 / f"burst-{mode}.stdout").read_bytes())
+
+
+def test_the_linux_rules_judge_the_retained_live_01_records() -> None:
+    control = live_result("control")
+    assert checker.linux_original(control)["expected"] is True
+    assert checker.linux_original(control)["timed_out"] is False
+    assert checker.live_handler(control)[0] == "deadline"
+    term = live_result("term")
+    handler, lo, hi, basis = checker.live_handler(term)
+    assert (handler, lo, basis) == ("deadline", None, "queue-release")
+    assert hi == pytest.approx(20.069, abs=0.001)
+    adopted = checker.adoption(term)
+    assert adopted is not None
+    assert adopted["parent_command"] == "/usr/lib/systemd/systemd --user"
+
+
+def test_the_payload_shell_alive_gives_a_lower_end() -> None:
+    term = copy.deepcopy(live_result("term"))
+    first = term["follow"][0]
+    body = json.loads(bytes.fromhex(first["stdout_hex"]))
+    body["stdout"] = (
+        "shell pid=900 present ppid=850 command=/bin/bash -c mkdir -p /tmp/taw-k13/term\n"
+        "child pid=2189 present ppid=900 command=sleep 120"
+    )
+    first["stdout_hex"] = json.dumps(body).encode().hex()
+    handler, lo, _hi, basis = checker.live_handler(term)
+    assert (handler, basis) == ("deadline", "bracket")
+    assert lo == pytest.approx(2.009, abs=0.001)
+
+
+def test_a_reply_without_the_linux_deadline_text_is_unexpected() -> None:
+    control = copy.deepcopy(live_result("control"))
+    body = json.loads(bytes.fromhex(control["original"]["stdout_hex"]))
+    body["stderr"] = ""
+    control["original"]["stdout_hex"] = json.dumps(body).encode().hex()
+    assert checker.linux_original(control)["expected"] is False
