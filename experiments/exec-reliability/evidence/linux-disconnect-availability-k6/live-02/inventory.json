  "inspection": {
    "control": "cpid=$(cat /tmp/taw-k13/control/child.pid 2>/dev/null)\nif [ -n \"$cpid\" ] && [ ! -s /tmp/taw-k13/control/shell.of.\"$cpid\" ]; then\n  ppid=$(ps -o ppid= -p \"$cpid\" | tr -d ' ')\n  case \"$ppid\" in ''|1) ;; *)\n    printf '%s\\n' \"$ppid\" > /tmp/taw-k13/control/shell.of.\"$cpid\" ;;\n  esac\nfi\nfor role in shell child; do\n  if [ \"$role\" = shell ]; then\n    pid=$(cat /tmp/taw-k13/control/shell.of.\"$cpid\" 2>/dev/null)\n  else\n    pid=$cpid\n  fi\n  if [ -z \"$pid\" ]; then printf '%s pid=none\\n' \"$role\"; continue; fi\n  if err=$(kill -0 \"$pid\" 2>&1); then state=present\n  else case \"$err\" in\n    *[Nn]o\\ such\\ process*) state=absent ;;\n    *) state=unknown ;;\n  esac\n  fi\n  ppid=$(ps -p \"$pid\" -o ppid= | tr -d ' ')\n  cmd=$(ps -p \"$pid\" -o command= | sed 's/ *$//')\n  fmt='%s pid=%s %s ppid=%s command=%s\\n'\n  printf \"$fmt\" \"$role\" \"$pid\" \"$state\" \"$ppid\" \"$cmd\"\ndone",
