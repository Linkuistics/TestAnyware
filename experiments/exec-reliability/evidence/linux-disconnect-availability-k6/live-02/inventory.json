    "term": "cpid=$(cat /tmp/taw-k13/term/child.pid 2>/dev/null)\nif [ -n \"$cpid\" ] && [ ! -s /tmp/taw-k13/term/shell.of.\"$cpid\" ]; then\n  ppid=$(ps -o ppid= -p \"$cpid\" | tr -d ' ')\n  case \"$ppid\" in ''|1) ;; *)\n    printf '%s\\n' \"$ppid\" > /tmp/taw-k13/term/shell.of.\"$cpid\" ;;\n  esac\nfi\nfor role in shell child; do\n  if [ \"$role\" = shell ]; then\n    pid=$(cat /tmp/taw-k13/term/shell.of.\"$cpid\" 2>/dev/null)\n  else\n    pid=$cpid\n  fi\n  if [ -z \"$pid\" ]; then printf '%s pid=none\\n' \"$role\"; continue; fi\n  if err=$(kill -0 \"$pid\" 2>&1); then state=present\n  else case \"$err\" in\n    *[Nn]o\\ such\\ process*) state=absent ;;\n    *) state=unknown ;;\n  esac\n  fi\n  ppid=$(ps -p \"$pid\" -o ppid= | tr -d ' ')\n  cmd=$(ps -p \"$pid\" -o command= | sed 's/ *$//')\n  fmt='%s pid=%s %s ppid=%s command=%s\\n'\n  printf \"$fmt\" \"$role\" \"$pid\" \"$state\" \"$ppid\" \"$cmd\"\ndone"
  },
  "cleanup": "state() {\n  if err=$(kill -0 \"$1\" 2>&1); then echo alive\n  else case \"$err\" in\n    *[Nn]o\\ such\\ process*) echo gone ;;\n    *) echo unknown ;;\n  esac; fi\n}\nwait_gone() {\n  i=0\n  while [ \"$(state \"$1\")\" = alive ] && [ \"$i\" -lt \"$2\" ]; do\n    sleep 0.1; i=$((i + 1))\n  done\n}\noutcome=confirmed\nfor f in /tmp/taw-k13/control/child.pid /tmp/taw-k13/concurrent/child.pid /tmp/taw-k13/term/child.pid; do\n  [ -f \"$f\" ] || continue\n  pid=$(cat \"$f\")\n  cmd=$(ps -p \"$pid\" -o args= | sed 's/ *$//')\n  printf '%s pid=%s command=%s\\n' \"$f\" \"$pid\" \"$cmd\"\n  if [ \"$cmd\" != \"sleep 120\" ]; then\n    s=$(state \"$pid\")\n    if [ -z \"$cmd\" ] && [ \"$s\" = gone ]; then printf 'gone pid=%s\\n' \"$pid\"\n    elif [ -n \"$cmd\" ] && [ \"$s\" = alive ]; then printf 'other pid=%s\\n' \"$pid\"\n    else printf 'unknown pid=%s state=%s\\n' \"$pid\" \"$s\"; outcome=uncertain; fi\n    continue\n  fi\n  kill -TERM \"$pid\"\n  wait_gone \"$pid\" 20\n  action=terminated\n  if [ \"$(state \"$pid\")\" = alive ]; then\n    kill -KILL \"$pid\"; action=killed\n    wait_gone \"$pid\" 5\n  fi\n  s=$(state \"$pid\")\n  if [ \"$s\" = gone ]; then printf '%s pid=%s\\n' \"$action\" \"$pid\"\n  else printf 'survived pid=%s state=%s\\n' \"$pid\" \"$s\"; outcome=uncertain; fi\ndone\nprintf 'cleanup %s\\n' \"$outcome\"\n[ \"$outcome\" = confirmed ]",
