+    requires:
+      vars: [MODE, OUT]
+    cmds:
+      - uv run --project experiments/exec-reliability --locked python experiments/exec-reliability/linux_k6_check.py {{.MODE | shellQuote}} {{.OUT | shellQuote}}
+
+  diagnostic:linux-disconnect-tools:
