+      - uv run --locked python -m ruff format --check linux_k6.py linux_k6_seam.py linux_k6_check.py test_linux_k6.py
+      - uv run --locked python -m pyright linux_k6.py linux_k6_seam.py linux_k6_check.py test_linux_k6.py
+      - shellcheck linux_k6_run.sh
+      - uv run --locked python -m pytest -q -p no:cacheprovider test_linux_k6.py
+
   diagnostic:deadline-stall-tools:
     desc: Check the k154 worker-deadline control tooling
     dir: '{{.ROOT_DIR}}/experiments/exec-reliability'
