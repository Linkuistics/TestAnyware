        attempts = []
        audit = {"pid": process.pid, "deadline": deadline, "outcome": outcome}
        tick = 100.0 - step
    
        def clock():
            nonlocal tick
            tick += step
            result = round(tick, 6)
            if step == 0 and outcome != "ready":
                tick += 0.001
            return result
    
