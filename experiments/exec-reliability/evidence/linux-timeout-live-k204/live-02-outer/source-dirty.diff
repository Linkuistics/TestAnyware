diff --git a/experiments/exec-reliability/linux_k204.py b/experiments/exec-reliability/linux_k204.py
new file mode 100644
index 0000000000..0a99a0fe96
--- /dev/null
+++ b/experiments/exec-reliability/linux_k204.py
@@ -0,0 +1,447 @@ def fork_wait(label: str) -> str:
+"""Live timeout lifecycle on one fresh unchanged Linux clone (leaf linux-timeout-live-k204).
+
+    linux_k204.py OUT
+
+The script checks the retained r5 fixture against its frozen hashes. Then it freezes
+the plan, its bounds and its subject hashes in OUT/inventory.json before the first
+live call. It runs one plan once. The plan owns one clone of the retained golden
+`testanyware-golden-linux-24.04`. The clone runs the agent of the golden unchanged.
+The `finally` path of the controller cleans up the known children and disposes the
+clone. The calls run in this order:
+
+1. `health-before`, `identity` and `table-before`: agent health, the agent sources
+   and process, and one full process table.
+2. The exact `sleep 120` control with guest timeout 2 s, once through the Host CLI
+   (`cli-sleep`) and once straight to the agent (`raw-sleep`). A full process table
+   follows each control. Bash runs a lone simple command by exec, so the guest
+   `sleep` is the shell itself and cannot record its own identity.
+3. The fork/wait control with guest timeout 2 s, once through the Host CLI
+   (`cli-fork`) and once straight to the agent (`raw-fork`). The shell records its
+   own PID and the PID of its `sleep 120` child. It writes partial bytes to stdout,
+   stderr and a file before `wait`. An independent observation of the shell and the
+   child and a download of the partial file follow each control.
+4. `health-mid`, a late observation of both fork controls after a further 5 s, the
+   owned cleanup of the two fork children, an observation after it and
+   `table-before-r5`.
+5. `r5-*`: the clone-1 sequence of the original Linux VM-fit fixture r5, with its
+   guest script and lesson unchanged. Each call has the argv and the guest timeout
+   of the original call, from the retained clone-1 records of `linux-03`. Only the
+   VM identity and the local download paths differ. The original start and stop
+   calls are the resource acquisition and disposal here.
+
+A guest timeout gives host exit 0, and a raw call exits 0 whenever it prints its
+record. So the controller continues after each control and stops the plan only at a
+host failure. The later calls then stay unreached and recorded. linux_k204_check.py
+judges the receipts afterwards.
+"""
+
+import hashlib
+import json
+import sys
+import uuid
+from collections.abc import Sequence
+from dataclasses import asdict, replace
+from pathlib import Path
+
+from controller import Call, Plan, Resource, execute_outcome, write_json
+from routes_k19 import (  # the k19 resource shape, reused unchanged
+    AGENTS,
+    BOOT,
+    CHECKER,
+    DISPOSE,
+    GUEST_IDENTITY,
+    HEALTH,
+    HERE,
+    REPO,
+    _owned,  # pyright: ignore[reportPrivateUsage]
+)
+
+LEAF = "linux-timeout-live-k204"
+GOLDEN = "testanyware-golden-linux-24.04"
+GUEST_TIMEOUT = 2  # intentional guest timeout of each control
+HOST_MARGIN = 20.0  # host bound: guest budget plus 20 s
+OBSERVE_GUEST = 10  # own observations: guest 10 s, host 30 s, the observation bound
+OBSERVE_BOUND = 30.0
+# Four known children at most, each with at most 2 s of TERM grace and 0.5 s of KILL wait.
+CLEANUP_GUEST = 10
+# The guest cleanup ceiling is 30 s. The controller reserves 2 s TERM and 2 s KILL.
+CLEANUP_BOUND = 26.0
+TRANSFER = 150.0  # transfer ceiling, the command host budget of fixture r5
+R5_OBSERVE = 30  # the guest timeout of the ordinary r5 calls in linux-03
+R5_INVENTORY = 60
+R5_ONLINE = 120
+R5_CANCEL_GUEST = 20  # the r5 cancel case: guest deadline 20 s, interrupt after 2 s
+R5_CANCEL_AFTER = 2.0
+
+FIXTURE = HERE / "evidence" / LEAF / "fixture-r5"
+# The hashes from the retained frozen.json of the original VM-fit run, revision r5.
+FIXTURE_SHA256 = {
+    "cases.json": "ad97fe2e5f9965809684d3efee7de60e998b06121ad23636bcef85c415aae97b",
+    "guest.sh": "2f1c022a6dac48fb6d026d63331199c5b6bfdb7cef91e22549859ba40aabfe80",
+    "lesson": "0a649e33d19014a527aaf098dd8ad4c671d18bb02b842eaa4f1fa515f31ea23c",
+}
+FROZEN_SHA256 = "a954f67cd4412af281b641c605d48207d98ba964154aee0434bd226fca8389c8"
+R5_ROOT = "/tmp/vmfit-k15"  # the fixture's own guest root, fixed inside guest.sh
+ONLINE = json.loads((FIXTURE / "cases.json").read_bytes())["platforms"]["linux"]
+
+K204_ROOT = "/tmp/taw-k204"
+FORK_LABELS = ("cli-fork", "raw-fork")
+ISSUE_SLEEP = "sleep 120"
+
+
+def fork_wait(label: str) -> str:
+    """The fork/wait control: the failure-B shape plus the shell's own PID and partial bytes."""
+    return "\n".join(
+        (
+            f"d={K204_ROOT}/{label}",
+            'mkdir -p "$d"',
+            'printf \'%s\\n\' "$$" > "$d/shell.pid"',
+            "sleep 120 & p=$!",
+            'printf \'%s\\n\' "$p" > "$d/child.pid"',
+            "printf 'partial-out\\n'",
+            "printf 'partial-err\\n' >&2",
+            "printf 'partial-file\\n' > \"$d/partial\"",
+            "wait",
+        )
+    )
+
+
+def observe(labels: Sequence[str]) -> str:
+    """Observe each recorded shell and child by its PID file, one `ps` per PID.
+
+    Each PID gives `<role> pid=N`, the `ps` row when `ps` lists it, and then
+    `<role> ps-exit=E`. An unreadable PID file gives `<role> pid-file=unreadable`.
+    """
+    lines: list[str] = []
+    for label in labels:
+        lines += [
+            "for role in shell child; do",
+            f"  f={K204_ROOT}/{label}/$role.pid; r={label}-$role",
+            '  if ! pid=$(cat "$f"); then printf \'%s pid-file=unreadable\\n\' "$r"; continue; fi',
+            '  printf \'%s pid=%s\\n\' "$r" "$pid"',
+            '  ps -p "$pid" -o pid=,ppid=,pgid=,sid=,stat=,lstart=,args=',
+            '  printf \'%s ps-exit=%s\\n\' "$r" "$?"',
+            "done",
+        ]
+    return "\n".join(lines)
+
+
+# A child that `ps` still lists here outlived its deadline by at least 5 s. That is
+# beyond the 2 s grace plus the 2 s kill and reap bound, whatever the host delays were.
+LATE_WAIT = 5
+LATE_OBSERVE = f"sleep {LATE_WAIT}\n{observe(FORK_LABELS)}"
+TABLE = "ps -eo pid,ppid,pgid,sid,stat,lstart,etime,args"
+IDENTITY = (
+    f"{GUEST_IDENTITY['linux']}; python3 --version; id; "
+    "ps -eo pid,ppid,pgid,sid,user,lstart,args | grep -F -e testanyware -e PID | grep -v -F grep"
+)
+
+
+def owned_cleanup(pid_files: Sequence[str]) -> str:
+    """Clean up only the known children, by PID files that this plan or fixture wrote.
+
+    The cleanup acts on a PID only while it still runs exactly `sleep 120`. TERM has
+    a grace of at most 2 s. KILL follows only for a survivor. Disposal removes
+    everything else. `state` reads `kill -0`: alive, gone (no such process) or
+    unknown (any other error). Each PID ends as `gone`, `other` (the PID now runs
+    another command), `terminated`, `killed`, `unknown` or `survived`. The last line
+    is `cleanup confirmed` only when no PID ended as `unknown` or `survived`.
+    Otherwise it is `cleanup uncertain`, and the command exits 1. This is the k4
+    cleanup with the Linux `args` column and the k204 PID files.
+    """
+    return "\n".join(
+        (
+            "state() {",
+            '  if err=$(kill -0 "$1" 2>&1); then echo alive',
+            '  else case "$err" in',
+            "    *[Nn]o\\ such\\ process*) echo gone ;;",
+            "    *) echo unknown ;;",
+            "  esac; fi",
+            "}",
+            "wait_gone() {",
+            "  i=0",
+            '  while [ "$(state "$1")" = alive ] && [ "$i" -lt "$2" ]; do',
+            "    sleep 0.1; i=$((i + 1))",
+            "  done",
+            "}",
+            "outcome=confirmed",
+            f"for f in {' '.join(pid_files)}; do",
+            '  [ -f "$f" ] || continue',
+            '  pid=$(cat "$f")',
+            "  cmd=$(ps -p \"$pid\" -o args= | sed 's/ *$//')",
+            '  printf \'%s pid=%s command=%s\\n\' "$f" "$pid" "$cmd"',
+            '  if [ "$cmd" != "sleep 120" ]; then',
+            '    s=$(state "$pid")',
+            '    if [ -z "$cmd" ] && [ "$s" = gone ]; then printf \'gone pid=%s\\n\' "$pid"',
+            '    elif [ -n "$cmd" ] && [ "$s" = alive ]; then printf \'other pid=%s\\n\' "$pid"',
+            '    else printf \'unknown pid=%s state=%s\\n\' "$pid" "$s"; outcome=uncertain; fi',
+            "    continue",
+            "  fi",
+            '  kill -TERM "$pid"',
+            '  wait_gone "$pid" 20',
+            "  action=terminated",
+            '  if [ "$(state "$pid")" = alive ]; then',
+            '    kill -KILL "$pid"; action=killed',
+            '    wait_gone "$pid" 5',
+            "  fi",
+            '  s=$(state "$pid")',
+            '  if [ "$s" = gone ]; then printf \'%s pid=%s\\n\' "$action" "$pid"',
+            '  else printf \'survived pid=%s state=%s\\n\' "$pid" "$s"; outcome=uncertain; fi',
+            "done",
+            "printf 'cleanup %s\\n' \"$outcome\"",
+            '[ "$outcome" = confirmed ]',
+        )
+    )
+
+
+CHILD_FILES = tuple(f"{K204_ROOT}/{label}/child.pid" for label in FORK_LABELS)
+CONTROL_CLEANUP = owned_cleanup(CHILD_FILES)
+FINAL_CLEANUP = owned_cleanup((*CHILD_FILES, f"{R5_ROOT}/timeout.pid", f"{R5_ROOT}/cancel.pid"))
+
+
+def _safe(name: str) -> str:
+    """Make a fixture file name a call name: `guest.sh` becomes `guest-sh`."""
+    return name.replace(".", "-")
+
+
+def _exec(cli: str, vm: str, guest_timeout: int, command: str) -> tuple[str, ...]:
+    return (cli, "file", "exec", "--vm", vm, "--timeout", str(guest_timeout), "--json", command)
+
+
+def _guest(cli: str, vm: str, name: str, guest_timeout: int, command: str) -> Call:
+    return Call(name, _exec(cli, vm, guest_timeout, command), guest_timeout + HOST_MARGIN)
+
+
+def _raw(python: str, vm: str, name: str, guest_timeout: int, command: str) -> Call:
+    argv = (python, "-I", str(HERE / "linux_k204_raw.py"), vm, str(guest_timeout), command)
+    return Call(name, argv, guest_timeout + HOST_MARGIN)
+
+
+def _health(cli: str, vm: str, name: str) -> Call:
+    return Call(name, (cli, "agent", "health", "--vm", vm, "--json"), HEALTH)
+
+
+def _download(cli: str, vm: str, name: str, remote: str, local: Path, exit_: int = 0) -> Call:
+    argv = (cli, "file", "download", "--vm", vm, remote, str(local), "--json")
+    return Call(name, argv, TRANSFER, expected_exit=exit_)
+
+
+def control_calls(tools: dict[str, str], vm: str, downloads: Path) -> list[Call]:
+    """Steps 1 to 4: the exact controls, their observations and the owned cleanup."""
+    cli, python = tools["cli"], tools["python"]
+
+    def fork(prefix: str, call: Call) -> list[Call]:
+        label = f"{prefix}-fork"
+        partial = _download(
+            cli,
+            vm,
+            f"download-{label}-partial",
+            f"{K204_ROOT}/{label}/partial",
+            downloads / f"{label}.partial",
+        )
+        observation = Call(
+            f"observe-{label}", _exec(cli, vm, OBSERVE_GUEST, observe((label,))), OBSERVE_BOUND
+        )
+        return [call, observation, partial]
+
+    def table(name: str) -> Call:
+        return Call(name, _exec(cli, vm, OBSERVE_GUEST, TABLE), OBSERVE_BOUND)
+
+    return [
+        _health(cli, vm, "health-before"),
+        Call("identity", _exec(cli, vm, OBSERVE_GUEST, IDENTITY), OBSERVE_BOUND),
+        table("table-before"),
+        _guest(cli, vm, "cli-sleep", GUEST_TIMEOUT, ISSUE_SLEEP),
+        table("table-after-cli-sleep"),
+        _raw(python, vm, "raw-sleep", GUEST_TIMEOUT, ISSUE_SLEEP),
+        table("table-after-raw-sleep"),
+        *fork("cli", _guest(cli, vm, "cli-fork", GUEST_TIMEOUT, fork_wait("cli-fork"))),
+        *fork("raw", _raw(python, vm, "raw-fork", GUEST_TIMEOUT, fork_wait("raw-fork"))),
+        _health(cli, vm, "health-mid"),
+        Call("observe-forks-late", _exec(cli, vm, OBSERVE_GUEST, LATE_OBSERVE), OBSERVE_BOUND),
+        Call("control-cleanup", _exec(cli, vm, CLEANUP_GUEST, CONTROL_CLEANUP), CLEANUP_BOUND),
+        Call(
+            "observe-after-control-cleanup",
+            _exec(cli, vm, OBSERVE_GUEST, observe(FORK_LABELS)),
+            OBSERVE_BOUND,
+        ),
+        table("table-before-r5"),
+    ]
+
+
+def r5_calls(cli: str, vm: str, fixture: Path, downloads: Path) -> list[Call]:
+    """Step 5: the clone-1 sequence of fixture r5 between its start and its stop."""
+
+    def case(name: str, guest_timeout: int, action: str) -> Call:
+        return _guest(cli, vm, f"r5-{name}", guest_timeout, f"bash {R5_ROOT}/guest.sh {action}")
+
+    def upload(name: str) -> Call:
+        argv = (
+            cli,
+            "file",
+            "upload",
+            "--vm",
+            vm,
+            str(fixture / name),
+            f"{R5_ROOT}/{name}",
+            "--json",
+        )
+        return Call(f"r5-upload-{_safe(name)}", argv, TRANSFER)
+
+    def download(name: str) -> Call:
+        return _download(
+            cli, vm, f"r5-download-{_safe(name)}", f"{R5_ROOT}/{name}", downloads / name
+        )
+
+    cancel = Call(
+        "r5-cancel",
+        _exec(cli, vm, R5_CANCEL_GUEST, f"bash {R5_ROOT}/guest.sh cancel"),
+        R5_CANCEL_GUEST + HOST_MARGIN,
+        interrupt_after=R5_CANCEL_AFTER,
+        # The controller sends TERM to the CLI, which then exits by that signal.
+        expected_exit=-15,
+        expected_reason="interrupted",
+    )
+    missing = _download(
+        cli,
+        vm,
+        "r5-missing-artifact",
+        f"{R5_ROOT}/does-not-exist",
+        downloads / "missing-artifact.bin",
+        exit_=1,
+    )
+    online = f"online {ONLINE['url']} {ONLINE['sha256']}"
+    return [
+        _health(cli, vm, "r5-health"),
+        _guest(cli, vm, "r5-bootstrap-dir", R5_OBSERVE, f"mkdir -p {R5_ROOT}"),
+        upload("guest.sh"),
+        upload("lesson"),
+        case("inventory", R5_INVENTORY, "inventory"),
+        case("install", R5_OBSERVE, "install"),
+        case("intact", R5_OBSERVE, "intact"),
+        *(download(name) for name in ("stdout.bin", "stderr.bin", "artifact.bin", "status.txt")),
+        case("online", R5_ONLINE, online),
+        case("nonzero", R5_OBSERVE, "nonzero"),
+        case("bad-install", R5_OBSERVE, "bad-install"),
+        case("timeout", GUEST_TIMEOUT, "timeout"),
+        case("observe-timeout", R5_OBSERVE, "observe"),
+        cancel,
+        case("observe-cancel", R5_OBSERVE, "observe"),
+        download("timeout.partial"),
+        download("cancel.partial"),
+        missing,
+        case("guest-cleanup", R5_OBSERVE, "cleanup"),
+        case("observe-after-cleanup", R5_OBSERVE, "observe"),
+    ]
+
+
+def _resource(run_id: str, start: tuple[str, ...], vm: str, tools: dict[str, str]) -> Resource:
+    owned = _owned(run_id, "linux", start, 0, tools)
+    cleanup = Call("cleanup", _exec(tools["cli"], vm, CLEANUP_GUEST, FINAL_CLEANUP), CLEANUP_BOUND)
+    return replace(owned, cleanup=cleanup)
+
+
+def plan(tools: dict[str, str], output: Path) -> Plan:
+    cli = tools["cli"]
+    run_id = uuid.uuid4().hex
+    vm = f"k204-linux-{run_id}"
+    calls = [
+        *control_calls(tools, vm, output / "k204-downloads"),
+        *r5_calls(cli, vm, FIXTURE, output / "r5-downloads"),
+    ]
+    subjects = (
+        Path(__file__),
+        HERE / "linux_k204_raw.py",
+        HERE / "linux_k204_check.py",
+        HERE / "linux_k204_run.sh",
+        HERE / "routes_k19.py",
+        HERE / "controller.py",
+        *(FIXTURE / name for name in sorted(FIXTURE_SHA256)),
+        FIXTURE / "frozen.json",
+        CHECKER,
+        REPO / "Taskfile.yml",
+        Path(cli).resolve(),
+        Path(tools["tart"]).resolve(),
+        Path(tools["python"]),
+        *sorted((AGENTS / "linux/testanyware_agent").resolve().glob("*.py")),
+    )
+    start = (cli, "vm", "start", "--platform", "linux", "--base", GOLDEN, "--id", vm, "--json")
+    return Plan(
+        run_id,
+        tuple(calls),
+        resources=(_resource(run_id, start, vm, tools),),
+        subjects=subjects,
+    )
+
+
+def fixture_mismatches(fixture: Path) -> list[str]:
+    """Name each retained fixture file whose hash differs from the frozen r5 hash."""
+    expected = {**FIXTURE_SHA256, "frozen.json": FROZEN_SHA256}
+    mismatches: list[str] = []
+    for name, digest in expected.items():
+        path = fixture / name
+        actual = hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None
+        if actual != digest:
+            mismatches.append(f"{name}: {actual} != {digest}")
+    return mismatches
+
+
+def main() -> None:
+    import shutil
+
+    output = Path(sys.argv[1]).resolve()
+    cli, tart = shutil.which("testanyware"), shutil.which("tart")
+    if cli is None or tart is None:
+        raise SystemExit("unavailable prerequisite: testanyware and tart must be on PATH")
+    mismatches = fixture_mismatches(FIXTURE)
+    if mismatches:
+        raise SystemExit(f"retained fixture differs from frozen r5: {mismatches}")
+    tools = {"python": sys.executable, "cli": cli, "tart": tart}
+    output.mkdir(parents=True, exist_ok=False)
+    (output / "k204-downloads").mkdir()
+    (output / "r5-downloads").mkdir()
+    frozen = plan(tools, output)
+    write_json(
+        output / "inventory.json",
+        {
+            "leaf": LEAF,
+            "golden": GOLDEN,
+            "rule": "one plan, run once; no retry; failed samples stay",
+            "fixture_sha256": {**FIXTURE_SHA256, "frozen.json": FROZEN_SHA256},
+            "bounds": {
+                "boot": BOOT,
+                "health": HEALTH,
+                "guest_timeout": GUEST_TIMEOUT,
+                "host_margin": HOST_MARGIN,
+                "observe_guest": OBSERVE_GUEST,
+                "observe_bound": OBSERVE_BOUND,
+                "cleanup_guest": CLEANUP_GUEST,
+                "cleanup_bound": CLEANUP_BOUND,
+                "transfer": TRANSFER,
+                "dispose": DISPOSE,
+                "r5_observe": R5_OBSERVE,
+                "r5_inventory": R5_INVENTORY,
+                "r5_online": R5_ONLINE,
+                "r5_cancel_guest": R5_CANCEL_GUEST,
+                "r5_cancel_after": R5_CANCEL_AFTER,
+            },
+            "plan": asdict(frozen),
+        },
+    )
+    outcome = execute_outcome(frozen, output)
+    write_json(
+        output / "summary.json",
+        {
+            "verdict": outcome.verdict,
+            "run": str(outcome.run_dir),
+            "ledger": outcome.ledger,
+            "residuals": outcome.residuals,
+        },
+    )
+    print(f"verdict {outcome.verdict} run {outcome.run_dir}", flush=True)
+    if outcome.verdict is not True:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/exec-reliability/linux_k204_check.py b/experiments/exec-reliability/linux_k204_check.py
new file mode 100644
index 0000000000..6c3390a466
--- /dev/null
+++ b/experiments/exec-reliability/linux_k204_check.py
@@ -0,0 +1,665 @@ def role(name: str) -> str:
+"""Judge one linux_k204.py run against its frozen plan.
+
+    linux_k204_check.py RUN_DIR
+
+The checker gives four results:
+
+- `evidence`: complete, incomplete or absent.
+- `survival`: issue #14 failure B in the exact fork/wait controls. The value is
+  reproduced, not-reproduced or unknown.
+- `fixture_survival`: the same question for the r5 `timeout` and `cancel` children.
+  The value is listed, not-listed or unknown.
+- `stall`: issue #14 failure A, the post-timeout inspection stall. The value is
+  reproduced, not-reproduced or unknown.
+
+The Linux agent answers a deadline with exit -1, empty stdout and the stderr
+`Process timed out`. Its receipt has no timeout flag, so the CLI receipt shows
+`timed_out` false. A guest timeout is therefore exit -1 with that stderr. The field
+`timed_out` is recorded and never proves cleanup.
+
+Each guest receipt must be one typed object: schema 1.0, `ok` true, the planned
+command, an integer `exit_code`, a boolean `timed_out` and string streams. A raw
+record must have schema `k204-raw/2`, the planned request, HTTP status 200 and a
+JSON body with an integer `exitCode` and string streams. Each call has a role:
+
+- `timeout`: `cli-sleep`, `raw-sleep`, `cli-fork`, `raw-fork` and `r5-timeout`. The
+  result must be a guest timeout. The overhead is the host elapsed time minus the
+  guest timeout of 2 s. It includes the host transport, so it is an upper bound on
+  the agent's work after its deadline. An overhead above 4 s, the 2 s TERM grace
+  plus the 2 s kill/drain/reap bound, is a violation.
+- `observe`: the plan's own observations. Each must exit 0 and not time out.
+- `r5-observe`: the three r5 observations. Each must exit 0 and not time out.
+- `cleanup`: `control-cleanup`. A receipt that ends with `cleanup confirmed` and
+  exits 0 is confirmed. One that ends with `cleanup uncertain` is uncertain.
+- `ordinary`: the identity, the process tables and the r5 bootstrap. Each must exit
+  0 and not time out.
+- `health`: agent health. The CLI must exit 0, and the receipt must show a reachable
+  agent.
+- `r5`: the other r5 guest cases. The guest exit must equal the exit of the original
+  r5 run, clone 1 of `linux-03`.
+- `transfer`: the uploads and downloads. A download must hold the pinned bytes.
+  `r5-missing-artifact` must fail with a typed error receipt.
+- `cancel`: `r5-cancel`. The controller must interrupt the CLI after 2 s.
+
+An own observation prints `<label>-<role> pid=N`, the `ps` row when `ps` lists the
+PID, and `<label>-<role> ps-exit=E`. In a valid observation a PID is `present` when
+its row follows and `ps` exited 0. A present row with a stat that starts with Z is
+`zombie`. A present row whose command is not the planned process is `other`. A PID
+without a row is `absent` only when `ps` exited 1. Every other case is `unknown`.
+An r5 observation masks the `ps` status, so a missing row there is `not-listed`.
+
+A fork control reproduces failure B when its timeout is valid and the late
+observation shows its child present or zombie. The late observation runs at least
+5 s after the control returned, so a listed child outlived the 4 s bound. The
+control does not reproduce failure B when its timeout is valid and both the first
+and the late observation show its child absent. Failure B is reproduced when one
+control reproduces it. It is not reproduced when both controls do not. Every other
+case is unknown. The shell gets the same states, and a present shell in the late
+observation is a violation.
+
+An observation or an ordinary command stalls when its receipt is a guest timeout,
+when its host elapsed time exceeds its guest budget, or when the host deadline ends
+the call. A stall is admitted as a reproduction only with a valid local guest
+timeout receipt, EOF on both streams, a valid intentional timeout earlier in the
+shape and no run-level provenance failure. This is revision 3 of the k4 rule.
+
+The evidence is complete when the k186 run-level checks pass, every call of the
+shape has one record and ends as its role expects, and the ledger shows the clone
+disposed with no residual process.
+
+The checker prints one JSON object. It exits 0 when `survival` and `stall` are both
+determined and the clone was disposed. It exits 1 otherwise.
+"""
+
+import json
+import re
+import sys
+from pathlib import Path
+from typing import Any, cast
+
+from completion_k186_check import (  # the k186 host evidence checks, reused unchanged
+    _mapping,  # pyright: ignore[reportPrivateUsage]
+    _read_json,  # pyright: ignore[reportPrivateUsage]
+    _run_failures,  # pyright: ignore[reportPrivateUsage]
+)
+from linux_k204 import (
+    CONTROL_CLEANUP,
+    FINAL_CLEANUP,
+    FIXTURE,
+    FORK_LABELS,
+    GUEST_TIMEOUT,
+    ISSUE_SLEEP,
+    LATE_WAIT,
+    control_calls,
+    r5_calls,
+)
+from timeout_k4_check import (  # the k4 typed helpers, reused unchanged
+    _envelope,  # pyright: ignore[reportPrivateUsage]
+    _eof,  # pyright: ignore[reportPrivateUsage]
+    _typed,  # pyright: ignore[reportPrivateUsage]
+)
+
+GRACE = 2.0  # TERM grace bound
+REAP = 2.0  # kill/drain/reap bound
+OVERHEAD_LIMIT = GRACE + REAP
+TIMEOUT_STDERR = "Process timed out"
+RESOURCE = ("acquire", "cleanup", "dispose", "inspect")
+_PLACEHOLDER = "/vm-placeholder"
+_TOOLS = {"cli": _PLACEHOLDER, "python": _PLACEHOLDER}
+_CALLS = [
+    *control_calls(_TOOLS, _PLACEHOLDER, Path("/")),
+    *r5_calls(_PLACEHOLDER, _PLACEHOLDER, FIXTURE, Path("/")),
+]
+SHAPE = tuple(call.name for call in _CALLS)
+CONTROLS = tuple(name for name in SHAPE if not name.startswith("r5-"))
+R5 = tuple(name for name in SHAPE if name.startswith("r5-"))
+# The planned guest command and guest timeout of each `file exec` and raw call.
+RAW = ("raw-sleep", "raw-fork")
+COMMANDS = {
+    call.name: call.argv[-1] for call in _CALLS if call.argv[2] == "exec" or call.name in RAW
+}
+# The raw argv ends with the guest timeout and the command.
+GUEST_BUDGET = {
+    call.name: int(call.argv[-2] if call.name in RAW else call.argv[6])
+    for call in _CALLS
+    if call.name in COMMANDS
+}
+TIMEOUTS = ("cli-sleep", "raw-sleep", "cli-fork", "raw-fork", "r5-timeout")
+FORK_OBSERVATIONS = {label: f"observe-{label}" for label in FORK_LABELS}
+LATE = "observe-forks-late"
+AFTER_CLEANUP = "observe-after-control-cleanup"
+OWN_OBSERVATIONS = (*FORK_OBSERVATIONS.values(), LATE, AFTER_CLEANUP)
+R5_OBSERVATIONS = ("r5-observe-timeout", "r5-observe-cancel", "r5-observe-after-cleanup")
+HEALTH = ("health-before", "health-mid", "r5-health")
+# The guest path of each transfer call: the last guest-side argument.
+TRANSFERS = {
+    call.name: call.argv[6] if call.argv[2] == "upload" else call.argv[5]
+    for call in _CALLS
+    if call.argv[2] in {"upload", "download"}
+}
+# The guest exit codes of the original r5 run, clone 1 of linux-03.
+R5_ORIGINAL = {
+    "r5-inventory": 0,
+    "r5-install": 0,
+    "r5-intact": 0,
+    "r5-online": 0,
+    "r5-nonzero": 23,
+    "r5-bad-install": 1,
+    "r5-guest-cleanup": 0,
+}
+_CASES = json.loads((FIXTURE / "cases.json").read_bytes())
+# The pinned bytes of each download, by its local name.
+DOWNLOADS = {
+    **{name: bytes.fromhex(value) for name, value in _CASES["expected"].items()},
+    "timeout.partial": b"partial timeout\n",
+    "cancel.partial": b"partial cancel\n",
+    **{f"{label}.partial": b"partial-file\n" for label in FORK_LABELS},
+}
+MISSING = "r5-missing-artifact"
+_INCOMPLETENESS = ("result ok ", "unreached ")
+_RECEIPT_TYPES: dict[str, type] = {
+    "command": str,
+    "exit_code": int,
+    "timed_out": bool,
+    "stdout": str,
+    "stderr": str,
+}
+OWN_PID = re.compile(r"^(?P<label>[a-z]+-[a-z]+)-(?P<role>shell|child) pid=(?P<pid>\d+)$")
+OWN_EXIT = re.compile(r"^(?P<label>[a-z]+-[a-z]+)-(?P<role>shell|child) ps-exit=(?P<exit>\d+)$")
+OWN_UNREADABLE = re.compile(r"^(?P<label>[a-z]+-[a-z]+)-(?P<role>shell|child) pid-file=unreadable$")
+_LSTART = r"\w{3} \w{3} +\d+ \d\d:\d\d:\d\d \d{4}"
+OWN_ROW = re.compile(
+    r"^\s*(?P<pid>\d+)\s+(?P<ppid>\d+)\s+(?P<pgid>\d+)\s+(?P<sid>\d+)\s+(?P<stat>\S+)\s+"
+    rf"(?P<lstart>{_LSTART})\s+(?P<args>.*)$"
+)
+R5_PID = re.compile(r"^(?P<label>[a-z]+) pid=(?P<pid>\d+)$")
+R5_ROW = re.compile(r"^\s*(?P<pid>\d+)\s+(?P<ppid>\d+)\s+(?P<stat>\S+)\s+(?P<comm>.+)$")
+
+
+def role(name: str) -> str:
+    """Return the role of one call of the frozen shape."""
+    if name in TIMEOUTS:
+        return "timeout"
+    if name in OWN_OBSERVATIONS:
+        return "observe"
+    if name in R5_OBSERVATIONS:
+        return "r5-observe"
+    if name == "control-cleanup":
+        return "cleanup"
+    if name in HEALTH:
+        return "health"
+    if name == "r5-cancel":
+        return "cancel"
+    if name in TRANSFERS:
+        return "transfer"
+    if name in R5_ORIGINAL:
+        return "r5"
+    return "ordinary"
+
+
+def _planned(role_name: str, args: str) -> bool:
+    # ps shows each control character of the shell's argument as `?`.
+    if role_name == "child":
+        return args.strip() == ISSUE_SLEEP
+    return args.startswith("/bin/bash -c ")
+
+
+def own_processes(stdout: str) -> dict[str, dict[str, Any]]:
+    """Parse one own observation into a state for each `<label>-<role>`.
+
+    The states here are the raw parse: present, zombie, other, unlisted or unknown.
+    judge() later turns `unlisted` into `absent` or `unknown`.
+    """
+    lines = stdout.splitlines()
+    found: dict[str, dict[str, Any]] = {}
+    for index, line in enumerate(lines):
+        stripped = line.strip()
+        unreadable = OWN_UNREADABLE.match(stripped)
+        if unreadable is not None:
+            key = f"{unreadable['label']}-{unreadable['role']}"
+            found[key] = {"pid": None, "state": "unknown", "why": "pid file unreadable"}
+            continue
+        match = OWN_PID.match(stripped)
+        if match is None:
+            continue
+        key, pid = f"{match['label']}-{match['role']}", int(match["pid"])
+        state: dict[str, Any] = {"pid": pid, "state": "unknown", "ps_exit": None}
+        rest = lines[index + 1 : index + 3]
+        row = OWN_ROW.match(rest[0]) if rest else None
+        exit_line = rest[1] if row is not None and len(rest) > 1 else (rest[0] if rest else "")
+        ended = OWN_EXIT.match(exit_line.strip())
+        if ended is not None and f"{ended['label']}-{ended['role']}" == key:
+            state["ps_exit"] = int(ended["exit"])
+        if row is not None and int(row["pid"]) == pid and state["ps_exit"] == 0:
+            state |= {
+                "ppid": int(row["ppid"]),
+                "pgid": int(row["pgid"]),
+                "sid": int(row["sid"]),
+                "stat": row["stat"],
+                "lstart": row["lstart"],
+                "args": row["args"],
+            }
+            if row["stat"].startswith("Z"):
+                state["state"] = "zombie"
+            elif _planned(match["role"], row["args"]):
+                state["state"] = "present"
+            else:
+                state["state"] = "other"
+        elif row is None and state["ps_exit"] == 1:
+            state["state"] = "unlisted"
+        found[key] = state
+    return found
+
+
+def r5_children(stdout: str) -> dict[str, dict[str, Any]]:
+    """Parse one r5 observation: `<label> pid=N` and the masked `ps` row after it."""
+    lines = stdout.splitlines()
+    found: dict[str, dict[str, Any]] = {}
+    for index, line in enumerate(lines):
+        match = R5_PID.match(line.strip())
+        if match is None:
+            continue
+        pid = int(match["pid"])
+        state: dict[str, Any] = {"pid": pid, "state": "unlisted"}
+        row = R5_ROW.match(lines[index + 1]) if index + 1 < len(lines) else None
+        if row is not None and int(row["pid"]) == pid:
+            state |= {
+                "state": "zombie" if row["stat"].startswith("Z") else "present",
+                "ppid": int(row["ppid"]),
+                "stat": row["stat"],
+                "comm": row["comm"].strip(),
+            }
+        found[match["label"]] = state
+    return found
+
+
+def _receipt(run: Path, name: str) -> dict[str, Any] | None:
+    value = _read_json(run / f"{name}.stdout")
+    return cast(dict[str, Any], value) if isinstance(value, dict) else None
+
+
+def receipt_failures(receipt: dict[str, Any] | None, command: str | None) -> list[str]:
+    """Name each way that one guest exec receipt is not the typed planned receipt."""
+    if receipt is None:
+        return ["receipt absent or not one JSON object"]
+    failures: list[str] = []
+    if receipt.get("schema_version") != "1.0" or receipt.get("ok") is not True:
+        failures.append(f"receipt {receipt.get('schema_version')!r}/ok {receipt.get('ok')!r}")
+    for field, kind in _RECEIPT_TYPES.items():
+        if not _typed(receipt.get(field), kind):
+            failures.append(f"receipt {field} {receipt.get(field)!r} is not {kind.__name__}")
+    if command is not None and receipt.get("command") != command:
+        failures.append("receipt command differs from the plan")
+    return failures
+
+
+def raw_receipt(
+    record: dict[str, Any] | None, name: str
+) -> tuple[dict[str, Any] | None, list[str]]:
+    """Turn one raw record into the guest receipt fields, and name each record failure.
+
+    The receipt gets `exit_code` from `exitCode` and has no `timed_out` field, as the
+    agent sends none.
+    """
+    if record is None:
+        return None, ["raw record absent or not one JSON object"]
+    failures: list[str] = []
+    if record.get("schema") != "k204-raw/2":
+        failures.append(f"raw schema {record.get('schema')!r}")
+    planned = {"command": COMMANDS[name], "timeout": GUEST_BUDGET[name]}
+    if record.get("request") != planned:
+        failures.append("raw request differs from the plan")
+    if record.get("http_status") != 200 or record.get("error") is not None:
+        failures.append(f"raw http {record.get('http_status')!r}, error {record.get('error')!r}")
+    body = record.get("body")
+    if not isinstance(body, dict):
+        failures.append("raw body is not one JSON object")
+        return None, failures
+    fields = cast(dict[str, Any], body)
+    receipt = {
+        "command": COMMANDS[name],
+        "exit_code": fields.get("exitCode"),
+        "timed_out": None,
+        "stdout": fields.get("stdout"),
+        "stderr": fields.get("stderr"),
+        "raw_seconds": record.get("seconds"),
+    }
+    if not _typed(receipt["exit_code"], int):
+        failures.append(f"raw exitCode {receipt['exit_code']!r} is not int")
+    for stream in ("stdout", "stderr"):
+        if not isinstance(receipt[stream], str):
+            failures.append(f"raw {stream} {receipt[stream]!r} is not str")
+    return receipt, failures
+
+
+def _guest_timeout(receipt: dict[str, Any] | None) -> bool:
+    if receipt is None:
+        return False
+    return receipt.get("timed_out") is True or (
+        receipt.get("exit_code") == -1 and receipt.get("stderr") == TIMEOUT_STDERR
+    )
+
+
+def _transfer(run: Path, name: str, receipt: dict[str, Any] | None) -> list[str]:
+    if name == MISSING:
+        failures = _envelope(receipt, ok=False)
+        if not failures and cast(dict[str, Any], receipt).get("code") != "DOWNLOAD_FAILED":
+            failures.append(f"error code {cast(dict[str, Any], receipt).get('code')!r}")
+        return failures
+    failures = _envelope(receipt, ok=True)
+    if failures:
+        return failures
+    fields = cast(dict[str, Any], receipt)
+    if fields.get("remote") != TRANSFERS[name]:
+        failures.append(f"remote {fields.get('remote')!r}, expected {TRANSFERS[name]!r}")
+    size = fields.get("bytes")
+    if not _typed(size, int):
+        failures.append(f"bytes {size!r} is not int")
+    remote_name = TRANSFERS[name].rsplit("/", 1)[1]
+    if name.startswith("r5-upload-"):
+        if size != len((FIXTURE / remote_name).read_bytes()):
+            failures.append(f"bytes {size!r} differ from the fixture {remote_name}")
+        return failures
+    if name.startswith("r5-download-"):
+        local_name, folder = remote_name, "r5-downloads"
+    else:
+        label = name.removeprefix("download-").removesuffix("-partial")
+        local_name, folder = f"{label}.partial", "k204-downloads"
+    local = run.parent / folder / local_name
+    actual = local.read_bytes() if local.is_file() else None
+    if actual is None or actual != DOWNLOADS[local_name]:
+        failures.append(f"download {local_name} differs from the pinned bytes")
+    elif size != len(actual):
+        failures.append(f"bytes {size!r}, local file {len(actual)}")
+    return failures
+
+
+def _expected_exits(name: str) -> set[int]:
+    kind = role(name)
+    if kind == "timeout":
+        return {-1}
+    if kind == "r5":
+        return {R5_ORIGINAL[name]}
+    return {0}
+
+
+def judge(
+    name: str, call: dict[str, Any], record: dict[str, Any] | None, run: Path | None = None
+) -> dict[str, Any]:
+    """Judge one call record and its receipt by the role of the call.
+
+    `local` holds the failures of the host call, the streams and the receipt type.
+    `failures` adds the failures of the expected outcome.
+    """
+    kind = role(name)
+    elapsed = call.get("elapsed")
+    elapsed = float(elapsed) if isinstance(elapsed, (int, float)) else None
+    local: list[str] = []
+    receipt = record
+    if name in RAW:
+        receipt, raw_failures = raw_receipt(record, name)
+        local.extend(raw_failures)
+    sample: dict[str, Any] = {
+        "role": kind,
+        "reason": call.get("reason"),
+        "returncode": call.get("returncode"),
+        "started_monotonic": call.get("started_monotonic"),
+        "elapsed": elapsed,
+        "exit_code": None if receipt is None else receipt.get("exit_code"),
+        "timed_out": None if receipt is None else receipt.get("timed_out"),
+        "stdout": None if receipt is None else receipt.get("stdout"),
+        "stderr": None if receipt is None else receipt.get("stderr"),
+        "local": local,
+        "failures": [],
+        "violations": [],
+    }
+    if name in RAW and receipt is not None:
+        sample["raw_seconds"] = receipt.get("raw_seconds")
+    guest = name in COMMANDS and kind != "cancel"
+    if call.get("ok") is not True and kind != "cancel":
+        local.append(f"call ok {call.get('ok')!r}, reason {call.get('reason')!r}")
+    if kind != "cancel":
+        local.extend(_eof(call))
+    if guest and name not in RAW:
+        local.extend(receipt_failures(record, COMMANDS[name]))
+    elif kind == "health":
+        local.extend(_envelope(record, ok=True))
+        if record is not None and record.get("reachable") is not True:
+            local.append(f"health reachable {record.get('reachable')!r}")
+    elif kind == "transfer":
+        local.extend(_transfer(run or Path("/nonexistent"), name, record))
+    failures: list[str] = sample["failures"]
+    failures.extend(local)
+    timeout = _guest_timeout(receipt)
+    exit_code = sample["exit_code"]
+    if guest:
+        if kind != "timeout" and timeout:
+            failures.append(f"guest timeout {exit_code!r}/{sample['stderr']!r}")
+        if exit_code not in _expected_exits(name):
+            failures.append(f"exit {exit_code!r}, expected {sorted(_expected_exits(name))}")
+    if kind == "r5":
+        sample["original_exit_code"] = R5_ORIGINAL[name]
+    if kind == "timeout":
+        if not timeout:
+            failures.append(f"no guest timeout: {exit_code!r}/{sample['stderr']!r}")
+        for field, value in (("overhead", elapsed), ("raw_overhead", sample.get("raw_seconds"))):
+            if not isinstance(value, (int, float)):
+                continue
+            sample[field] = round(float(value) - GUEST_TIMEOUT, 3)
+            if sample[field] > OVERHEAD_LIMIT:
+                sample["violations"].append(
+                    f"{field} {sample[field]:.3f} s above {OVERHEAD_LIMIT:g} s"
+                )
+    if kind in {"observe", "r5-observe", "ordinary", "cleanup"}:
+        sample["stalled"] = (
+            timeout
+            or (elapsed is not None and elapsed > GUEST_BUDGET.get(name, GUEST_TIMEOUT))
+            or call.get("reason") == "deadline"
+        )
+        sample["local_stall"] = sample["stalled"] and not local and timeout
+    valid = not failures and not sample.get("stalled", False)
+    if kind == "observe":
+        processes = own_processes(str(sample["stdout"] or ""))
+        for state in processes.values():
+            if state["state"] == "unlisted":
+                state["state"] = "absent" if valid else "unknown"
+            elif not valid:
+                state["state"] = "unknown"
+        sample["processes"] = processes
+    if kind == "r5-observe":
+        children = r5_children(str(sample["stdout"] or ""))
+        for state in children.values():
+            if not valid:
+                state["state"] = "unknown"
+            elif state["state"] == "unlisted":
+                state["state"] = "not-listed"
+        sample["children"] = children
+    if kind == "cleanup":
+        sample["cleanup"] = cleanup_state(call, record, CONTROL_CLEANUP)
+    if kind == "cancel":
+        sample["signals"] = call.get("signals")
+        if call.get("reason") != "interrupted" or call.get("ok") is not True:
+            failures.append(f"call ok {call.get('ok')!r}, reason {call.get('reason')!r}")
+    return sample
+
+
+def cleanup_state(
+    call: dict[str, Any] | None, receipt: dict[str, Any] | None, command: str
+) -> dict[str, Any]:
+    """Return the state of one owned cleanup: confirmed, uncertain or unknown."""
+    failures = receipt_failures(receipt, command)
+    if call is None or call.get("ok") is not True:
+        failures.append("cleanup call absent or not ok")
+    lines = str((receipt or {}).get("stdout") or "").splitlines()
+    last = lines[-1] if lines else None
+    if not failures and last == "cleanup confirmed" and (receipt or {}).get("exit_code") == 0:
+        state = "confirmed"
+    elif last == "cleanup uncertain":
+        state = "uncertain"
+    else:
+        state = "unknown"
+    return {"state": state, "lines": lines, "failures": failures}
+
+
+def _disposal(run: Path) -> list[str]:
+    summary = _mapping(_read_json(run.parent / "summary.json"))
+    failures: list[str] = []
+    entries = [_mapping(entry) for entry in cast(list[object], summary.get("ledger") or [])]
+    if not entries or any(entry.get("state") != "disposed" for entry in entries):
+        failures.append(f"ledger not disposed: {[entry.get('state') for entry in entries]}")
+    if summary.get("residuals") != []:
+        failures.append(f"residuals {summary.get('residuals')!r}")
+    return failures
+
+
+def _state(samples: dict[str, Any], observation: str, key: str) -> str:
+    processes = samples.get(observation, {}).get("processes", {})
+    return str(processes.get(key, {}).get("state", "unknown"))
+
+
+def survival(samples: dict[str, Any]) -> dict[str, Any]:
+    """Judge failure B for each fork control from its timeout and its observations."""
+    controls: dict[str, Any] = {}
+    for label in FORK_LABELS:
+        timeout = samples.get(label)
+        valid = timeout is not None and not timeout["failures"]
+        first = FORK_OBSERVATIONS[label]
+        states = {
+            role_name: {
+                "first": _state(samples, first, f"{label}-{role_name}"),
+                "late": _state(samples, LATE, f"{label}-{role_name}"),
+                "after_cleanup": _state(samples, AFTER_CLEANUP, f"{label}-{role_name}"),
+            }
+            for role_name in ("shell", "child")
+        }
+        child = states["child"]
+        if valid and child["late"] in {"present", "zombie"}:
+            result = "reproduced"
+        elif valid and child["first"] == "absent" and child["late"] == "absent":
+            result = "not-reproduced"
+        else:
+            result = "unknown"
+        violations = [
+            f"{role_name} {states[role_name]['late']} {LATE_WAIT} s after the control returned"
+            for role_name in ("shell", "child")
+            if states[role_name]["late"] in {"present", "zombie"}
+        ]
+        controls[label] = {
+            "timeout_valid": valid,
+            "states": states,
+            "result": result,
+            "violations": violations,
+        }
+    results = {control["result"] for control in controls.values()}
+    if "reproduced" in results:
+        overall = "reproduced"
+    elif results == {"not-reproduced"}:
+        overall = "not-reproduced"
+    else:
+        overall = "unknown"
+    return {"result": overall, "controls": controls}
+
+
+def fixture_survival(samples: dict[str, Any]) -> dict[str, Any]:
+    """Report the r5 `timeout` and `cancel` children in each r5 observation."""
+    seen = {
+        name: {
+            label: state.get("state")
+            for label, state in samples.get(name, {}).get("children", {}).items()
+        }
+        for name in R5_OBSERVATIONS
+    }
+    timeout = samples.get("r5-timeout")
+    states = {seen["r5-observe-timeout"].get("timeout"), seen["r5-observe-cancel"].get("timeout")}
+    if timeout is None or timeout["failures"]:
+        result = "unknown"
+    elif states & {"present", "zombie"}:
+        result = "listed"
+    elif states == {"not-listed"}:
+        result = "not-listed"
+    else:
+        result = "unknown"
+    return {"result": result, "observations": seen}
+
+
+def check(run: Path) -> dict[str, Any]:
+    """Judge one run directory and return the checker's JSON object."""
+    failures: list[str] = []
+    result = _read_json(run / "result.json")
+    if not isinstance(result, dict):
+        failures.append("result.json is not one JSON object")
+        result = {}
+    result = cast(dict[str, Any], result)
+    records = [
+        cast(dict[str, Any], c)
+        for c in cast(list[object], result.get("calls") or [])
+        if isinstance(c, dict)
+    ]
+    names: list[object] = [record.get("name") for record in records]
+    if result:
+        failures.extend(_run_failures(run, result, names))
+    unexpected = sorted({str(name) for name in names} - set(SHAPE) - set(RESOURCE))
+    if unexpected:
+        failures.append(f"calls outside the shape {unexpected}")
+    disposal = _disposal(run)
+    by_name = {str(record.get("name")): record for record in records}
+    samples: dict[str, Any] = {}
+    for name in SHAPE:
+        call = by_name.get(name)
+        if call is not None:
+            samples[name] = judge(name, call, _receipt(run, name), run)
+    missing = [name for name in SHAPE if name not in samples]
+    failed = [name for name, sample in samples.items() if sample["failures"]]
+    stalled = [name for name in SHAPE if samples.get(name, {}).get("stalled") is True]
+    provenance = [f for f in failures if not f.startswith(_INCOMPLETENESS)]
+    admitted: list[str] = []
+    for index, name in enumerate(SHAPE):
+        earlier = [samples.get(prior) for prior in SHAPE[:index] if prior in TIMEOUTS]
+        timeout = any(prior is not None and not prior["failures"] for prior in earlier)
+        if samples.get(name, {}).get("local_stall") is True and timeout and not provenance:
+            admitted.append(name)
+    complete = not failures and not missing and not failed and not disposal
+    observed = all(name in samples for name in (*OWN_OBSERVATIONS, *R5_OBSERVATIONS))
+    if admitted:
+        stall = "reproduced"
+    elif complete and not stalled and observed:
+        stall = "not-reproduced"
+    else:
+        stall = "unknown"
+    forks = survival(samples)
+    violations = {n: s["violations"] for n, s in samples.items() if s["violations"]}
+    for label, control in forks["controls"].items():
+        if control["violations"]:
+            violations.setdefault(LATE, []).extend(f"{label} {v}" for v in control["violations"])
+    return {
+        "run": str(run),
+        "checker_revision": 1,
+        "evidence": "absent" if not result else "complete" if complete else "incomplete",
+        "survival": forks["result"],
+        "fork_controls": forks["controls"],
+        "fixture_survival": fixture_survival(samples),
+        "stall": stall,
+        "stalled": stalled,
+        "admitted": admitted,
+        "violations": violations,
+        "missing": missing,
+        "failed": failed,
+        "run_failures": failures,
+        "provenance_failures": provenance,
+        "disposal_failures": disposal,
+        "control_cleanup": samples.get("control-cleanup", {}).get("cleanup"),
+        "cleanup": cleanup_state(by_name.get("cleanup"), _receipt(run, "cleanup"), FINAL_CLEANUP),
+        "unreached": result.get("unreached"),
+        "samples": samples,
+    }
+
+
+def main() -> int:
+    report = check(Path(sys.argv[1]))
+    print(json.dumps(report, indent=2))
+    determined = {report["survival"], report["stall"]} <= {"reproduced", "not-reproduced"}
+    return 0 if determined and not report["disposal_failures"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/exec-reliability/linux_k204_raw.py b/experiments/exec-reliability/linux_k204_raw.py
new file mode 100644
index 0000000000..58bd338746
--- /dev/null
+++ b/experiments/exec-reliability/linux_k204_raw.py
@@ -0,0 +1,107 @@ def spec_path(vm: str) -> Path:
+"""Send one exec request straight to the Linux agent of one VM (leaf linux-timeout-live-k204).
+
+    linux_k204_raw.py VM GUEST_TIMEOUT COMMAND
+
+The script reads the agent address from the VM spec that `testanyware vm start` wrote.
+It posts `{"command": COMMAND, "timeout": GUEST_TIMEOUT}` to `/exec` once, without the
+Host CLI. The HTTP timeout is the guest timeout plus 10 s, the buffer of the Host CLI.
+It prints one JSON record: the request, the monotonic times, the HTTP status, the raw
+body bytes as hex, the parsed body and any transport error.
+
+The platform binary `/usr/bin/curl` makes the connection. macOS Local Network privacy
+refuses a connection to the guest network from this interpreter with errno 65. A
+platform binary connects (docs/research/macos-local-network-platform-binary-exemption.md).
+Attempt 01 of k204 recorded that refusal for the earlier urllib transport.
+
+The script exits 0 whenever it prints the record, also for a transport error. The
+checker judges the record, so the controller never stops the plan at a raw call. The
+script exits 2 for a bad argument list.
+"""
+
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+HTTP_BUFFER = 10  # the Host CLI adds 10 s to the guest timeout for its HTTP layer
+CURL = "/usr/bin/curl"
+STATUS_MARK = "k204-http-status="
+
+
+def spec_path(vm: str) -> Path:
+    """Return the VM spec path that the Host CLI writes, under the XDG state directory."""
+    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
+    return Path(state) / "testanyware" / "vms" / f"{vm}.json"
+
+
+def exchange(vm: str, guest_timeout: int, command: str) -> dict[str, Any]:
+    path = spec_path(vm)
+    request_body = {"command": command, "timeout": guest_timeout}
+    record: dict[str, Any] = {
+        "schema": "k204-raw/2",
+        "transport": CURL,
+        "vm": vm,
+        "spec_path": str(path),
+        "request": request_body,
+        "http_timeout": guest_timeout + HTTP_BUFFER,
+        "http_status": None,
+        "body_hex": None,
+        "body": None,
+        "error": None,
+    }
+    try:
+        spec_bytes = path.read_bytes()
+        record["spec_sha256"] = hashlib.sha256(spec_bytes).hexdigest()
+        agent = json.loads(spec_bytes)["agent"]
+        url = f"http://{agent['host']}:{int(agent['port'])}/exec"
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        record["error"] = f"spec: {type(error).__name__}: {error}"
+        return record
+    record["url"] = url
+    data = json.dumps(request_body).encode()
+    limit = guest_timeout + HTTP_BUFFER
+    argv = [CURL, "-sS", "--max-time", str(limit), "-H", "Content-Type: application/json"]
+    argv += ["--data-binary", "@-", "-o", "-", "-w", f"%{{stderr}}{STATUS_MARK}%{{http_code}}\\n"]
+    record["started_monotonic_ns"] = time.monotonic_ns()
+    raw: bytes | None = None
+    try:
+        done = subprocess.run([*argv, url], input=data, capture_output=True, timeout=limit + 5)
+    except (OSError, subprocess.SubprocessError) as error:
+        record["error"] = f"transport: {type(error).__name__}: {error}"
+    else:
+        stderr = done.stderr.decode(errors="replace")
+        record["curl_exit"] = done.returncode
+        record["curl_stderr"] = stderr
+        marks = [line for line in stderr.splitlines() if line.startswith(STATUS_MARK)]
+        status = marks[-1].removeprefix(STATUS_MARK) if marks else ""
+        if status.isdigit() and int(status) > 0:
+            record["http_status"] = int(status)
+            raw = done.stdout
+        if done.returncode != 0:
+            record["error"] = f"transport: curl exit {done.returncode}: {stderr.strip()}"
+    record["ended_monotonic_ns"] = time.monotonic_ns()
+    record["seconds"] = (record["ended_monotonic_ns"] - record["started_monotonic_ns"]) / 1e9
+    if raw is not None:
+        record["body_hex"] = raw.hex()
+        try:
+            record["body"] = json.loads(raw)
+        except ValueError as error:
+            record["error"] = f"body: {type(error).__name__}: {error}"
+    return record
+
+
+def main() -> int:
+    if len(sys.argv) != 4 or not sys.argv[2].isdigit():
+        print(__doc__, file=sys.stderr)
+        return 2
+    record = exchange(sys.argv[1], int(sys.argv[2]), sys.argv[3])
+    print(json.dumps(record, indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/exec-reliability/linux_k204_run.sh b/experiments/exec-reliability/linux_k204_run.sh
new file mode 100755
index 0000000000..7a36bb4262
--- /dev/null
+++ b/experiments/exec-reliability/linux_k204_run.sh
@@ -0,0 +1,54 @@
+#!/bin/sh
+# One live Linux timeout lifecycle run on one Linux clone (leaf linux-timeout-live-k204).
+# Usage: linux_k204_run.sh OUT
+# The outer records read only: inventories, source identity, host identity and agent bundle.
+# tooling-before.sha256 and tooling-after.sha256 hold the digests of the tools that decide
+# the outcome. The first is taken before the probe, the second after the receipt check.
+# The probe verdict is True only when every call ends as planned. A guest timeout gives
+# host exit 0, so verdict True can still go with a reproduced failure.
+# The script exits 0 only when the probe exits 0 with verdict True, the receipt check
+# exits 0 and the two tool digest lists are equal. Otherwise it exits 1.
+set -u
+OUT=$1
+test ! -e "$OUT" && test ! -e "$OUT-outer" || { echo "refusing an existing OUT: $OUT" >&2; exit 2; }
+HERE=experiments/exec-reliability
+FIXTURE=$HERE/evidence/linux-timeout-live-k204/fixture-r5
+BUNDLE=/opt/homebrew/opt/testanyware/share/testanyware/agents/linux/testanyware_agent
+TOOLS="$HERE/linux_k204_run.sh $HERE/linux_k204.py $HERE/linux_k204_check.py
+$HERE/linux_k204_raw.py $HERE/completion_k186_check.py $HERE/timeout_k4_check.py
+$HERE/timeout_k4.py $HERE/routes_k19.py $FIXTURE/guest.sh $FIXTURE/lesson $FIXTURE/cases.json
+$FIXTURE/frozen.json $HERE/controller.py $HERE/pyproject.toml $HERE/uv.lock
+scripts/vm_inventory.py Taskfile.yml"
+mkdir -p "$OUT-outer"
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-before.sha256"
+jj log -r @- --no-graph -T 'commit_id ++ "\n"' > "$OUT-outer/source-commit"
+jj diff --git > "$OUT-outer/source-dirty.diff"
+testanyware --version > "$OUT-outer/cli-version"
+tart --version > "$OUT-outer/tart-version"
+shasum -a 256 "$BUNDLE"/*.py > "$OUT-outer/bundle-agent.sha256"
+shasum -a 256 agents/linux/testanyware_agent/*.py > "$OUT-outer/checkout-agent.sha256"
+sysctl hw.ncpu hw.activecpu hw.memsize > "$OUT-outer/host-sysctl"
+tart list --format json > "$OUT-outer/tart-before.json"
+testanyware vm list --json --all > "$OUT-outer/vm-before.json"
+uv run --project "$HERE" --locked python "$HERE/linux_k204.py" "$OUT" > "$OUT-outer/probe.stdout" 2> "$OUT-outer/probe.stderr"
+echo $? > "$OUT-outer/probe.exit"
+tart list --format json > "$OUT-outer/tart-after.json"
+testanyware vm list --json --all > "$OUT-outer/vm-after.json"
+RUN=$(sed -n 's/^verdict .* run //p' "$OUT-outer/probe.stdout")
+if test -n "$RUN"; then
+  uv run --project "$HERE" --locked python "$HERE/linux_k204_check.py" "$RUN" > "$OUT-outer/check.json"
+  echo $? > "$OUT-outer/check.exit"
+else
+  echo "no run directory in probe output" > "$OUT-outer/check.exit"
+fi
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-after.sha256"
+cat "$OUT-outer/probe.stdout" "$OUT-outer/probe.exit"
+STATUS=0
+test "$(cat "$OUT-outer/probe.exit")" = 0 || { echo "probe exit $(cat "$OUT-outer/probe.exit")" >&2; STATUS=1; }
+grep -q '^verdict True run ' "$OUT-outer/probe.stdout" || { echo "probe verdict is not True" >&2; STATUS=1; }
+test "$(cat "$OUT-outer/check.exit")" = 0 || { echo "receipt check exit $(cat "$OUT-outer/check.exit")" >&2; STATUS=1; }
+cmp -s "$OUT-outer/tooling-before.sha256" "$OUT-outer/tooling-after.sha256" || { echo "tool digests changed during the run" >&2; STATUS=1; }
+echo "$STATUS" > "$OUT-outer/run.exit"
+exit "$STATUS"
