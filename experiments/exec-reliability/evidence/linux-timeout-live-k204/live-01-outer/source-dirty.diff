+def role(name: str) -> str:
+    """Return the role of one call of the frozen shape."""
+    if name in TIMEOUTS:
+        return "timeout"
+    if name in OWN_OBSERVATIONS:
+        return "observe"
+    if name in R5_OBSERVATIONS:
+        return "r5-observe"
+    if name == "control-cleanup":
+        return "cleanup"
+    if name in HEALTH:
+        return "health"
+    if name == "r5-cancel":
+        return "cancel"
+    if name in TRANSFERS:
+        return "transfer"
+    if name in R5_ORIGINAL:
+        return "r5"
