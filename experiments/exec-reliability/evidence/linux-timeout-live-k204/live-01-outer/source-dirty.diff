+
+
+def _planned(role_name: str, args: str) -> bool:
+    # ps shows each control character of the shell's argument as `?`.
+    if role_name == "child":
+        return args.strip() == ISSUE_SLEEP
+    return args.startswith("/bin/bash -c ")
+
+
+def own_processes(stdout: str) -> dict[str, dict[str, Any]]:
+    """Parse one own observation into a state for each `<label>-<role>`.
+
+    The states here are the raw parse: present, zombie, other, unlisted or unknown.
+    judge() later turns `unlisted` into `absent` or `unknown`.
+    """
+    lines = stdout.splitlines()
+    found: dict[str, dict[str, Any]] = {}
+    for index, line in enumerate(lines):
+        stripped = line.strip()
+        unreadable = OWN_UNREADABLE.match(stripped)
+        if unreadable is not None:
+            key = f"{unreadable['label']}-{unreadable['role']}"
+            found[key] = {"pid": None, "state": "unknown", "why": "pid file unreadable"}
+            continue
+        match = OWN_PID.match(stripped)
+        if match is None:
+            continue
+        key, pid = f"{match['label']}-{match['role']}", int(match["pid"])
+        state: dict[str, Any] = {"pid": pid, "state": "unknown", "ps_exit": None}
+        rest = lines[index + 1 : index + 3]
+        row = OWN_ROW.match(rest[0]) if rest else None
+        exit_line = rest[1] if row is not None and len(rest) > 1 else (rest[0] if rest else "")
+        ended = OWN_EXIT.match(exit_line.strip())
+        if ended is not None and f"{ended['label']}-{ended['role']}" == key:
+            state["ps_exit"] = int(ended["exit"])
+        if row is not None and int(row["pid"]) == pid and state["ps_exit"] == 0:
+            state |= {
+                "ppid": int(row["ppid"]),
+                "pgid": int(row["pgid"]),
+                "sid": int(row["sid"]),
+                "stat": row["stat"],
+                "lstart": row["lstart"],
+                "args": row["args"],
+            }
+            if row["stat"].startswith("Z"):
+                state["state"] = "zombie"
+            elif _planned(match["role"], row["args"]):
+                state["state"] = "present"
+            else:
+                state["state"] = "other"
+        elif row is None and state["ps_exit"] == 1:
+            state["state"] = "unlisted"
+        found[key] = state
+    return found
+
+
+def r5_children(stdout: str) -> dict[str, dict[str, Any]]:
+    """Parse one r5 observation: `<label> pid=N` and the masked `ps` row after it."""
+    lines = stdout.splitlines()
+    found: dict[str, dict[str, Any]] = {}
+    for index, line in enumerate(lines):
+        match = R5_PID.match(line.strip())
+        if match is None:
+            continue
+        pid = int(match["pid"])
+        state: dict[str, Any] = {"pid": pid, "state": "unlisted"}
+        row = R5_ROW.match(lines[index + 1]) if index + 1 < len(lines) else None
+        if row is not None and int(row["pid"]) == pid:
+            state |= {
+                "state": "zombie" if row["stat"].startswith("Z") else "present",
+                "ppid": int(row["ppid"]),
+                "stat": row["stat"],
+                "comm": row["comm"].strip(),
+            }
+        found[match["label"]] = state
+    return found
+
+
+def _receipt(run: Path, name: str) -> dict[str, Any] | None:
+    value = _read_json(run / f"{name}.stdout")
+    return cast(dict[str, Any], value) if isinstance(value, dict) else None
+
+
+def receipt_failures(receipt: dict[str, Any] | None, command: str | None) -> list[str]:
+    """Name each way that one guest exec receipt is not the typed planned receipt."""
+    if receipt is None:
+        return ["receipt absent or not one JSON object"]
+    failures: list[str] = []
+    if receipt.get("schema_version") != "1.0" or receipt.get("ok") is not True:
+        failures.append(f"receipt {receipt.get('schema_version')!r}/ok {receipt.get('ok')!r}")
+    for field, kind in _RECEIPT_TYPES.items():
+        if not _typed(receipt.get(field), kind):
+            failures.append(f"receipt {field} {receipt.get(field)!r} is not {kind.__name__}")
+    if command is not None and receipt.get("command") != command:
+        failures.append("receipt command differs from the plan")
+    return failures
+
+
+def raw_receipt(
+    record: dict[str, Any] | None, name: str
+) -> tuple[dict[str, Any] | None, list[str]]:
+    """Turn one raw record into the guest receipt fields, and name each record failure.
+
+    The receipt gets `exit_code` from `exitCode` and has no `timed_out` field, as the
+    agent sends none.
+    """
+    if record is None:
+        return None, ["raw record absent or not one JSON object"]
+    failures: list[str] = []
+    if record.get("schema") != "k204-raw/1":
+        failures.append(f"raw schema {record.get('schema')!r}")
+    planned = {"command": COMMANDS[name], "timeout": GUEST_BUDGET[name]}
+    if record.get("request") != planned:
+        failures.append("raw request differs from the plan")
+    if record.get("http_status") != 200 or record.get("error") is not None:
+        failures.append(f"raw http {record.get('http_status')!r}, error {record.get('error')!r}")
+    body = record.get("body")
+    if not isinstance(body, dict):
+        failures.append("raw body is not one JSON object")
+        return None, failures
+    fields = cast(dict[str, Any], body)
+    receipt = {
+        "command": COMMANDS[name],
+        "exit_code": fields.get("exitCode"),
+        "timed_out": None,
+        "stdout": fields.get("stdout"),
+        "stderr": fields.get("stderr"),
+        "raw_seconds": record.get("seconds"),
+    }
+    if not _typed(receipt["exit_code"], int):
+        failures.append(f"raw exitCode {receipt['exit_code']!r} is not int")
+    for stream in ("stdout", "stderr"):
+        if not isinstance(receipt[stream], str):
+            failures.append(f"raw {stream} {receipt[stream]!r} is not str")
+    return receipt, failures
+
+
+def _guest_timeout(receipt: dict[str, Any] | None) -> bool:
+    if receipt is None:
+        return False
+    return receipt.get("timed_out") is True or (
+        receipt.get("exit_code") == -1 and receipt.get("stderr") == TIMEOUT_STDERR
+    )
+
+
+def _transfer(run: Path, name: str, receipt: dict[str, Any] | None) -> list[str]:
+    if name == MISSING:
+        failures = _envelope(receipt, ok=False)
+        if not failures and cast(dict[str, Any], receipt).get("code") != "DOWNLOAD_FAILED":
+            failures.append(f"error code {cast(dict[str, Any], receipt).get('code')!r}")
+        return failures
+    failures = _envelope(receipt, ok=True)
+    if failures:
+        return failures
+    fields = cast(dict[str, Any], receipt)
+    if fields.get("remote") != TRANSFERS[name]:
+        failures.append(f"remote {fields.get('remote')!r}, expected {TRANSFERS[name]!r}")
+    size = fields.get("bytes")
+    if not _typed(size, int):
+        failures.append(f"bytes {size!r} is not int")
+    remote_name = TRANSFERS[name].rsplit("/", 1)[1]
+    if name.startswith("r5-upload-"):
+        if size != len((FIXTURE / remote_name).read_bytes()):
+            failures.append(f"bytes {size!r} differ from the fixture {remote_name}")
+        return failures
+    if name.startswith("r5-download-"):
+        local_name, folder = remote_name, "r5-downloads"
+    else:
+        label = name.removeprefix("download-").removesuffix("-partial")
+        local_name, folder = f"{label}.partial", "k204-downloads"
+    local = run.parent / folder / local_name
+    actual = local.read_bytes() if local.is_file() else None
+    if actual is None or actual != DOWNLOADS[local_name]:
+        failures.append(f"download {local_name} differs from the pinned bytes")
+    elif size != len(actual):
+        failures.append(f"bytes {size!r}, local file {len(actual)}")
+    return failures
+
+
+def _expected_exits(name: str) -> set[int]:
+    kind = role(name)
+    if kind == "timeout":
+        return {-1}
+    if kind == "r5":
+        return {R5_ORIGINAL[name]}
+    return {0}
+
+
+def judge(
+    name: str, call: dict[str, Any], record: dict[str, Any] | None, run: Path | None = None
+) -> dict[str, Any]:
+    """Judge one call record and its receipt by the role of the call.
+
+    `local` holds the failures of the host call, the streams and the receipt type.
+    `failures` adds the failures of the expected outcome.
+    """
+    kind = role(name)
+    elapsed = call.get("elapsed")
+    elapsed = float(elapsed) if isinstance(elapsed, (int, float)) else None
+    local: list[str] = []
+    receipt = record
+    if name in RAW:
+        receipt, raw_failures = raw_receipt(record, name)
+        local.extend(raw_failures)
+    sample: dict[str, Any] = {
+        "role": kind,
+        "reason": call.get("reason"),
+        "returncode": call.get("returncode"),
+        "started_monotonic": call.get("started_monotonic"),
+        "elapsed": elapsed,
+        "exit_code": None if receipt is None else receipt.get("exit_code"),
+        "timed_out": None if receipt is None else receipt.get("timed_out"),
+        "stdout": None if receipt is None else receipt.get("stdout"),
+        "stderr": None if receipt is None else receipt.get("stderr"),
+        "local": local,
+        "failures": [],
+        "violations": [],
+    }
+    if name in RAW and receipt is not None:
+        sample["raw_seconds"] = receipt.get("raw_seconds")
+    guest = name in COMMANDS and kind != "cancel"
+    if call.get("ok") is not True and kind != "cancel":
+        local.append(f"call ok {call.get('ok')!r}, reason {call.get('reason')!r}")
+    if kind != "cancel":
+        local.extend(_eof(call))
+    if guest and name not in RAW:
+        local.extend(receipt_failures(record, COMMANDS[name]))
+    elif kind == "health":
+        local.extend(_envelope(record, ok=True))
+        if record is not None and record.get("reachable") is not True:
+            local.append(f"health reachable {record.get('reachable')!r}")
+    elif kind == "transfer":
+        local.extend(_transfer(run or Path("/nonexistent"), name, record))
+    failures: list[str] = sample["failures"]
+    failures.extend(local)
+    timeout = _guest_timeout(receipt)
+    exit_code = sample["exit_code"]
+    if guest:
+        if kind != "timeout" and timeout:
+            failures.append(f"guest timeout {exit_code!r}/{sample['stderr']!r}")
+        if exit_code not in _expected_exits(name):
+            failures.append(f"exit {exit_code!r}, expected {sorted(_expected_exits(name))}")
+    if kind == "r5":
+        sample["original_exit_code"] = R5_ORIGINAL[name]
+    if kind == "timeout":
+        if not timeout:
+            failures.append(f"no guest timeout: {exit_code!r}/{sample['stderr']!r}")
+        for field, value in (("overhead", elapsed), ("raw_overhead", sample.get("raw_seconds"))):
+            if not isinstance(value, (int, float)):
+                continue
+            sample[field] = round(float(value) - GUEST_TIMEOUT, 3)
+            if sample[field] > OVERHEAD_LIMIT:
+                sample["violations"].append(
+                    f"{field} {sample[field]:.3f} s above {OVERHEAD_LIMIT:g} s"
+                )
+    if kind in {"observe", "r5-observe", "ordinary", "cleanup"}:
+        sample["stalled"] = (
+            timeout
+            or (elapsed is not None and elapsed > GUEST_BUDGET.get(name, GUEST_TIMEOUT))
+            or call.get("reason") == "deadline"
+        )
+        sample["local_stall"] = sample["stalled"] and not local and timeout
+    valid = not failures and not sample.get("stalled", False)
+    if kind == "observe":
+        processes = own_processes(str(sample["stdout"] or ""))
+        for state in processes.values():
+            if state["state"] == "unlisted":
+                state["state"] = "absent" if valid else "unknown"
+            elif not valid:
+                state["state"] = "unknown"
+        sample["processes"] = processes
+    if kind == "r5-observe":
+        children = r5_children(str(sample["stdout"] or ""))
+        for state in children.values():
+            if not valid:
+                state["state"] = "unknown"
+            elif state["state"] == "unlisted":
+                state["state"] = "not-listed"
+        sample["children"] = children
+    if kind == "cleanup":
+        sample["cleanup"] = cleanup_state(call, record, CONTROL_CLEANUP)
+    if kind == "cancel":
+        sample["signals"] = call.get("signals")
+        if call.get("reason") != "interrupted" or call.get("ok") is not True:
+            failures.append(f"call ok {call.get('ok')!r}, reason {call.get('reason')!r}")
+    return sample
+
+
+def cleanup_state(
+    call: dict[str, Any] | None, receipt: dict[str, Any] | None, command: str
+) -> dict[str, Any]:
+    """Return the state of one owned cleanup: confirmed, uncertain or unknown."""
+    failures = receipt_failures(receipt, command)
+    if call is None or call.get("ok") is not True:
+        failures.append("cleanup call absent or not ok")
+    lines = str((receipt or {}).get("stdout") or "").splitlines()
+    last = lines[-1] if lines else None
+    if not failures and last == "cleanup confirmed" and (receipt or {}).get("exit_code") == 0:
+        state = "confirmed"
+    elif last == "cleanup uncertain":
+        state = "uncertain"
+    else:
+        state = "unknown"
+    return {"state": state, "lines": lines, "failures": failures}
+
+
+def _disposal(run: Path) -> list[str]:
+    summary = _mapping(_read_json(run.parent / "summary.json"))
+    failures: list[str] = []
+    entries = [_mapping(entry) for entry in cast(list[object], summary.get("ledger") or [])]
+    if not entries or any(entry.get("state") != "disposed" for entry in entries):
+        failures.append(f"ledger not disposed: {[entry.get('state') for entry in entries]}")
+    if summary.get("residuals") != []:
+        failures.append(f"residuals {summary.get('residuals')!r}")
+    return failures
+
+
+def _state(samples: dict[str, Any], observation: str, key: str) -> str:
+    processes = samples.get(observation, {}).get("processes", {})
+    return str(processes.get(key, {}).get("state", "unknown"))
+
+
+def survival(samples: dict[str, Any]) -> dict[str, Any]:
+    """Judge failure B for each fork control from its timeout and its observations."""
+    controls: dict[str, Any] = {}
+    for label in FORK_LABELS:
+        timeout = samples.get(label)
+        valid = timeout is not None and not timeout["failures"]
+        first = FORK_OBSERVATIONS[label]
+        states = {
+            role_name: {
+                "first": _state(samples, first, f"{label}-{role_name}"),
+                "late": _state(samples, LATE, f"{label}-{role_name}"),
+                "after_cleanup": _state(samples, AFTER_CLEANUP, f"{label}-{role_name}"),
+            }
+            for role_name in ("shell", "child")
+        }
+        child = states["child"]
+        if valid and child["late"] in {"present", "zombie"}:
+            result = "reproduced"
+        elif valid and child["first"] == "absent" and child["late"] == "absent":
+            result = "not-reproduced"
+        else:
+            result = "unknown"
+        violations = [
+            f"{role_name} {states[role_name]['late']} {LATE_WAIT} s after the control returned"
+            for role_name in ("shell", "child")
+            if states[role_name]["late"] in {"present", "zombie"}
+        ]
+        controls[label] = {
+            "timeout_valid": valid,
+            "states": states,
+            "result": result,
+            "violations": violations,
+        }
+    results = {control["result"] for control in controls.values()}
+    if "reproduced" in results:
+        overall = "reproduced"
+    elif results == {"not-reproduced"}:
+        overall = "not-reproduced"
+    else:
+        overall = "unknown"
+    return {"result": overall, "controls": controls}
+
+
+def fixture_survival(samples: dict[str, Any]) -> dict[str, Any]:
+    """Report the r5 `timeout` and `cancel` children in each r5 observation."""
+    seen = {
+        name: {
+            label: state.get("state")
+            for label, state in samples.get(name, {}).get("children", {}).items()
+        }
+        for name in R5_OBSERVATIONS
+    }
+    timeout = samples.get("r5-timeout")
+    states = {seen["r5-observe-timeout"].get("timeout"), seen["r5-observe-cancel"].get("timeout")}
+    if timeout is None or timeout["failures"]:
+        result = "unknown"
+    elif states & {"present", "zombie"}:
+        result = "listed"
+    elif states == {"not-listed"}:
+        result = "not-listed"
+    else:
+        result = "unknown"
+    return {"result": result, "observations": seen}
+
+
+def check(run: Path) -> dict[str, Any]:
+    """Judge one run directory and return the checker's JSON object."""
+    failures: list[str] = []
+    result = _read_json(run / "result.json")
+    if not isinstance(result, dict):
+        failures.append("result.json is not one JSON object")
+        result = {}
+    result = cast(dict[str, Any], result)
+    records = [
+        cast(dict[str, Any], c)
+        for c in cast(list[object], result.get("calls") or [])
+        if isinstance(c, dict)
+    ]
+    names: list[object] = [record.get("name") for record in records]
+    if result:
+        failures.extend(_run_failures(run, result, names))
+    unexpected = sorted({str(name) for name in names} - set(SHAPE) - set(RESOURCE))
+    if unexpected:
+        failures.append(f"calls outside the shape {unexpected}")
+    disposal = _disposal(run)
+    by_name = {str(record.get("name")): record for record in records}
+    samples: dict[str, Any] = {}
+    for name in SHAPE:
+        call = by_name.get(name)
+        if call is not None:
+            samples[name] = judge(name, call, _receipt(run, name), run)
+    missing = [name for name in SHAPE if name not in samples]
+    failed = [name for name, sample in samples.items() if sample["failures"]]
+    stalled = [name for name in SHAPE if samples.get(name, {}).get("stalled") is True]
+    provenance = [f for f in failures if not f.startswith(_INCOMPLETENESS)]
+    admitted: list[str] = []
+    for index, name in enumerate(SHAPE):
+        earlier = [samples.get(prior) for prior in SHAPE[:index] if prior in TIMEOUTS]
+        timeout = any(prior is not None and not prior["failures"] for prior in earlier)
+        if samples.get(name, {}).get("local_stall") is True and timeout and not provenance:
+            admitted.append(name)
+    complete = not failures and not missing and not failed and not disposal
+    observed = all(name in samples for name in (*OWN_OBSERVATIONS, *R5_OBSERVATIONS))
+    if admitted:
+        stall = "reproduced"
+    elif complete and not stalled and observed:
+        stall = "not-reproduced"
+    else:
+        stall = "unknown"
+    forks = survival(samples)
+    violations = {n: s["violations"] for n, s in samples.items() if s["violations"]}
+    for label, control in forks["controls"].items():
+        if control["violations"]:
+            violations.setdefault(LATE, []).extend(f"{label} {v}" for v in control["violations"])
+    return {
+        "run": str(run),
+        "checker_revision": 1,
+        "evidence": "absent" if not result else "complete" if complete else "incomplete",
+        "survival": forks["result"],
+        "fork_controls": forks["controls"],
+        "fixture_survival": fixture_survival(samples),
+        "stall": stall,
+        "stalled": stalled,
+        "admitted": admitted,
+        "violations": violations,
+        "missing": missing,
+        "failed": failed,
+        "run_failures": failures,
+        "provenance_failures": provenance,
+        "disposal_failures": disposal,
+        "control_cleanup": samples.get("control-cleanup", {}).get("cleanup"),
+        "cleanup": cleanup_state(by_name.get("cleanup"), _receipt(run, "cleanup"), FINAL_CLEANUP),
+        "unreached": result.get("unreached"),
+        "samples": samples,
+    }
+
+
+def main() -> int:
+    report = check(Path(sys.argv[1]))
+    print(json.dumps(report, indent=2))
+    determined = {report["survival"], report["stall"]} <= {"reproduced", "not-reproduced"}
+    return 0 if determined and not report["disposal_failures"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/exec-reliability/linux_k204_raw.py b/experiments/exec-reliability/linux_k204_raw.py
new file mode 100644
index 0000000000..1769110efc
--- /dev/null
+++ b/experiments/exec-reliability/linux_k204_raw.py
@@ -0,0 +1,94 @@ def spec_path(vm: str) -> Path:
+"""Send one exec request straight to the Linux agent of one VM (leaf linux-timeout-live-k204).
+
+    linux_k204_raw.py VM GUEST_TIMEOUT COMMAND
+
+The script reads the agent address from the VM spec that `testanyware vm start` wrote.
+It posts `{"command": COMMAND, "timeout": GUEST_TIMEOUT}` to `/exec` once, without the
+Host CLI. The HTTP timeout is the guest timeout plus 10 s, the buffer of the Host CLI.
+It prints one JSON record: the request, the monotonic times, the HTTP status, the raw
+body bytes as hex, the parsed body and any transport error.
+
+The script exits 0 whenever it prints the record, also for a transport error. The
+checker judges the record, so the controller never stops the plan at a raw call. The
+script exits 2 for a bad argument list.
+"""
+
+import hashlib
+import json
+import os
+import sys
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any
+
+HTTP_BUFFER = 10  # the Host CLI adds 10 s to the guest timeout for its HTTP layer
+
+
+def spec_path(vm: str) -> Path:
+    """Return the VM spec path that the Host CLI writes, under the XDG state directory."""
+    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
+    return Path(state) / "testanyware" / "vms" / f"{vm}.json"
+
+
+def exchange(vm: str, guest_timeout: int, command: str) -> dict[str, Any]:
+    path = spec_path(vm)
+    request_body = {"command": command, "timeout": guest_timeout}
+    record: dict[str, Any] = {
+        "schema": "k204-raw/1",
+        "vm": vm,
+        "spec_path": str(path),
+        "request": request_body,
+        "http_timeout": guest_timeout + HTTP_BUFFER,
+        "http_status": None,
+        "body_hex": None,
+        "body": None,
+        "error": None,
+    }
+    try:
+        spec_bytes = path.read_bytes()
+        record["spec_sha256"] = hashlib.sha256(spec_bytes).hexdigest()
+        agent = json.loads(spec_bytes)["agent"]
+        url = f"http://{agent['host']}:{int(agent['port'])}/exec"
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        record["error"] = f"spec: {type(error).__name__}: {error}"
+        return record
+    record["url"] = url
+    data = json.dumps(request_body).encode()
+    request = urllib.request.Request(
+        url, data=data, headers={"Content-Type": "application/json"}, method="POST"
+    )
+    record["started_monotonic_ns"] = time.monotonic_ns()
+    raw: bytes | None = None
+    try:
+        with urllib.request.urlopen(request, timeout=guest_timeout + HTTP_BUFFER) as response:
+            record["http_status"] = response.status
+            raw = response.read()
+    except urllib.error.HTTPError as error:
+        record["http_status"] = error.code
+        raw = error.read()
+    except (urllib.error.URLError, OSError) as error:
+        record["error"] = f"transport: {type(error).__name__}: {error}"
+    record["ended_monotonic_ns"] = time.monotonic_ns()
+    record["seconds"] = (record["ended_monotonic_ns"] - record["started_monotonic_ns"]) / 1e9
+    if raw is not None:
+        record["body_hex"] = raw.hex()
+        try:
+            record["body"] = json.loads(raw)
+        except ValueError as error:
+            record["error"] = f"body: {type(error).__name__}: {error}"
+    return record
+
+
+def main() -> int:
+    if len(sys.argv) != 4 or not sys.argv[2].isdigit():
+        print(__doc__, file=sys.stderr)
+        return 2
+    record = exchange(sys.argv[1], int(sys.argv[2]), sys.argv[3])
+    print(json.dumps(record, indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/exec-reliability/linux_k204_run.sh b/experiments/exec-reliability/linux_k204_run.sh
new file mode 100755
index 0000000000..7a36bb4262
--- /dev/null
+++ b/experiments/exec-reliability/linux_k204_run.sh
@@ -0,0 +1,54 @@
+#!/bin/sh
+# One live Linux timeout lifecycle run on one Linux clone (leaf linux-timeout-live-k204).
+# Usage: linux_k204_run.sh OUT
+# The outer records read only: inventories, source identity, host identity and agent bundle.
+# tooling-before.sha256 and tooling-after.sha256 hold the digests of the tools that decide
+# the outcome. The first is taken before the probe, the second after the receipt check.
+# The probe verdict is True only when every call ends as planned. A guest timeout gives
+# host exit 0, so verdict True can still go with a reproduced failure.
+# The script exits 0 only when the probe exits 0 with verdict True, the receipt check
+# exits 0 and the two tool digest lists are equal. Otherwise it exits 1.
+set -u
+OUT=$1
+test ! -e "$OUT" && test ! -e "$OUT-outer" || { echo "refusing an existing OUT: $OUT" >&2; exit 2; }
+HERE=experiments/exec-reliability
+FIXTURE=$HERE/evidence/linux-timeout-live-k204/fixture-r5
+BUNDLE=/opt/homebrew/opt/testanyware/share/testanyware/agents/linux/testanyware_agent
+TOOLS="$HERE/linux_k204_run.sh $HERE/linux_k204.py $HERE/linux_k204_check.py
+$HERE/linux_k204_raw.py $HERE/completion_k186_check.py $HERE/timeout_k4_check.py
+$HERE/timeout_k4.py $HERE/routes_k19.py $FIXTURE/guest.sh $FIXTURE/lesson $FIXTURE/cases.json
+$FIXTURE/frozen.json $HERE/controller.py $HERE/pyproject.toml $HERE/uv.lock
+scripts/vm_inventory.py Taskfile.yml"
+mkdir -p "$OUT-outer"
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-before.sha256"
+jj log -r @- --no-graph -T 'commit_id ++ "\n"' > "$OUT-outer/source-commit"
+jj diff --git > "$OUT-outer/source-dirty.diff"
+testanyware --version > "$OUT-outer/cli-version"
+tart --version > "$OUT-outer/tart-version"
+shasum -a 256 "$BUNDLE"/*.py > "$OUT-outer/bundle-agent.sha256"
+shasum -a 256 agents/linux/testanyware_agent/*.py > "$OUT-outer/checkout-agent.sha256"
+sysctl hw.ncpu hw.activecpu hw.memsize > "$OUT-outer/host-sysctl"
+tart list --format json > "$OUT-outer/tart-before.json"
+testanyware vm list --json --all > "$OUT-outer/vm-before.json"
+uv run --project "$HERE" --locked python "$HERE/linux_k204.py" "$OUT" > "$OUT-outer/probe.stdout" 2> "$OUT-outer/probe.stderr"
+echo $? > "$OUT-outer/probe.exit"
+tart list --format json > "$OUT-outer/tart-after.json"
+testanyware vm list --json --all > "$OUT-outer/vm-after.json"
+RUN=$(sed -n 's/^verdict .* run //p' "$OUT-outer/probe.stdout")
+if test -n "$RUN"; then
+  uv run --project "$HERE" --locked python "$HERE/linux_k204_check.py" "$RUN" > "$OUT-outer/check.json"
+  echo $? > "$OUT-outer/check.exit"
+else
+  echo "no run directory in probe output" > "$OUT-outer/check.exit"
+fi
+# shellcheck disable=SC2086 # TOOLS is a fixed list of paths without spaces.
+shasum -a 256 $TOOLS > "$OUT-outer/tooling-after.sha256"
+cat "$OUT-outer/probe.stdout" "$OUT-outer/probe.exit"
+STATUS=0
+test "$(cat "$OUT-outer/probe.exit")" = 0 || { echo "probe exit $(cat "$OUT-outer/probe.exit")" >&2; STATUS=1; }
+grep -q '^verdict True run ' "$OUT-outer/probe.stdout" || { echo "probe verdict is not True" >&2; STATUS=1; }
+test "$(cat "$OUT-outer/check.exit")" = 0 || { echo "receipt check exit $(cat "$OUT-outer/check.exit")" >&2; STATUS=1; }
+cmp -s "$OUT-outer/tooling-before.sha256" "$OUT-outer/tooling-after.sha256" || { echo "tool digests changed during the run" >&2; STATUS=1; }
+echo "$STATUS" > "$OUT-outer/run.exit"
+exit "$STATUS"
diff --git a/experiments/exec-reliability/test_linux_k204.py b/experiments/exec-reliability/test_linux_k204.py
new file mode 100644
index 0000000000..d4cce3670e
--- /dev/null
+++ b/experiments/exec-reliability/test_linux_k204.py
@@ -0,0 +1,425 @@ def _row(key: str, args: str, stat: str = "S") -> str:
+"""Controls for the k204 Linux timeout lifecycle tooling (leaf linux-timeout-live-k204).
+
+Each control builds a run directory without a VM. The run-level host evidence is the
+retained k186 result record. The calls are copies of one healthy k186 call record,
+renamed to the k204 shape. The receipts, raw records and downloads are the expected
+outcome of each role on the unchanged Linux agent. Each control then breaks one
+property and expects the checker to report it.
+"""
+
+import copy
+import json
+import shutil
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+import controller
+import linux_k204
+import linux_k204_check as checker
+
+HERE = Path(__file__).resolve().parent
+RETAINED = HERE / "evidence/k186-completion-macos-01/b1256cae4068418dac994e03f0392f6b"
+DISPOSED = {"ledger": [{"kind": "vm", "state": "disposed"}], "residuals": []}
+PIDS = {"cli-fork-shell": 900, "cli-fork-child": 901, "raw-fork-shell": 910, "raw-fork-child": 911}
+LSTART = "Wed Nov 18 03:40:00 2026"
+
+
+def _row(key: str, args: str, stat: str = "S") -> str:
+    pid = PIDS[key]
+    return f"    {pid}       1   {pid}   {pid} {stat}    {LSTART} {args}"
+
+
+def _observation(labels: tuple[str, ...], rows: dict[str, str] | None = None) -> str:
+    """Return one own observation. A key in `rows` is listed with that row."""
+    rows = rows or {}
+    lines: list[str] = []
+    for label in labels:
+        for role in ("shell", "child"):
+            key = f"{label}-{role}"
+            lines.append(f"{key} pid={PIDS[key]}")
+            if key in rows:
+                lines.extend([rows[key], f"{key} ps-exit=0"])
+            else:
+                lines.append(f"{key} ps-exit=1")
+    return "\n".join(lines)
+
+
+def _observation_stdout(name: str) -> str:
+    if name == checker.LATE or name == checker.AFTER_CLEANUP:
+        return _observation(linux_k204.FORK_LABELS)
+    return _observation((name.removeprefix("observe-"),))
+
+
+def _guest(name: str, exit_code: int, stdout: str, stderr: str = "") -> dict[str, Any]:
+    return {
+        "schema_version": "1.0",
+        "ok": True,
+        "command": checker.COMMANDS[name],
+        "exit_code": exit_code,
+        "timed_out": False,
+        "stdout": stdout,
+        "stderr": stderr,
+    }
+
+
+def _raw(name: str, exit_code: int = -1, stderr: str = checker.TIMEOUT_STDERR) -> dict[str, Any]:
+    body = {"exitCode": exit_code, "stdout": "", "stderr": stderr}
+    return {
+        "schema": "k204-raw/1",
+        "request": {"command": checker.COMMANDS[name], "timeout": checker.GUEST_BUDGET[name]},
+        "http_status": 200,
+        "body": body,
+        "error": None,
+        "seconds": 2.1,
+    }
+
+
+def _transfer(name: str) -> dict[str, Any]:
+    if name == checker.MISSING:
+        return {"schema_version": "1.0", "ok": False, "code": "DOWNLOAD_FAILED"}
+    remote = checker.TRANSFERS[name]
+    remote_name = remote.rsplit("/", 1)[1]
+    if name.startswith("r5-upload-"):
+        size = len((linux_k204.FIXTURE / remote_name).read_bytes())
+    elif name.startswith("r5-download-"):
+        size = len(checker.DOWNLOADS[remote_name])
+    else:
+        size = len(b"partial-file\n")
+    return {"schema_version": "1.0", "ok": True, "remote": remote, "bytes": size}
+
+
+def _receipt(name: str) -> dict[str, Any]:
+    """Return the expected receipt of one call of the frozen shape."""
+    kind = checker.role(name)
+    if kind == "health":
+        return {"schema_version": "1.0", "ok": True, "reachable": True, "platform": "linux"}
+    if kind == "transfer":
+        return _transfer(name)
+    if kind == "cancel":
+        return {}
+    if name in checker.RAW:
+        return _raw(name)
+    if kind == "timeout":
+        return _guest(name, -1, "", checker.TIMEOUT_STDERR)
+    if kind == "observe":
+        return _guest(name, 0, _observation_stdout(name))
+    if kind == "r5-observe":
+        return _guest(name, 0, "timeout pid=701\ncancel pid=702")
+    if kind == "cleanup":
+        return _guest(name, 0, "cli-fork-child gone\nraw-fork-child gone\ncleanup confirmed")
+    return _guest(name, checker.R5_ORIGINAL.get(name, 0), "ok")
+
+
+def _call(template: dict[str, Any], name: str) -> dict[str, Any]:
+    call = copy.deepcopy(template) | {"name": name, "elapsed": 0.2}
+    if checker.role(name) == "timeout":
+        call["elapsed"] = 2.3
+    if name == "r5-cancel":
+        call |= {"reason": "interrupted", "returncode": -15}
+    return call
+
+
+def _run(tmp_path: Path, summary: dict[str, Any] | None = None) -> Path:
+    """Build one complete clean run in the frozen k204 shape."""
+    run = tmp_path / "out" / "run"
+    run.mkdir(parents=True)
+    result = json.loads((RETAINED / "result.json").read_bytes())
+    calls = {call["name"]: call for call in result["calls"]}
+    template = calls["serial-01"]
+    shape = [_call(template, name) for name in checker.SHAPE]
+    resource = [calls[name] for name in checker.RESOURCE]
+    result["calls"] = [resource[0], *shape, *resource[1:]]
+    result["unreached"] = []
+    (run / "result.json").write_text(json.dumps(result))
+    shutil.copy(RETAINED / "storage-close.json", run / "storage-close.json")
+    for name in checker.SHAPE:
+        (run / f"{name}.stdout").write_text(json.dumps(_receipt(name)))
+    for folder in ("k204-downloads", "r5-downloads"):
+        (run.parent / folder).mkdir()
+    for local, data in checker.DOWNLOADS.items():
+        folder = (
+            "k204-downloads"
+            if local.removesuffix(".partial") in linux_k204.FORK_LABELS
+            else "r5-downloads"
+        )
+        (run.parent / folder / local).write_bytes(data)
+    (run.parent / "summary.json").write_text(json.dumps(summary or DISPOSED))
+    return run
+
+
+def _edit(run: Path, name: str, edit: Callable[[dict[str, Any]], None]) -> None:
+    path = run / "result.json"
+    result = json.loads(path.read_bytes())
+    edit(next(call for call in result["calls"] if call["name"] == name))
+    path.write_text(json.dumps(result))
+
+
+def _write(run: Path, name: str, receipt: dict[str, Any]) -> None:
+    (run / f"{name}.stdout").write_text(json.dumps(receipt))
+
+
+def _observe(run: Path, name: str, stdout: str, exit_code: int = 0, stderr: str = "") -> None:
+    _write(run, name, _guest(name, exit_code, stdout, stderr))
+
+
+def test_shape_is_frozen() -> None:
+    # The clone-1 order of the original r5 run, linux-03, between its start and its stop.
+    original = (
+        "health bootstrap-dir upload-guest-sh upload-lesson inventory install intact"
+        " download-stdout-bin download-stderr-bin download-artifact-bin download-status-txt"
+        " online nonzero bad-install timeout observe-timeout cancel observe-cancel"
+        " download-timeout-partial download-cancel-partial missing-artifact guest-cleanup"
+        " observe-after-cleanup"
+    )
+    assert checker.R5 == tuple(f"r5-{name}" for name in original.split())
+    assert checker.CONTROLS[3:8] == (
+        "cli-sleep",
+        "table-after-cli-sleep",
+        "raw-sleep",
+        "table-after-raw-sleep",
+        "cli-fork",
+    )
+    assert checker.COMMANDS["cli-sleep"] == checker.COMMANDS["raw-sleep"] == "sleep 120"
+    assert all(checker.GUEST_BUDGET[name] == 2 for name in checker.TIMEOUTS)
+
+
+def test_clean_run_is_complete_and_not_reproduced(tmp_path: Path) -> None:
+    report = checker.check(_run(tmp_path))
+    assert report["evidence"] == "complete", report["failed"] or report["run_failures"]
+    assert (report["survival"], report["stall"]) == ("not-reproduced", "not-reproduced")
+    assert report["fixture_survival"]["result"] == "not-listed"
+    assert report["control_cleanup"]["state"] == "confirmed"
+    assert report["violations"] == {}
+
+
+def test_child_listed_in_the_late_observation_reproduces_failure_b(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    rows = {"cli-fork-child": _row("cli-fork-child", "sleep 120")}
+    _observe(run, checker.LATE, _observation(linux_k204.FORK_LABELS, rows))
+    report = checker.check(run)
+    assert report["survival"] == "reproduced"
+    control = report["fork_controls"]["cli-fork"]
+    assert control["states"]["child"]["late"] == "present"
+    assert report["violations"][checker.LATE] == [
+        "cli-fork child present 5 s after the control returned"
+    ]
+    assert report["evidence"] == "complete"
+
+
+def test_zombie_child_reproduces_and_another_command_does_not(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    rows = {
+        "cli-fork-child": _row("cli-fork-child", "[sleep] <defunct>", "Z"),
+        "raw-fork-child": _row("raw-fork-child", "sshd: other"),
+    }
+    _observe(run, checker.LATE, _observation(linux_k204.FORK_LABELS, rows))
+    report = checker.check(run)
+    controls = report["fork_controls"]
+    assert controls["cli-fork"]["result"] == "reproduced"
+    assert controls["raw-fork"]["states"]["child"]["late"] == "other"
+    assert controls["raw-fork"]["result"] == "unknown"
+    assert report["survival"] == "reproduced"
+
+
+@pytest.mark.parametrize(
+    "case",
+    ["nonzero exit", "guest timeout", "ps status 2", "pid file unreadable", "absent receipt"],
+)
+def test_failed_late_observation_leaves_each_child_unknown(tmp_path: Path, case: str) -> None:
+    run = _run(tmp_path)
+    stdout = _observation(linux_k204.FORK_LABELS)
+    if case == "nonzero exit":
+        _observe(run, checker.LATE, stdout, exit_code=1)
+    elif case == "guest timeout":
+        _observe(run, checker.LATE, "", exit_code=-1, stderr=checker.TIMEOUT_STDERR)
+    elif case == "ps status 2":
+        _observe(run, checker.LATE, stdout.replace("child ps-exit=1", "child ps-exit=2"))
+    elif case == "pid file unreadable":
+        unreadable = stdout.replace("cli-fork-child pid=901\ncli-fork-child ps-exit=1", "")
+        _observe(run, checker.LATE, unreadable + "\ncli-fork-child pid-file=unreadable")
+    else:
+        (run / f"{checker.LATE}.stdout").write_text("not json")
+    report = checker.check(run)
+    assert report["fork_controls"]["cli-fork"]["states"]["child"]["late"] == "unknown"
+    assert report["survival"] == "unknown"
+
+
+def test_guest_timeout_in_an_observation_is_an_admitted_stall(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _observe(run, "observe-raw-fork", "", exit_code=-1, stderr=checker.TIMEOUT_STDERR)
+    report = checker.check(run)
+    assert report["stall"] == "reproduced"
+    assert report["admitted"] == ["observe-raw-fork"]
+    assert report["evidence"] == "incomplete"
+
+
+def test_slow_observation_without_a_guest_timeout_is_not_admitted(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _edit(run, "observe-cli-fork", lambda call: call.update(elapsed=12.0))
+    report = checker.check(run)
+    assert report["stalled"] == ["observe-cli-fork"]
+    assert (report["stall"], report["admitted"]) == ("unknown", [])
+
+
+@pytest.mark.parametrize(
+    "edit",
+    [
+        {"http_status": 500},
+        {"error": "timed out"},
+        {"body": "not an object"},
+        {"request": {"command": "sleep 120", "timeout": 3}},
+        {"schema": "k204-raw/0"},
+    ],
+)
+def test_raw_record_failure_fails_the_raw_timeout(tmp_path: Path, edit: dict[str, Any]) -> None:
+    run = _run(tmp_path)
+    _write(run, "raw-sleep", _raw("raw-sleep") | edit)
+    report = checker.check(run)
+    assert report["failed"] == ["raw-sleep"]
+    assert report["evidence"] == "incomplete"
+
+
+def test_raw_control_with_an_ordinary_exit_is_not_a_timeout(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _write(run, "raw-fork", _raw("raw-fork", exit_code=0, stderr=""))
+    report = checker.check(run)
+    assert report["fork_controls"]["raw-fork"]["timeout_valid"] is False
+    assert report["fork_controls"]["raw-fork"]["result"] == "unknown"
+    assert report["survival"] == "unknown"
+
+
+def test_timeout_without_the_agent_timeout_shape_fails(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _write(run, "cli-sleep", _guest("cli-sleep", -1, "", "Killed"))
+    assert checker.check(run)["failed"] == ["cli-sleep"]
+
+
+def test_timed_out_field_is_recorded_and_not_required(tmp_path: Path) -> None:
+    report = checker.check(_run(tmp_path))
+    assert report["samples"]["cli-sleep"]["timed_out"] is False
+    assert report["samples"]["cli-sleep"]["failures"] == []
+
+
+def test_overhead_above_four_seconds_is_a_violation(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _edit(run, "cli-fork", lambda call: call.update(elapsed=6.5))
+    raw = _raw("raw-sleep") | {"seconds": 6.1}
+    _write(run, "raw-sleep", raw)
+    report = checker.check(run)
+    assert report["violations"]["cli-fork"] == ["overhead 4.500 s above 4 s"]
+    assert report["violations"]["raw-sleep"] == ["raw_overhead 4.100 s above 4 s"]
+    assert report["evidence"] == "complete"
+
+
+@pytest.mark.parametrize(
+    ("name", "receipt"),
+    [
+        ("r5-nonzero", {"exit_code": 0}),
+        ("r5-bad-install", {"exit_code": 0}),
+        ("r5-inventory", {"exit_code": 1}),
+        ("table-before", {"exit_code": 1}),
+        ("identity", {"command": "id"}),
+        ("table-after-cli-sleep", {"exit_code": "0"}),
+    ],
+)
+def test_wrong_outcome_fails_the_call(tmp_path: Path, name: str, receipt: dict[str, Any]) -> None:
+    run = _run(tmp_path)
+    _write(run, name, _receipt(name) | receipt)
+    report = checker.check(run)
+    assert report["failed"] == [name]
+    assert report["evidence"] == "incomplete"
+
+
+def test_download_without_the_pinned_bytes_fails(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    (run.parent / "k204-downloads" / "cli-fork.partial").write_bytes(b"other\n")
+    (run.parent / "r5-downloads" / "timeout.partial").unlink()
+    report = checker.check(run)
+    assert report["failed"] == ["download-cli-fork-partial", "r5-download-timeout-partial"]
+
+
+def test_missing_artifact_must_fail_with_a_typed_error(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _write(run, checker.MISSING, {"schema_version": "1.0", "ok": True})
+    assert checker.check(run)["failed"] == [checker.MISSING]
+
+
+def test_r5_observation_listing_the_timeout_child_reports_it(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    stdout = "timeout pid=701\n    701     600 S    sleep"
+    _observe(run, "r5-observe-timeout", stdout)
+    report = checker.check(run)
+    assert report["fixture_survival"]["result"] == "listed"
+    assert report["evidence"] == "complete"
+
+
+def test_cancel_must_be_interrupted(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    _edit(run, "r5-cancel", lambda call: call.update(reason="exit", returncode=0))
+    assert checker.check(run)["failed"] == ["r5-cancel"]
+
+
+def test_undisposed_clone_or_residual_fails_disposal(tmp_path: Path) -> None:
+    summary = {"ledger": [{"kind": "vm", "state": "acquired"}], "residuals": ["vm"]}
+    report = checker.check(_run(tmp_path, summary))
+    assert len(report["disposal_failures"]) == 2
+    assert report["evidence"] == "incomplete"
+
+
+def test_missing_call_leaves_the_evidence_incomplete(tmp_path: Path) -> None:
+    run = _run(tmp_path)
+    path = run / "result.json"
+    result = json.loads(path.read_bytes())
+    result["calls"] = [call for call in result["calls"] if call["name"] != checker.LATE]
+    result["unreached"] = [checker.LATE]
+    path.write_text(json.dumps(result))
+    report = checker.check(run)
+    assert checker.LATE in report["missing"]
+    assert (report["survival"], report["stall"]) == ("unknown", "unknown")
+
+
+def test_retained_fixture_matches_and_one_changed_byte_is_refused(tmp_path: Path) -> None:
+    assert linux_k204.fixture_mismatches(linux_k204.FIXTURE) == []
+    copy_dir = tmp_path / "fixture"
+    shutil.copytree(linux_k204.FIXTURE, copy_dir)
+    data = bytearray((copy_dir / "guest.sh").read_bytes())
+    data[-2] ^= 1
+    (copy_dir / "guest.sh").write_bytes(bytes(data))
+    assert linux_k204.fixture_mismatches(copy_dir) != []
+
+
+def test_plan_freezes_the_shape_bounds_and_owned_cleanup(tmp_path: Path) -> None:
+    tools = {"cli": "/bin/echo", "tart": "/bin/echo", "python": "/usr/bin/python3"}
+    plan = linux_k204.plan(tools, tmp_path)
+    assert isinstance(plan, controller.Plan)
+    assert tuple(call.name for call in plan.calls) == checker.SHAPE
+    by_name = {call.name: call for call in plan.calls}
+    for name in checker.TIMEOUTS:
+        assert by_name[name].budget == 2 + linux_k204.HOST_MARGIN
+    for name in checker.OWN_OBSERVATIONS:
+        assert by_name[name].budget == linux_k204.OBSERVE_BOUND
+    assert by_name["r5-cancel"].interrupt_after == 2
+    assert by_name["r5-cancel"].expected_exit == -15
+    (resource,) = plan.resources
+    assert resource.cleanup.budget == linux_k204.CLEANUP_BOUND
+    assert resource.cleanup.argv[-1] == linux_k204.FINAL_CLEANUP
+    assert resource.cleanup.budget + plan.term_grace + plan.kill_wait <= 30
+    assert resource.dispose.budget + plan.term_grace + plan.kill_wait <= 45
+
+
+def test_owned_cleanup_acts_only_on_the_exact_issue_sleep() -> None:
+    script = linux_k204.CONTROL_CLEANUP
+    assert '= "sleep 120"' in script
+    assert "kill -TERM" in script and "kill -KILL" in script
+    assert "pkill" not in script and "killall" not in script
