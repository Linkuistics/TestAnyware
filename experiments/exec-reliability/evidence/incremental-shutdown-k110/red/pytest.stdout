mode = 'orderly', sample = 0, driver = 'incremental'

    @pytest.mark.parametrize(
        "mode",
        [
            "orderly",
            "healthy-stall",
            "failure-term",
            "failure-kill",
            "deferred-reap",
            "overrun",
            "prior-term",
            "denied-term",
            "prior-kill",
            "denied-kill",
            "finite",
            "expired",
