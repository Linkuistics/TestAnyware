@@ -331,6 +388,17 @@ def test_a_huge_timeout_runs_and_cancels(port: int, timeout: int) -> None:
     assert record_errors(exec_reply, exec_id="huge") == []
 
 
+def test_a_negative_timeout_past_the_float_range_times_out_at_once(port: int) -> None:
+    """Review k235 R2. A negative timeout clamps to 0. The old owner saturated
+    a negative value past the float range to an infinite deadline, so the
+    command ran to its natural exit."""
+    body = {"command": "sleep 5", "timeout": -(10**400), "id": "negative-huge"}
+    status, record = post_json(port, "/exec", body)
+    assert status == 200
+    assert record["outcome"]["kind"] == "timed_out", record["outcome"]
+    assert record["lifecycle"]["durationMs"] < 1000, record["lifecycle"]
+
