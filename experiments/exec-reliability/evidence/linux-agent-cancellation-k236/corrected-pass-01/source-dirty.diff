diff --git a/agents/linux/tests/test_exec_cancellation.py b/agents/linux/tests/test_exec_cancellation.py
index acf8da12a2..063482fc67 100644
--- a/agents/linux/tests/test_exec_cancellation.py
+++ b/agents/linux/tests/test_exec_cancellation.py
@@ -215,6 +215,33 @@ def test_the_exit_and_cancel_race_resolves_by_kernel_state() -> None:
     assert reply["lifecycle"]["ownerLatenessMs"] <= OWNER_LATENESS_BOUND_MS
 
 
+class LateOwnerWaiter(PidfdLeaderWaiter):
+    """The owner resumes 1 s after the spawn. By then the deadline has passed
+    and the leader has exited, so the pidfd is ready at the first wait."""
+
+    def wait_exit(self, timeout: float | None, wake: int | None = None) -> bool:
+        time.sleep(1.0)
+        return super().wait_exit(0, wake)
+
+
+def test_a_late_owner_keeps_its_lateness_when_the_exit_wins() -> None:
+    """Review k235 R3. Section "Arbitration": a late owner can still see a
+    leader that exited after the deadline. The outcome is `exited`, and the
+    record carries the owner lateness. The old owner reported 0, because the
+    pidfd woke it."""
+    record = exec_owner.run_command(
+        "sleep 0.4",
+        0.2,
+        "late",
+        time.monotonic(),
+        OwnerSeams(leader_waiter=LateOwnerWaiter),
+    ).to_dict()
+    assert record_errors(record, exec_id="late") == []
+    assert record["outcome"] == {"kind": "exited", "exitCode": 0}
+    assert record["termination"] is None
+    assert record["lifecycle"]["ownerLatenessMs"] >= 700, record["lifecycle"]
+
+
 # ---- Tombstone (spec, section "Cancel endpoint") ----------------------------
 
 
@@ -253,6 +280,36 @@ def test_a_cancellation_before_the_spawn_starts_nothing(tmp_path: Path) -> None:
     assert not marker.exists()
 
 
+def test_a_cancellation_during_capture_preparation_starts_nothing(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Review k235 R1. The cancellation arrives after the first check and
+    before the spawn, while the owner prepares its capture files. The old owner
+    did not check again, so it spawned the command after the cancellation."""
+    marker = tmp_path / "ran"
+    registry = exec_registry.ExecRegistry()
+    admission = registry.admit("mid-prepare")
+    assert admission.signal is not None
+    real_root = exec_owner._ensure_capture_root
+
+    def cancel_then_prepare() -> Path:
+        registry.cancel("mid-prepare", 0)
+        return real_root()
+
+    monkeypatch.setattr(exec_owner, "_ensure_capture_root", cancel_then_prepare)
+    published = exec_owner.run_command(
+        f"touch {marker}; sleep 30", 60, "mid-prepare", time.monotonic(), cancel=admission.signal
+    )
+    registry.publish("mid-prepare", published)
+    record = published.to_dict()
+    assert record_errors(record, exec_id="mid-prepare") == []
+    assert record["outcome"] == {"kind": "cancelled", "beforeStart": True}
+    assert record["lifecycle"]["leaderPid"] is None
+    assert record["termination"] is None
+    time.sleep(0.2)
+    assert not marker.exists(), "the command started after its cancellation"
+
+
