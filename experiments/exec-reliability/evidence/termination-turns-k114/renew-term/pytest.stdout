                if wake is None:
                    break
                # The caller services another timer between termination turns.
                time.sleep(max(0, min(wake, time.monotonic() + 0.002) - time.monotonic()))
            assert len(turns) > 2
            assert turns[1]["returned"] < owner.term_deadline
