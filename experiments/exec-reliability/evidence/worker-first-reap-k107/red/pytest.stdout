                assert end == old_end
            elif mode == "reserve":
                assert signals == ["SIGTERM", "SIGKILL"] and owner.reaped
                assert worker.kill_at == pytest.approx(old_end - failure.kill_reap, abs=1e-9, rel=0)
                assert worker.kill_at > start
