{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testanyware.dev/schemas/doctor.json",
  "title": "doctor",
  "description": "Host preflight report emitted by `testanyware doctor --json`. Seven check groups; `ok` reflects the blocking checks (install_path, bundled_agents, bundled_scripts, windows_tpm when its status is `fail`, and config when its status is `fail`). host_tools and script_tool_floors are advisory and never flip `ok`; neither does a `warn` from windows_tpm. A failing check makes `doctor` exit 1.",
  "type": "object",
  "required": ["schema_version", "ok", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "ok": { "type": "boolean" },
    "checks": {
      "type": "object",
      "required": ["install_path", "bundled_agents", "bundled_scripts", "host_tools", "script_tool_floors", "windows_tpm", "config"],
      "additionalProperties": false,
      "properties": {
        "install_path": {
          "type": "object",
          "required": ["status", "verdict", "running_binary"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "fail"] },
            "verdict": { "type": "string", "enum": ["homebrew_install", "shadowed", "no_homebrew", "not_on_path"] },
            "running_binary": { "type": "string" },
            "path": { "type": ["string", "null"] },
            "brew_prefix": { "type": ["string", "null"] }
          }
        },
        "bundled_agents": { "$ref": "#/$defs/bundle_check" },
        "bundled_scripts": { "$ref": "#/$defs/bundle_check" },
        "host_tools": {
          "type": "object",
          "required": ["status", "tools"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "warn"] },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "purpose", "path", "version"],
                "properties": {
                  "name": { "type": "string" },
                  "purpose": { "type": "string" },
                  "install_hint": { "type": "string" },
                  "path": { "type": ["string", "null"] },
                  "version": {
                    "type": "object",
                    "required": ["verdict"],
                    "properties": {
                      "verdict": { "type": "string", "enum": ["ok", "below_floor", "unparseable", "probe_failed"] },
                      "detected": { "type": ["string", "null"] },
                      "minimum": { "type": "string" },
                      "raw": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "script_tool_floors": {
          "type": "object",
          "required": ["status", "floors"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "warn", "skip"] },
            "reason": { "type": "string" },
            "floors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["verdict", "tool"],
                "properties": {
                  "verdict": { "type": "string", "enum": ["ok", "below_floor", "host_version_unknown", "unparseable"] },
                  "tool": { "type": "string" },
                  "host_version": { "type": "string" },
                  "declared_minimum": { "type": "string" },
                  "raw_value": { "type": "string" },
                  "source": { "type": "string" }
                }
              }
            }
          }
        },
        "windows_tpm": {
          "type": "object",
          "description": "The decision `vm start --platform windows` makes about the guest's TPM (ADR-0017), reported without starting anything. `pass`: attached (or not needed). `warn`: omitted because the host's QEMU cannot supply one, or the host could not be observed. `fail`: a Windows start would be refused before launch.",
          "required": ["status", "attached"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
            "attached": { "type": "boolean" },
            "ppi_off": { "type": "boolean", "description": "Present when attached: the device is wired with `ppi=off`." },
            "reason": { "type": "string", "enum": ["guest_does_not_need_one", "host_cannot_supply_one"], "description": "Present when the TPM is omitted." },
            "error": {
              "type": "object",
              "description": "Present when the host check refused (SWTPM_MISSING) or could not run (QEMU_FAILED).",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "remediation": { "type": ["string", "null"] }
              }
            }
          }
        },
        "config": {
          "type": "object",
          "description": "The Host CLI's own evaluation of ~/.config/testanyware/config.rhai (or the file that TESTANYWARE_CONFIG names). `pass`: the file evaluated (`loaded`), the file does not exist (`absent`, the file is optional), or TESTANYWARE_CONFIG=none (`disabled`). `skip`: the Host CLI does not read the file (`not_applicable`). Every host reads the file today, so no host reports this. `fail`: the file fails (`invalid`), and `error` is the CONFIG_INVALID error object. `doctor` is the one command that runs with a file that fails; its other checks use the values that resolve without the file.",
          "required": ["status", "verdict"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
            "verdict": { "type": "string", "enum": ["loaded", "absent", "disabled", "not_applicable", "invalid"] },
            "file": { "type": ["string", "null"], "description": "The file. `null` when TESTANYWARE_CONFIG=none, or when no home directory holds the default." },
            "reason": { "type": "string", "description": "Present when the check is skipped." },
            "error": {
              "type": "object",
              "description": "Present when the file fails: the CONFIG_INVALID error object.",
              "required": ["code", "message"],
              "properties": {
                "code": { "const": "CONFIG_INVALID" },
                "message": { "type": "string", "description": "`<file>:<line>: <message>`, or `<file>: <message>` when no line holds the error." },
                "remediation": { "type": "string" },
                "details": {
                  "type": "object",
                  "required": ["file", "line", "message"],
                  "properties": {
                    "file": { "type": "string" },
                    "line": { "type": ["integer", "null"], "description": "1-based. `null` for a wrong type or an unknown key, which no line holds." },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bundle_check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
        "brew_prefix": { "type": "string" },
        "reason": { "type": "string" },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot", "issue", "path"],
            "properties": {
              "slot": { "type": "string" },
              "issue": { "type": "string", "enum": ["missing", "not_executable"] },
              "path": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
