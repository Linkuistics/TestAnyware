flowchart TB
  S["Start here: Host CLI receives the /exec reply"]:::start
  T{"Transport complete?<br/>HTTP 200, full JSON body"}
  X["Transport error<br/>existing codes, exit 1 or 7"]
  O{"outcome present?"}
  LG["Legacy record<br/>record: legacy, outcome kind unknown<br/>old macOS or Linux agent, every Windows agent"]
  V{"Validity rules hold?<br/>id, exitCode, timedOut, bytes, sha256, termination, step order"}
  BAD["EXEC_RECORD_INVALID, exit 1<br/>never reported as success"]
  OK["Typed record<br/>record: agent, ok true"]
  J["JSON: legacy fields plus exec_id, outcome,<br/>evidence, termination, remaining_group; exit 0"]
  TX["Text: exact bytes, notice line for a non-exit outcome<br/>exit code, 128+N, 255, 255 or 1"]
  S --> T
  T -->|no| X
  T -->|yes| O
  O -->|no| LG
  O -->|yes| V
  V -->|no| BAD
  V -->|yes| OK
  OK --> J
  OK --> TX
  LG --> J
  LG --> TX
  classDef start fill:#17354b,color:#fff,stroke:#17354b,font-weight:bold
