#!/bin/bash
# A fake `tart` for the start tests. It keeps its state in `state/` beside the script:
#
#   <name>.cloned   the VM exists
#   <name>.running  the pid of its `tart run`, which stays up as `sleep`
#   vnc-port        the port that `run` prints in its vnc:// line (default 9, which refuses)
#   ip              what `ip` prints (default 127.0.0.1)
#   full            if present, `run` refuses with the macOS guest limit message and exits 1
#                   (each refusal appends a line to `refused.log`)
#   capacity        a number: `run` refuses as `full` does while that many VMs run, as the
#                   framework does. Each refusal appends a line to `refused.log`
#   run-fails       if present, `run` prints `tart: boom` and exits 1, as a tart that fails for any
#                   reason but the limit
#   stuck           if present, `stop` and `delete` do nothing, as a tart that cannot remove a VM
#   list-hang       if present, `list` does not answer while the file exists, or until a caller
#                   kills it
#   get-fails       if present, `get` fails, as a tart whose calls fail after its `list` answered
#   get-delay       a number of seconds: `get` answers after that long, as a slow tart does
#   delete-delay    a number of seconds: `delete` removes the VM after that long, as a slow cleanup does
#   <name>.os       the OS that `get` reports for a VM (`darwin` or `linux`). `clone` writes it from
#                   the base: darwin for the macOS golden, linux for the Linux golden. A VM that a
#                   test makes by hand without it reports darwin
#
# The tests give it as the only tool directory, so no test runs the developer's own `tart`.
set -u
STATE="$(cd "$(dirname "$0")" && pwd)/state"
mkdir -p "$STATE"
cmd="${1:-}"
shift || true

alive() { [ -e "$STATE/$1.running" ] && kill -0 "$(cat "$STATE/$1.running")" 2>/dev/null; }

case "$cmd" in
  list)
    while [ -e "$STATE/list-hang" ]; do sleep 0.1; done
    first=1
    printf '['
    emit() {
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"Name":"%s","State":"%s"}' "$1" "$2"
    }
    for golden in testanyware-golden-macos-27 testanyware-golden-linux-24.04 testanyware-base-macos-27; do emit "$golden" stopped; done
    for f in "$STATE"/*.cloned; do
      [ -e "$f" ] || continue
      name="$(basename "$f" .cloned)"
      if alive "$name"; then emit "$name" running; else emit "$name" stopped; fi
    done
    printf ']\n'
    ;;
  get)
    # `tart get <name> --format json`: only the key that the app reads.
    [ -e "$STATE/get-fails" ] && { echo "failed to get $1: boom" >&2; exit 1; }
    [ -s "$STATE/get-delay" ] && sleep "$(cat "$STATE/get-delay")"
    [ -e "$STATE/$1.cloned" ] || { echo "failed to get $1: no such VM" >&2; exit 1; }
    printf '{"OS":"%s"}\n' "$(cat "$STATE/$1.os" 2>/dev/null || echo darwin)"
    ;;
  clone)
    case "$1" in
      testanyware-golden-macos-27) touch "$STATE/$2.cloned"; echo darwin >"$STATE/$2.os" ;;
      testanyware-golden-linux-24.04) touch "$STATE/$2.cloned"; echo linux >"$STATE/$2.os" ;;
      *) echo "failed to clone $1: no such VM" >&2; exit 1 ;;
    esac
    ;;
  set)
    ;;
  run)
    name="$1"
    if [ -e "$STATE/run-fails" ]; then
      echo "tart: boom" >&2
      exit 1
    fi
    if [ -s "$STATE/capacity" ]; then
      running=0
      for f in "$STATE"/*.running; do
        [ -e "$f" ] || continue
        alive "$(basename "$f" .running)" && running=$((running + 1))
      done
      if [ "$running" -ge "$(cat "$STATE/capacity")" ]; then
        echo "$name" >>"$STATE/refused.log"
        echo "The number of VMs exceeds the system limit (other running VMs: holder-a, holder-b)" >&2
        exit 1
      fi
    fi
    if [ -e "$STATE/full" ]; then
      echo "$name" >>"$STATE/refused.log"
      echo "The number of VMs exceeds the system limit (other running VMs: holder-a, holder-b)" >&2
      exit 1
    fi
    echo $$ >"$STATE/$name.running"
    echo "vnc://:fakepw@127.0.0.1:$(cat "$STATE/vnc-port" 2>/dev/null || echo 9)..."
    exec sleep 600
    ;;
  ip)
    cat "$STATE/ip" 2>/dev/null || echo 127.0.0.1
    ;;
  stop)
    [ -e "$STATE/stuck" ] && exit 0
    if alive "$1"; then kill "$(cat "$STATE/$1.running")" 2>/dev/null; fi
    rm -f "$STATE/$1.running"
    ;;
  delete)
    [ -e "$STATE/stuck" ] && exit 0
    [ -s "$STATE/delete-delay" ] && sleep "$(cat "$STATE/delete-delay")"
    rm -f "$STATE/$1.cloned" "$STATE/$1.running" "$STATE/$1.os"
    ;;
  *)
    echo "fake-tart: unknown command $cmd" >&2
    exit 2
    ;;
esac
